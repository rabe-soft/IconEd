 ***********************************************************************/
/*--------------------- MSG_DB_VIEWER_IMPORT_GRAPHIC_FILE ---------------------
 *  Purpose:	Initiate Import via impex library
 *  Context:
 *  Strategy:
 *  Parameters:	void (void);
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass,MSG_DB_VIEWER_IMPORT_GRAPHIC_FILE {

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;
    @send IconImportControl::MSG_GEN_INTERACTION_INITIATE();
}

/*--------------------- MSG_DB_VIEWER_PREPARE_FOR_IMPORT ---------------------
 * Purpose:	Copy imported meta-data (standard GEOS format) for our own use.
 * Context:	Part of the GEOS import handling
 * Strategy:	- copy data for our own use.
 *		- call ImpexImportExportCompleted()
 *		  That's all.
 * Parameters:	void (ImpexTranslationParams impexParams);
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_PREPARE_FOR_IMPORT {
VMBlockHandle	graphic;
Boolean 	isGString;

  do {		// ensure ImpexImportExportCompleted(&impexParams);


/*
DBVI_importCreateNewISet entfernen
Triggerr auslichten

*/
    /*
     * Get gstring or bitmap from impexParams
     */
    isGString = TRUE;
    switch ( impexParams.ITP_clipboardFormat) {
      case CIF_BITMAP:
      	isGString = FALSE;
      case CIF_GRAPHICS_STRING:
	  {
	  VMChain	newChain;
	  newChain = VMCopyVMChain(impexParams.ITP_transferVMFile,
			impexParams.ITP_transferVMChain,
			global.tempFile);
	  graphic = newChain >> 16;
	  }
	  break;

      default:
	  ErrorBoxOptr(@InvalidClipboardFormat);
	  break;
	  }

      } while (0);

  /* Tell the system that we are done. */
  ImpexImportExportCompleted(&impexParams);

  @send process::MSG_ICON_IMPORT_GRAPHIC_WITH_DIALOGS(graphic, isGString);

}

/*--------------------- MSG_DB_VIEWER_EXPORT_ICON_TO_GRAPHIC_FILE ---------------------
 *  Purpose:	Initia export icon graphic to file via impex library
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_EXPORT_ICON_TO_GRAPHIC_FILE {

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;
    @send IconExportControl::MSG_GEN_INTERACTION_INITIATE();
}

/*--------------------- MSG_DB_VIEWER_PREPARE_FOR_EXPORT ---------------------
 * Purpose: 	Prepare data for the export library
 * Context:	Part of the Import handling of the GEOS system
 * Strategy:	- set up a gstring that hold the icon's image
 *		- draw image to the gstring
 *		- call ImpexImportExportCompleted()
 *		  That's all.
 * Parameters:	void (ImpexTranslationParams impexParams);
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_PREPARE_FOR_EXPORT {
GStateHandle 	gstate;
VMBlockHandle	gString;
VMBlockHandle iconBmp;

  AppMarkBusy();

  do {
     impexParams.ITP_transferVMChain = 0;	// worst case
     impexParams.ITP_manufacturerID = 0;	// GeoWorks
     impexParams.ITP_clipboardFormat = CIF_GRAPHICS_STRING;

     /*
      * Create GString
      * get image of the current icon and draw it
      * clean up
      */
     gstate =  GrCreateGString(impexParams.ITP_transferVMFile,GST_VMEM,&gString);
     if ( !gstate ) break;

     iconBmp = IdGetEntryBitmap(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);
     GrDrawHugeBitmap(gstate, 0, 0, pself->DBVI_vmFile, iconBmp);
     GrEndGString(gstate);

     GrDestroyGString(gstate,0,GSKT_LEAVE_DATA);

     impexParams.ITP_transferVMChain = gString;
     impexParams.ITP_transferVMChain <<= 16;

     } while (0);

  /* Tell the system that we are done. */
  ImpexImportExportCompleted(&impexParams);

  AppMarkNotBusy();

}


/*--------------------- MSG_DB_VIEWER_EXPORT_ICON_TO_VM_FILE ---------------------
 *  Purpose:
 *  Context:
 *  Strategy:	//orig: MSG_DB_VIEWER_WRITE_TO_FILE
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_EXPORT_ICON_TO_VM_FILE {
int cmd, err;
FileLongName 	fileName;
VMFileHandle	dataFile;
VMBlockHandle	bmpBlock, mapBlock;
VMChain nChain, oChain;

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;

    /*
     * exeute WriteToVMFileDialog and fetch setting form the dialog
     */
    cmd = UserDoDialog(@WriteToVMFileDialog);
    if ( cmd != IC_OK ) return;

    @call WriteToFileText::MSG_VIS_TEXT_GET_ALL_PTR(fileName);

    /*
     * Enter folder, create file and set
     * the bitmap as Map block of the file
     */

    FilePushDir();
    FileSetStandardPath(SP_DOCUMENT);	// 도 Fileselector nutzen und handlen
    do {

    	if (FileToolExistFile(fileName) ) {
    	    MemLock(OptrToHandle(@WSQuestionOverwriteFile));
    	    cmd = UserStandardDialog ( (char *)0,(char *)0,(char *)0,
    		fileName,LMemDeref(@WSQuestionOverwriteFile), \
		(( CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET)) );
    	    MemUnlock(OptrToHandle(@WSQuestionOverwriteFile));

	    if (cmd != IC_YES) break;
    	}
    	
    	dataFile = VMOpen(fileName, VMAF_FORCE_READ_WRITE | VMAF_FORCE_DENY_WRITE , VMO_CREATE_TRUNCATE, 0);
	if (!dataFile) {
	    err = ThreadGetError();
	    switch (err) {
		case VM_SHARING_DENIED:
		case VM_OPEN_INVALID_VM_FILE:
		case VM_TRUNCATE_FAILED:
		case VM_WRITE_PROTECTED:
		case VM_CANNOT_OPEN_SHARED_MULTIPLE:
		    ErrorBoxOptrString(@WSErrorAccessDenied, fileName);
		    break;
		case ERROR_INVALID_LONGNAME:
		    ErrorBoxOptrString(@WSErrorInvalidName, fileName);
		    break;
		default:
		    ErrorBoxOptrString(@WSErrorCommon, fileName);
	    }
	    break;
       	}

    	bmpBlock = IdGetEntryBitmap(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);

	oChain = bmpBlock;	// 16 to 32 Bit
	nChain = VMCopyVMChain(pself->DBVI_vmFile,( oChain << 16 ), dataFile);
	mapBlock = (VMBlockHandle)(nChain >> 16);

	VMSetMapBlock(dataFile, mapBlock);
    	VMClose(dataFile, FALSE);

    	MessageBoxOptr(@WriteToFileSuccessText);

    } while(FALSE);

    FilePopDir();


}



