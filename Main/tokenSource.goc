/*--------------------- MSG_ICON_APP_WRITE_SOURCE_LANGUAGE_CHANGED ---------------------
 *  Purpose:	Choose "GOC" or "UIC"  (Asm)
 *  Context:	Message from WriteSourceDialog
 *  Strategy:
 *  Parameters:	GEN_ITEM_GROUP_APPLY_MSG (word selection,
 		word numSelections, GenItemGroupStateFlags stateFlags = dl);
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconApplicationClass, MSG_ICON_APP_WRITE_SOURCE_LANGUAGE_CHANGED {
FileLongName	fName;
char *p;

    @call WriteSourceFileName::MSG_VIS_TEXT_GET_ALL_PTR(fName);
    p = strchr(fName, '.');
    if (p) {
    	*p = 0;
    } else {
    	fName[DOS_FILE_NAME_CORE_LENGTH] = 0;
    }

    if (selection == WSLT_GOC) {
    	strcat(fName, ".GOH");
    } else {
    	strcat(fName, ".UI");
    }

    @call WriteSourceFileName::MSG_VIS_TEXT_REPLACE_ALL_PTR(fName, 0);

}





/*--------------------- ToolWriteSourceCheckReady ---------------------
 *  Purpose:	Check all icons for the set to see, if there is a problem
 *  Context:
 *  Strategy:
 *	Possible problems are:
     	- both, compressed and uncompressed size are larger than
     	  MAX_SAFE_MONIKER_SIZE. If only one of the sizees is
     	  too large, return TOKEN_READY_IF_MINIMZE or TOKEN_READY_IF_COMPRESS
     	- request to print out a warning if
     	  ... one or more icons are true color icons
     	  ... one or more icons are invisble (mask is completely clear)
     	  ... two or more icons have the same combination of
     	      display size, icon style, display class and aspect ratio
     	      	Note: This is a real problem for export to tokenDB, but in case
     	      	of writing source code, the programmer may use this icons in
     	      	different contexts, which may be ok.
     	      	Therefore we print a warning only.
     	  ... two or more icons have the same name
     	  	Usually, compiling a program fails if there are two or more
     	  	chunks with the same name.
     	  	Therefore, the code generates unique names, but does not store
     	  	them in the icons data. Therefore, a warning is generated.

     	  Depending on the settings in the WriteSourceDialog, all or only
     	  some checks must performed.

 *  Parameters:	vmFile:	database file
 *		iSet:	Icon set to check
 		curIcon: currently edited icon
 *  Return:
	TOKEN_READY_FOR_EXPORT			0	<- no problem
	TOKEN_READY_IF_MINIMZE			1	<- compressed size is too large
	TOKEN_READY_IF_COMPRESS			2	<- uncompressed size is too large
	TOKEN_NOT_READY_BECAUSE_SIZE		0x10
    Additional flag bits:
	TOKEN_RGB_WARNING			0x100	<- there are RGB icons
	TOKEN_EMPTY_WARNING			0x200	<- there are empty icons
	TOKEN_PROPERTIES_WARNING		0x400	<- duplicted set of properties
	TOKEN_ICON_NAMES_WARNING		0x800	<- duplicted icon names

 ---------------------------------------------------------------------------*/
int ToolWriteSourceCheckReady(VMFileHandle vmFile, int iSet, int curIcon) {
int retVal = TOKEN_READY_FOR_EXPORT;
int 	count, icon, iconsToWrite;
int 	bmFormat, headerToWrite;
VMBlockHandle 	bmp;

    count = IdGetEntryCount(vmFile, iSet);
    EC( if (!count) { ProgError("Strange. no icon in ToolWriteSourceCheckReady"); return TOKEN_NOT_READY_BECAUSE_PROPERTIES; } )

    iconsToWrite = @call WriteSourceIconChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    switch (iconsToWrite) {
    case WSIT_CURRENT_ICON:
    	/*
    	 * Only check the current icon
    	 *	- get bitmap and check size
    	 *	- check for warnings
    	 *	- return
    	 */
        bmp = IdGetEntryBitmap(vmFile, iSet, curIcon);
        bmFormat = BTGetMoreBitmapInfos(vmFile, bmp, 0, 0, 0);
        retVal = ToolCheckIconSizes(vmFile, bmp);
        if ( retVal >= TOKEN_FIRST_NOT_READY_VALUE ) return retVal;

	if ( ExpTokenTestIfInvisible(vmFile, bmp, NULL) )  retVal |= TOKEN_EMPTY_WARNING;
	if ( (bmFormat & BMT_FORMAT) == BMF_24BIT ) 	   retVal |= TOKEN_RGB_WARNING;
	return retVal;

    case WSIT_ALL_ICONS: break;

    EC(default: ProgError("ToolWriteSourceCheckReady: WSIT_SELECTED_ICONS passed"); return TOKEN_NOT_READY_BECAUSE_SIZE; )
    }

    /*
     * Examinate every icon
     */
    for ( icon = 0; icon < count; icon++) {

        /*
         * Get bitmap handle and bitmap format
         */
        bmp = IdGetEntryBitmap(vmFile, iSet, icon);
        bmFormat = BTGetMoreBitmapInfos(vmFile, bmp, 0, 0, 0);


        /*
         * Check size - compressed and uncompressed
         * If this fails report the error and skip other cheks
         */
        retVal = ToolCheckIconSizes(vmFile, bmp);
        if ( retVal >= TOKEN_FIRST_NOT_READY_VALUE ) {
    	return retVal;
    	}


        /*
         * Check icon for warning messags
         */
	if ( ExpTokenTestIfInvisible(vmFile, bmp, NULL) )  retVal |= TOKEN_EMPTY_WARNING;
	if ( (bmFormat & BMT_FORMAT) == BMF_24BIT ) 	   retVal |= TOKEN_RGB_WARNING;
    }		// for (icon)


    /*
     * For VisMonikers: check combination of display size, icon style, display class
     *			and aspect ratio
     * 			as well as duplicated names
     * BitmapChunk and PointerDef: only check duplicated names
     */
    headerToWrite = @call WriteSourceHeaderList::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    if (headerToWrite == WSHT_VIS_MONIKER) {
    	if ( ToolCheckIconsProperties(vmFile, iSet) ) retVal |= TOKEN_PROPERTIES_WARNING;
    }
    if ( WriteSourceCheckDuplicatedNames(vmFile, iSet, FALSE) )  retVal |= TOKEN_ICON_NAMES_WARNING;

    return retVal;
}


/*--------------------- WriteSourceSelectTooLargeItems ---------------------
 *  Purpose:	Check all icons if they are too big and select the affected
 *		icons in the WriteSourceMonikerList
 *  Context:
 *  Strategy:
 	- both, uncompressed and compressed size must exceed MAX_SAFE_MONIKER_SIZE
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void WriteSourceSelectTooLargeItems(VMFileHandle vmFile, int iSet) {
int n, count;
VMBlockHandle  bmp;
dword size1, size2;

    @call WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED (FALSE);

    count = IdGetEntryCount(vmFile, iSet);

    for ( n = 0; n < count; n++ ) {
    	bmp = IdGetEntryBitmap(vmFile, iSet, n);
	ExpTokenFindBitmapSizes(vmFile, bmp, &size1, &size2);
	if ( (size1 > MAX_SAFE_MONIKER_SIZE) && (size2 > MAX_SAFE_MONIKER_SIZE) )
		@send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (n, TRUE);
    }
}

/*--------------------- WriteSourceSelectEmptyOrTCItems ---------------------
 *  Purpose:	Check all icons if they are empty or true color and select
 *		the affected icons in the WriteSourceMonikerList
 *  Context:	Display export to tokenDB warning
 *  Strategy:
 	- loop over all icons in the set
 	- select item if the icon is invisible
 	  ExpTokenTestIfInvisible returns the bmFormat value as a service
 	- select item if it is a true color item
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void WriteSourceSelectEmptyOrTCItems(VMFileHandle vmFile, int iSet) {
int n, count, bmFormat;
VMBlockHandle  bmp;

    @call WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_NONE_SELECTED (FALSE);

    count = IdGetEntryCount(vmFile, iSet);

    for ( n = 0; n < count; n++ ) {
    	bmp = IdGetEntryBitmap(vmFile, iSet, n);
	if ( ExpTokenTestIfInvisible(vmFile, bmp, &bmFormat) )
		@send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (n, TRUE);
	if ( (bmFormat & BMT_FORMAT) == BMF_24BIT)
		@send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (n, TRUE);
    }
}

/*--------------------- WriteSourceSelectDoublePropertyItems ---------------------
 *  Purpose:	Check all icons if they are icon with the same combination of
     	  	display size, icon style, display class and aspect ratio
     	  	If yes, select thems
 *  Context:
 *  Strategy:
 	- IdGetEntryType returns all information we need
 	- make a double-loop over all icons for this set
 	- if a duplicates has been found, select icon and try next one
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void WriteSourceSelectDoublePropertyItems(VMFileHandle vmFile, int iSet) {
int n, count, k;
VisMonikerListEntryType	vmlet1, vmlet2;

    count = IdGetEntryCount(vmFile, iSet);
    if ( count < 2 ) return;
    for ( n = 0; n < (count-1); n++ ) {

    	vmlet1 = IdGetEntryType(vmFile, iSet, n);
    	vmlet1 &= (VMLET_GS_COLOR | VMLET_STYLE | VMLET_GS_SIZE | VMLET_GS_ASPECT_RATIO);

    	for ( k = n+1; k < count; k++ ) {

    	    vmlet2 = IdGetEntryType(vmFile, iSet, k);
    	    vmlet2 &= (VMLET_GS_COLOR | VMLET_STYLE | VMLET_GS_SIZE | VMLET_GS_ASPECT_RATIO);

    	    if ( vmlet1 == vmlet2 ) {
    	    	/* same properties found */
    	    	@send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (n, TRUE);
    	    	@send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (k, TRUE);
    	    	break;
    	    }
    	}	// for(k)
    }		// for(n)
}

/*--------------------- WriteSourceCheckDuplicatedNames ---------------------
 *  Purpose:	Check all icons if they are icons with the same name
 *  Context:
     * Any VisMoniker must have different names or compilation fails
 *  Strategy:
 	- reset global flag
 	- IdGetEntryName returns the name
 	- make a double-loop over all icons for this set
 	- if a duplicates has been found, set global flag and return
 	  seletc items, if selectItems is TRUE
 *  Parameters:
 	vmFile:	database file
 	iSet:	icon set to examinate
 	selectItems: TRUE to select te affected items in the WriteSourceMonikerList
 *  Return:	TRUE: 	we have duplicates
 *		FALSE:	no duplicates
 ---------------------------------------------------------------------------*/
Boolean WriteSourceCheckDuplicatedNames(VMFileHandle vmFile, int iSet, Boolean selectItems) {
int n, count, k;
char name1[ICON_NAME_BUFFER_SIZE], name2[ICON_NAME_BUFFER_SIZE];
Boolean	retVal = FALSE;

    global.flags &= ~GF_WRITE_CODE_DOUBLE_NAMES;
    count = IdGetEntryCount(vmFile, iSet);
    if ( count < 2 ) return FALSE;

    for ( n = 0; n < (count-1); n++ ) {
        IdGetEntryName(vmFile, iSet, n, name1);
    	for ( k = n+1; k < count; k++ ) {
	    IdGetEntryName(vmFile, iSet, k, name2);
    	    if ( strcmp(name1, name2 )==0 ) {
    	    	global.flags |= GF_WRITE_CODE_DOUBLE_NAMES;
    	    	if ( selectItems ) {
    	    	    @send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (n, TRUE);
    	    	    @send WriteSourceMonikerList::MSG_GEN_ITEM_GROUP_SET_ITEM_STATE (k, TRUE);
    	    	}
    	    	retVal = TRUE;
    	    }
    	}	// for(k)
    }		// for(n)

    return retVal;
}

/***********************************************************************
 *
 *	Write token as source code - Part 2: Write code to file
 *	-------------------------------------------------------
 *
 *	WriteSourceEnterPath	-- enter path to source file
 *	WriteSourceOpenFile	-- open file to write to
 *
 *	WriteMonikerToFile	-- Main code for writing an icon as VisMoniker to file
 *	WriteMonikerGOC		-- Write an icon as GOC code to file
 *	WriteMonikerAsm		-- Write an icon as Asm code to file
 *
 ***********************************************************************/

void WriteMonikerToFile(FileHandle destFile, VMFileHandle vmFile, int iSet, int icon);
void WriteMonikerGOC(FileHandle fh, byte *dataPtr, char *monikerName, VisMonikerListEntryType vmlet, int monikerSize);
void WriteMonikerAsm(FileHandle fh, byte *dataPtr, char *monikerName, VisMonikerListEntryType vmlet, int monikerSize);



/*--------------------- WriteSourceEnterPath ---------------------
 *  Purpose:	Set path for write. Last used path is stored in ATTR_GEN_PATH_DATA of
	 	the WriteSourceDialog dialog object
 ---------------------------------------------------------------------------*/
void WriteSourceEnterPath(void) {
GenFilePath *gfp;
Boolean found;

    gfp = malloc(sizeof(GenFilePath));
    found = @call WriteSourceDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);

    if (found != (-1)) {
	FileSetCurrentPath(gfp->GFP_disk, gfp->GFP_path);
    } else {
	WriteSourceEnterDefaultPath();
    }

    free(gfp);
}

/*--------------------- WriteSourceOpenFile ---------------------
 *  Purpose:	Open destination file
 *  Context:
 *  Strategy:
 *  Parameters:	nameBuffer:	return: file name
 *  Return:	File handle of the file
 *		Zero, if the file could not be opened
 ---------------------------------------------------------------------------*/
FileHandle WriteSourceOpenFile(char *nameBuffer) {
FileHandle fh = 0;
char	fileName[DOS_DOT_FILE_NAME_LENGTH + 2];
int	cmd, err;

    /*
     * Read file name from UI
     */
    @call WriteSourceFileName::MSG_VIS_TEXT_GET_ALL_PTR(fileName);
    if ( !strlen(fileName) ) {
	ErrorBoxOptr(@WSErrorEmptyFilename);
	return 0;
    }
    if (nameBuffer) strcpy(nameBuffer, fileName);

    /*
     * Check file exists and ask for overwrite
     */
    if (FileToolExistFile(fileName) ) {
    	MemLock(OptrToHandle(@WSQuestionOverwriteFile));
    	cmd = UserStandardDialog ( (char *)0,(char *)0,(char *)0,
    		fileName,LMemDeref(@WSQuestionOverwriteFile), \
		(( CDT_QUESTION << CDBF_DIALOG_TYPE_OFFSET) | \
		 ( GIT_AFFIRMATION << CDBF_INTERACTION_TYPE_OFFSET)) );
    	MemUnlock(OptrToHandle(@WSQuestionOverwriteFile));

	if (cmd != IC_YES) return 0;
    }

    /*
     *	Open file. Handle errors
     */
    fh = FileCreate(fileName, (FILE_CREATE_TRUNCATE | FCF_NATIVE) | (FILE_ACCESS_RW | FILE_DENY_RW), 0);
    err = ThreadGetError();
    if ( err ) {
      switch (err) {
     	case ERROR_ACCESS_DENIED:
	case ERROR_WRITE_PROTECTED:
	case ERROR_FILE_IN_USE:
	case ERROR_SHARING_VIOLATION:
	case ERROR_FILE_FORMAT_MISMATCH:
	    ErrorBoxOptrString(@WSErrorAccessDenied, fileName);
	    break;
	case ERROR_INVALID_LONGNAME:
	    ErrorBoxOptrString(@WSErrorInvalidName, fileName);
	    break;
	default:
	    ErrorBoxOptrString(@WSErrorCommon, fileName);
	}
      return 0;
    }

    return fh;
}

/*--------------------- MSG_DB_VIEWER_WRITE_SOURCE_CODE ---------------------
 *  Purpose:
 *  Context:
 *  Strategy:
 	- open/create destination file

 	- clean up memory
 *  Parameters:
 *  Return:	TRUE if error
 *		FALSE if code was successful writen
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_WRITE_SOURCE_CODE {
FileHandle	fh;
int	iconsToWrite, headerFormat;
int	iSet, icon, count;
VMFileHandle vmFile;
char	fileName[DOS_DOT_FILE_NAME_LENGTH + 2];
GenFilePath *gfp;
char *fpp, *fullPath = 0;


    /*
     * Enter path and open destination file
     */
    FilePushDir();
    WriteSourceEnterPath();
    fh = WriteSourceOpenFile(fileName);
    if ( !fh ) {
    	FilePopDir();
    	return TRUE;	/* could not open file */
    }

    /*
     * store path in the geos.ini for later use
     */
    gfp = malloc(sizeof(GenFilePath));
    fullPath = malloc(IE_FULL_PATH_BUFFER_SIZE);

    gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
    fpp = fullPath;
    FileConstructFullPath (&fpp, IE_FULL_PATH_BUFFER_SIZE, gfp->GFP_disk, gfp->GFP_path, TRUE);
    InitFileWriteString(IE_INI_CATEGORY, IE_INI_PATH_KEY, fullPath);

    free(fullPath);
    free(gfp);



    /*
     * Get info if we want to write all icons or only the current icon
     * as well as the format to write.
     */
    AppMarkBusy();
    iconsToWrite = @call WriteSourceIconChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    headerFormat = @call WriteSourceHeaderList::MSG_GEN_ITEM_GROUP_GET_SELECTION();

    /*
     * Write the current icon to file or loop over all icons
     */
    iSet =  pself->DBVI_currentISet;
    vmFile = pself->DBVI_vmFile;

    if ( iconsToWrite == WSIT_CURRENT_ICON) {
	/*
	 * Write only the current icon to file
	 */
	switch (headerFormat ) {
	case WSHT_VIS_MONIKER:
	    WriteMonikerToFile(fh, vmFile, iSet, pself->DBVI_currentIcon);
	    break;
	case WSHT_BITMAP:
	    MessageBox("Current Icon Bitmap");
	    break;
	case WSHT_PTR_IMAGE:
	    MessageBox("Current Icon PointerDef");
	    break;
	}

    } else {
	/*
	 * loop over all icons
	 */
	count = IdGetEntryCount(vmFile, iSet);
	for ( icon = 0; icon < count; icon++ ) {
	  switch (headerFormat ) {
	  case WSHT_VIS_MONIKER:
	    WriteMonikerToFile(fh, vmFile, iSet, icon);
	    break;
	  case WSHT_BITMAP:
	    MessageBox("All Icons Bitmap");
	    break;
	  case WSHT_PTR_IMAGE:
	    MessageBox("All Icons PointerDef");
	    break;
	  }
	}	// end (icon)
    }

    /*
     * Clean up
     */
    FileClose(fh, FALSE);
    FilePopDir();
    AppMarkNotBusy();

    MessageBoxOptrString(@WSSuccessMessage, fileName);
    return FALSE;

}


/*--------------------- WriteMonikerToFile ---------------------
 *  Purpose:	Core routine to write an icon as VisMoniker to file
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void WriteMonikerToFile(FileHandle destFile, VMFileHandle vmFile, int iSet, int icon) {
optr	monikerOp;
word compressMode, lang, monikerSize;
byte *dataPtr;
word *sizePtr;
char monikerName[MAX_ICON_NAME_LENGTH + 2];
VisMonikerListEntryType vmlet;


    /*
     * Create the VisMonker data in an LMem chunk
     *	- get compress mode from UI
     *  - Call MakeMonikerFromIcon() to do the job
     *	  pass zero as mem handle to allocate new LMem block
     *	  MakeMonikerFromIcon() returns zero in case of any error
     *	- get VisMonikerListEntryType value for further use
     */
    compressMode = @call WriteSourceCompressOptions::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    compressMode |= @call WriteSourceMaskOptions::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
    monikerOp = MakeMonikerFromIcon(vmFile, iSet, icon, compressMode, 0);
    if (!monikerOp) return;		// Emergency handling, should not occur

    vmlet = IdGetEntryType(vmFile, iSet, icon);

    /*
     * Find out the data size of the whole moniker.
     * The structure of a VisMonikerWithGString is (see also tokenExport.goc):
     *		5 bytes     VisMonikerWithGString
     *		1 byte	    GR_DRAW_BITMAP_CP / GR_FILL_BITMAP_CP
     *		2 bytes     size of bitmap including header, palette and data
     *		1 byte      GR_END_GSTRING
     * -> get a pointer bitmap size location
     * -> calculate moniker size
     */
    MemLock(OptrToHandle(monikerOp));
    dataPtr = (byte*)LMemDeref(monikerOp);
    sizePtr = (word*)(dataPtr + sizeof(VisMonikerWithGString) + 1);
    monikerSize = sizeof(VisMonikerWithGString) + 1 + 2 + *sizePtr + 1;

    /*
     * Find an unique name for the moniker to write. Duplicated names causes
     * compiling to fail.
     */
    IconFindValidIconName(vmFile, iSet, icon, monikerName);

    /*
     * Convert moniker data into text, depending on the destination language
     */
    lang = @call WriteSourceLanguageList::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    switch (lang) {
    case WSLT_GOC:
    	WriteMonikerGOC(destFile, dataPtr, monikerName, vmlet, monikerSize);
    	break;
    case WSLT_ASM:
    	WriteMonikerAsm(destFile, dataPtr, monikerName, vmlet, monikerSize);
    	break;
    EC( default: ProgError("WriteMonikerToFile: unknown languge"); )
    }

    /*
     * Clean up
     */
    MemFree(OptrToHandle(monikerOp));
}

/*--------------------- WSFindVMTypeOptr ---------------------
 *  Purpose:	Analyse VisMonikerListEntryType and find parameters for MonikerVMTypeGOC chunk
 *  Parameters:	vmlet:	VisMonikerListEntryType value (gotten from IdGetEntryType() )
 *		dsOp, styleOp, dcOp, aspectOp
 * 			return: optr with texts for displaySize, iconStlye,
 				displayClass and aspectRatio
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WSFindVMTypeOptr(VisMonikerListEntryType vmlet, optr *dsOp, optr *styleOp, optr *dcOp, optr *aspectOp) {
word val;
    /*
     * DisplaySize
     */
    val = (vmlet & VMLET_GS_SIZE) >> VMLET_GS_SIZE_OFFSET;
    switch ( val)  {
    case DS_TINY:
    	*dsOp = @WSDispSizeTiny;
    	break;
    case DS_STANDARD:
    	*dsOp = @WSDispSizeStandard;
    	break;
    case DS_LARGE:
    	*dsOp = @WSDispSizeLarge;
    	break;
    case DS_HUGE:
    	*dsOp = @WSDispSizeHuge;
    	break;
    EC( default: ProgError("invalid DisplaySize in WSFindVMTypeOptr"); MessageNumberBox(val); *dsOp = @WSInavlidValue;)
    }

    /*
     * IconStlye (only supported styles)
     */
    val = (vmlet & VMLET_STYLE) >> VMLET_STYLE_OFFSET;
    switch ( val ) {
    case VMS_TEXT:
    	*styleOp = @WSStyleText;
    	break;
    case VMS_ABBREV_TEXT:
    	*styleOp = @WSStyleAbbrevText;
    	break;
    case VMS_ICON:
    	*styleOp = @WSStyleIcon;
    	break;
    case VMS_TOOL:
    	*styleOp = @WSStyleTool;
    	break;
    EC( default: ProgError("invalid IconsStyle in WSFindVMTypeOptr"); MessageNumberBox(val); *styleOp = @WSInavlidValue;)
    }

    /*
     * DisplayClass (only supported display classes)
     */
    val = (vmlet & VMLET_GS_COLOR) >> VMLET_GS_COLOR_OFFSET;
    switch ( val ) {
    case DC_GRAY_1:
    	*dcOp = @WSDispClassGray1;
    	break;
    case DC_COLOR_4:
    	*dcOp = @WSDispClassColor4;
    	break;
    case DC_COLOR_8:
    	*dcOp = @WSDispClassColor8;
    	break;
    case DC_CF_RGB:
    	*dcOp = @WSDispClassColorRGB;
    	break;
    EC( default: ProgError("invalid DisplayClass in WSFindVMTypeOptr"); MessageNumberBox(val); *dcOp = @WSInavlidValue;)
    }

    /*
     * Aspect ratio
     */
    val = (vmlet & VMLET_GS_ASPECT_RATIO) >> VMLET_GS_ASPECT_RATIO_OFFSET;
    switch ( val ) {
    case DAR_NORMAL:
    	*aspectOp = @WSAspectNormal;
    	break;
    case DAR_SQUISHED:
    	*aspectOp = @WSAspectSquished;
    	break;
    case DAR_VERY_SQUISHED:
    	*aspectOp = @WSAspectVerySqished;
    	break;
    EC( default: ProgError("invalid AspectRatio in WSFindVMTypeOptr"); MessageNumberBox(val); *aspectOp = @WSInavlidValue;)
    }

}

/*--------------------- WSFindDrawCommandData ---------------------
 *  Purpose:	Analyse VisMoniker and find draw command information
 *		see tokenExport for VisMonikerStructure
 *  Parameters:	dataPtr: pointer to VisMonikerWithGString
 *		cmdOp:	 return: draw command text
 *			 The text is the same for Asm and GOC
 *  Return:	bitmap bytes size (including header, palette, data)
 ---------------------------------------------------------------------------*/
int WSFindDrawCommandData(byte *dataPtr, optr *cmdOp) {
word *sizePtr;

    dataPtr += sizeof(VisMonikerWithGString);
    switch (*dataPtr) {
    case GR_DRAW_BITMAP_CP: *cmdOp = @WSDrawCmdDrawBitmap; break;
    case GR_FILL_BITMAP_CP: *cmdOp = @WSDrawCmdFillBitmap; break;
    EC(default: ProgError("Invaild commad in WSFindDrawCommandData"); *cmdOp = @WSInavlidValue; )
    }

    dataPtr++;
    sizePtr = (word*)dataPtr;
    return *sizePtr;
}

/*--------------------- WSFindBitmapData ---------------------
 *  Purpose:	Analyse VisMoniker and find bitmap information
 *		see tokenExport for VisMonikerStructure
 *  Parameters:	dataPtr:	pointer to VisMonikerWithGString
 *		width, height:	return: bitmap size
 *  Return:	Bitmap type flags (BMT_PALETTE, BMF_4BIT ... )
 ---------------------------------------------------------------------------*/
BMType WSFindBitmapData(byte *dataPtr, int *width, int *height, int *compact) {
Bitmap *bitmap;

    bitmap = (Bitmap*)(dataPtr +sizeof(VisMonikerWithGString) + 3);
    *width = bitmap->B_width;
    *height = bitmap->B_height;
    *compact = bitmap->B_compact;

    return bitmap->B_type;
}

/*--------------------- WSFindBitmapHeaderParamsGOC ---------------------
 *  Purpose:	Convert bitmap type value and compact value into paramter strings,
 *		required for bitmap headers
 *  Parameters:	bmFormat:   bitmap type value
 *		param1:     string for compact
 *		param2:	    string for bitmap type
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WSFindBitmapHeaderParamsGOC(int bmFormat, int compact, char *param1, char *param2) {
optr op;

    switch (compact) {
    case BMC_UNCOMPACTED: op = @WSCompactUncompacted; break;
    case BMC_PACKBITS: 	  op = @WSCompactPackbits; break;
    EC( default: ProgError("Invalid compact in WSFindBitmapHeaderParamsGOC"); op = @WSInavlidValue;)
    }
    strcpy(param1, LMemDeref(op));

    switch (bmFormat & BMT_FORMAT) {
    case BMF_MONO: op = @WSColorMono; break;
    case BMF_4BIT: op = @WSColor4Bit; break;
    case BMF_8BIT: op = @WSColor8Bit; break;
    case BMF_24BIT: op = @WSColor24Bit; break;
    EC( default: ProgError("Invalid bmFormat in WSFindBitmapHeaderParamsGOC"); op = @WSInavlidValue;)
    }
    strcpy(param2, LMemDeref(op));

    if (bmFormat & BMT_PALETTE) strcat(param2, LMemDeref(@WSTypeFlagPaletteGOC));
    if (bmFormat & BMT_MASK) 	strcat(param2, LMemDeref(@WSTypeFlagMaskGOC));

}

/*--------------------- WSWriteDataBytesGOC ---------------------
 *  Purpose:	Write a sequence of data bytes as GOC code to a file
 *  Parameters:	fh:	 file to write to
 *		dataPtr: pointer to data bytes
 *		cound:	 number of data bytes to write
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WSWriteDataBytesGOC(FileHandle fh, byte *dataPtr, int count) {
char buf[12];
int n;

    for ( n = 0; n < count;n++) {
	if ( (n & 0x07) == 0 ) FileWrite(fh, "\x0A\x0D\t\t", 4, FALSE);
	sprintf(buf, "0x%02X, ", *dataPtr);
	FileWrite(fh, buf, strlen(buf), FALSE);
	dataPtr++;
    }
}

/*--------------------- WriteMonikerGOC ---------------------
 *  Purpose:	Write moniker data as GOC code
 *  Context:
 *  Strategy:	See code
 *  Parameters:	fh:	destination file
 *		dataPtr:pointer to VisMonikerWithGString structure
 *		monikerSize: byte size of the whole moniker
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WriteMonikerGOC(FileHandle fh, byte *dataPtr, char *monikerName, VisMonikerListEntryType vmlet, int monikerSize) {
char *buf, *param1, *param2;
optr dsOp, styleOp, dcOp, aspectOp, cmdOp;
int width, height, compact, bmFormat, bitmapSize;
int palSize, cbDataValue;


    /*
     * Allocate a line buffer. Usually a line is shorter than 128 bytes
     * To be sure we allocate 256 bytes - 160 for the line and 2x48 for paramters
     */
    buf = malloc(256);
    param1 = buf + 160;
    param2 = buf + 208;
    MemLock(OptrToHandle(@MonikerHeaderGOC));

    /*
     * Write VisMonikerWidthGString part
     *	- Header: @visMoniker name = { /* bytesize * /
     *	- VM_type (displaySize, style, displayClass, aspect)
     *	- cached size (width, height)
     */
    sprintf(buf, LMemDeref(@MonikerHeaderGOC), monikerName, monikerSize);
    FileWrite(fh, buf, strlen(buf), FALSE);

    WSFindVMTypeOptr(vmlet, &dsOp, &styleOp, &dcOp, &aspectOp);
    sprintf(buf, LMemDeref(@MonikerVMTypeGOC), LMemDeref(dsOp), LMemDeref(styleOp), LMemDeref(dcOp), LMemDeref(aspectOp));
    FileWrite(fh, buf, strlen(buf), FALSE);


    bmFormat = WSFindBitmapData(dataPtr, &width, &height, &compact);
    sprintf(buf, LMemDeref(@MonikerCachedSizeGOC), width, height);
    FileWrite(fh, buf, strlen(buf), FALSE);

    /*
     * Write GString part
     *	- GStringDrawCommand (GSDrawBitmapAtCP / GSFillBitmapAtCP)
     *	- Bitmap header (complex or simple)
     *  - palette if we have one
     *	- point dataPtr to start of raw bitmap data and calcuate raw bitmapSize
     *	  WSFindDrawCommandData() returns bitmapSize including header and palette,
     *	  as required for GSDrawBitmapAtCP / GSFillBitmapAtCP
     */
    bitmapSize = WSFindDrawCommandData(dataPtr, &cmdOp);
    sprintf(buf, LMemDeref(@GStringHeaderGOC), LMemDeref(cmdOp), bitmapSize);
    FileWrite(fh, buf, strlen(buf), FALSE);

    WSFindBitmapHeaderParamsGOC(bmFormat, compact, param1, param2);
    if ( bmFormat & BMT_COMPLEX) {
    	/*
    	 * calculate important things: size of palette and value for CB_data
    	 */
    	palSize = ((bmFormat & BMT_FORMAT) == BMF_4BIT) ? 16 : 256;
    	palSize *= sizeof(PaletteEntry);
    	cbDataValue = sizeof(CBitmap) + 2 + palSize;

    	/*
    	 * write complex bitmap header
    	 *	- write CB_simple part
    	 *	- write complex part
    	 */
	strcat(param2, LMemDeref(@WSTypeFlagComplexGOC));
    	sprintf(buf, LMemDeref(@WSBitmapHeaderGOC), width, height, param1, param2);
    	FileWrite(fh, buf, strlen(buf), FALSE);

    	sprintf(buf, LMemDeref(@WSCmplxBitmapHeaderGOC), (height & 0xFF), ((height >> 8) & 0xFF), (cbDataValue & 0xFF), ((cbDataValue >> 8) & 0xFF));
    	FileWrite(fh, buf, strlen(buf), FALSE);

    	/*
    	 * write palette
    	 *	- update dataPtr to point behind the CBitmap header
    	 *	- write number of palette entries
    	 *	- write palette
    	 */
	dataPtr += sizeof(VisMonikerWithGString) + 3;	// point to bitmap header
	dataPtr += sizeof(CBitmap);			// point to number of palette entries
        WSWriteDataBytesGOC(fh, dataPtr, 2);		/* number of palette entries */
        FileWrite(fh, LMemDeref(@WSPaletteCountComment), strlen(LMemDeref(@WSPaletteCountComment)), FALSE);
        WSWriteDataBytesGOC(fh, dataPtr+2, palSize);	/* palette data */
        FileWrite(fh, LMemDeref(@WSPaletteEndComment), strlen(LMemDeref(@WSPaletteEndComment)), FALSE);
        FileWrite(fh, "\x0A\x0D", 2, FALSE);

    	/*
    	 * update data pointer to point to raw bitmap data
    	 * update bitmapSize to value without header and palette
    	 */
	dataPtr += 2 + palSize;				// point to raw bitmap data
	bitmapSize -= sizeof(CBitmap) + 2 + palSize;	// raw bitmap data size


    } else {
    	/*
    	 * write simple bitmap header
    	 */
    	sprintf(buf, LMemDeref(@WSBitmapHeaderGOC), width, height, param1, param2);
    	FileWrite(fh, buf, strlen(buf), FALSE);

    	/*
    	 * update data pointer to point to raw bitmap data
    	 * update bitmapSize to value without header
    	 */
	dataPtr += sizeof(VisMonikerWithGString) + 3;	// point to bitmap header
	dataPtr += sizeof(Bitmap);			// point to raw bitmap data
	bitmapSize -= sizeof(Bitmap);			// raw bitmap data size
    }


    /* Bitamp data + End GString */
    WSWriteDataBytesGOC(fh, dataPtr, bitmapSize);
    FileWrite(fh, LMemDeref(@GStringEndGOC), strlen(LMemDeref(@GStringEndGOC)), FALSE);

    /*
     * Clean up
     */
    MemUnlock(OptrToHandle(@MonikerHeaderGOC));
    free(buf);
}

/*--------------------- WSFindBitmapHeaderParamsASM ---------------------
 *  Purpose:	Convert bitmap type value and compact value into paramter strings,
 *		required for bitmap headers
 *  Parameters:	bmFormat:   bitmap type value
 *		param1:     string for compact
 *		param2:	    string for bitmap type
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WSFindBitmapHeaderParamsASM(int bmFormat, int compact, char *param1, char *param2) {
optr op;

    switch (compact) {
    case BMC_UNCOMPACTED: op = @WSCompactUncompacted; break;
    case BMC_PACKBITS: 	  op = @WSCompactPackbits; break;
    EC( default: ProgError("Invalid compact in WSFindBitmapHeaderParamsASM"); op = @WSInavlidValue;)
    }
    strcpy(param1, LMemDeref(op));

    switch (bmFormat & BMT_FORMAT) {
    case BMF_MONO: op = @WSColorMono; break;
    case BMF_4BIT: op = @WSColor4Bit; break;
    case BMF_8BIT: op = @WSColor8Bit; break;
    case BMF_24BIT: op = @WSColor24Bit; break;
    EC( default: ProgError("Invalid bmFormat in WSFindBitmapHeaderParamsASM"); op = @WSInavlidValue;)
    }
    strcpy(param2, LMemDeref(op));

    if (bmFormat & BMT_PALETTE) strcat(param2, LMemDeref(@WSTypeFlagPaletteASM));
    if (bmFormat & BMT_MASK) 	strcat(param2, LMemDeref(@WSTypeFlagMaskASM));

}

/*--------------------- WSWriteDataBytesASM ---------------------
 *  Purpose:	Write a sequence of data bytes as UI asm code to a file
 *  Parameters:	fh:	 file to write to
 *		dataPtr: pointer to data bytes
 *		cound:	 number of data bytes to write
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WSWriteDataBytesASM(FileHandle fh, byte *dataPtr, int count) {
char buf[12];
int n;

    for ( n = 0; n < count;n++) {
	if ( (n & 0x07) == 0 ) { strcpy(buf, "\x0A\x0D\t    db\t");
				 FileWrite(fh, buf, strlen(buf), FALSE); }
			else   { FileWrite(fh, ", ", 2, FALSE); }
	sprintf(buf, "0x%02X", *dataPtr);
	FileWrite(fh, buf, strlen(buf), FALSE);
	dataPtr++;
    }
}

/*--------------------- WriteMonikerAsm ---------------------
 *  Purpose:	Write moniker data as UIC (asm) code
 *  Context:
 *  Strategy:
 *  Parameters:	fh:	destination file
 *		dataPtr:pointer to VisMonikerWithGString structure
 *		minikerSize: byte size of the whole moniker
 *  Return:	-
 ---------------------------------------------------------------------------*/
void WriteMonikerAsm(FileHandle fh, byte *dataPtr, char *monikerName, VisMonikerListEntryType vmlet, int monikerSize) {
char *buf, *param1, *param2;
optr dsOp, styleOp, dcOp, aspectOp, cmdOp;
int width, height, compact, bmFormat, bitmapSize;
int palSize, cbDataValue;


    /*
     * Allocate a line buffer. Usually a line is shorter than 128 bytes
     * To be sure we allocate 256 bytes - 160 for the line and 2x48 for paramters
     */
    buf = malloc(256);
    param1 = buf + 160;
    param2 = buf + 208;
    MemLock(OptrToHandle(@MonikerHeaderASM));

    /*
     * Write VisMonikerWidthGString part
     *	- Header: @visMoniker name = { /* bytesize * /
     *	- VM_type (displaySize, style, displayClass, aspect)
     *	- cached size (width, height)
     */
    sprintf(buf, LMemDeref(@MonikerHeaderASM), monikerName, monikerSize);
    FileWrite(fh, buf, strlen(buf), FALSE);

    WSFindVMTypeOptr(vmlet, &dsOp, &styleOp, &dcOp, &aspectOp);
    sprintf(buf, LMemDeref(@MonikerVMTypeASM), LMemDeref(dsOp), LMemDeref(styleOp), LMemDeref(dcOp), LMemDeref(aspectOp));
    FileWrite(fh, buf, strlen(buf), FALSE);


    bmFormat = WSFindBitmapData(dataPtr, &width, &height, &compact);
    sprintf(buf, LMemDeref(@MonikerCachedSizeASM), width, height);
    FileWrite(fh, buf, strlen(buf), FALSE);

    /*
     * Write GString part
     *	- GStringDrawCommand (GSDrawBitmapAtCP / GSFillBitmapAtCP)
     *	- Bitmap header (complex or simple)
     *  - palette if we have one
     *	- point dataPtr to start of raw bitmap data and calcuate raw bitmapSize
     *	  WSFindDrawCommandData() returns bitmapSize including header and palette,
     *	  as required for GSDrawBitmapAtCP / GSFillBitmapAtCP
     */
    bitmapSize = WSFindDrawCommandData(dataPtr, &cmdOp);
    sprintf(buf, LMemDeref(@GStringHeaderASM), LMemDeref(cmdOp), bitmapSize);
    FileWrite(fh, buf, strlen(buf), FALSE);

    WSFindBitmapHeaderParamsASM(bmFormat, compact, param1, param2);
    if ( bmFormat & BMT_COMPLEX) {
    	/*
    	 * calculate important things: size of palette and value for CB_data
    	 */
    	palSize = ((bmFormat & BMT_FORMAT) == BMF_4BIT) ? 16 : 256;
    	palSize *= sizeof(PaletteEntry);
    	cbDataValue = sizeof(CBitmap) + 2 + palSize;

    	/*
    	 * write complex bitmap header
    	 *	- write CB_simple part
    	 *	- write complex part
    	 */
	strcat(param2, LMemDeref(@WSTypeFlagComplexASM));
    	sprintf(buf, LMemDeref(@WSCmplxBitmapHeaderASM), width, height, param1, param2, height, cbDataValue);
    	FileWrite(fh, buf, strlen(buf), FALSE);

    	/*
    	 * write palette
    	 *	- update dataPtr to point behind the CBitmap header
    	 *	- write number of palette entries
    	 *	- write palette
    	 */
	dataPtr += sizeof(VisMonikerWithGString) + 3;	// point to bitmap header
	dataPtr += sizeof(CBitmap);			// point to number of palette entries
        WSWriteDataBytesASM(fh, dataPtr, 2);		/* number of palette entries */
        FileWrite(fh, LMemDeref(@WSPaletteCountComment), strlen(LMemDeref(@WSPaletteCountComment)), FALSE);
        WSWriteDataBytesASM(fh, dataPtr+2, palSize);	/* palette data */
        FileWrite(fh, LMemDeref(@WSPaletteEndComment), strlen(LMemDeref(@WSPaletteEndComment)), FALSE);
        FileWrite(fh, "\x0A\x0D", 2, FALSE);


    	/*
    	 * update data pointer to point to raw bitmap data
    	 * update bitmapSize to value without header and palette
    	 */
	dataPtr += 2 + palSize;				// point to raw bitmap data
	bitmapSize -= sizeof(CBitmap) + 2 + palSize;	// raw bitmap data size


    } else {
    	/*
    	 * write simple bitmap header
    	 */
    	sprintf(buf, LMemDeref(@WSBitmapHeaderASM), width, height, param1, param2);
    	FileWrite(fh, buf, strlen(buf), FALSE);

    	/*
    	 * update data pointer to point to raw bitmap data
    	 * update bitmapSize to value without header
    	 */
	dataPtr += sizeof(VisMonikerWithGString) + 3;	// point to bitmap header
	dataPtr += sizeof(Bitmap);			// point to raw bitmap data
	bitmapSize -= sizeof(Bitmap);			// raw bitmap data size
    }


    /* Bitamp data + End GString */
    WSWriteDataBytesASM(fh, dataPtr, bitmapSize);
    FileWrite(fh, LMemDeref(@GStringEndASM), strlen(LMemDeref(@GStringEndASM)), FALSE);

    /*
     * Clean up
     */
    MemUnlock(OptrToHandle(@MonikerHeaderASM));
    free(buf);
}

