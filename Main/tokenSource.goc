/*---------------------------------------------------------------------------
	Global Variables and local headers
 ---------------------------------------------------------------------------*/
GlobalStruct global;


/***********************************************************************
 *
 *	Write token as source code - Part 1: handling UI
 *	------------------------------------------------
 *
 ***********************************************************************/
int	ToolWriteSourceCheckReady(VMFileHandle vmFile, int iSet, int curIcon);
void 	WriteSourceSelectTooLargeItems(VMFileHandle vmFile, int iSet);
void 	WriteSourceSelectEmptyOrTCItems(VMFileHandle vmFile, int iSet);
void 	WriteSourceSelectDoublePropertyItems(VMFileHandle vmFile, int iSet);
Boolean WriteSourceCheckDuplicatedNames(VMFileHandle vmFile, int iSet, Boolean selectItems);

/*--------------------- WriteSourceEnterDefaultPath ---------------------
 *  Purpose:	If there is no path in ATTR_GEN_PATH_DATA of the WriteSourceDialog,
 		dialog object, read path from ini or enter SP_DOCUMENT
 ---------------------------------------------------------------------------*/
void WriteSourceEnterDefaultPath(void) {
Boolean err;
word	size, disk;
char *fullPath;
const char *spp;

    fullPath = malloc(IE_FULL_PATH_BUFFER_SIZE);
    spp = fullPath;

    err = InitFileReadStringBuffer(IE_INI_CATEGORY, IE_INI_PATH_KEY, fullPath, IE_FULL_PATH_BUFFER_SIZE, &size);
    if ( err ) goto enterDocument;

    disk = FileParseStandardPath(0, &spp);
    FileSetCurrentPath(disk, spp);

    free(fullPath);
    return;

enterDocument:
    FileSetStandardPath(SP_DOCUMENT);
    free(fullPath);
}

/*--------------------- ToolUpdateWriteSourcePath ---------------------
 *  Purpose:	Update WriteSourcePathText to reflect the actual path
 *  Context:
 *  Strategy:
 	- Read path from WriteSourceDialog object
 	- if not found, use SP_DOCUMENT
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void ToolUpdateWriteSourcePath(void) {
GenFilePath *gfp = 0;
char *fpp, *fullPath = 0;
Boolean found;

    /*
     * Last used path is stored in ATTR_GEN_PATH_DATA of the dialog object
     */
    gfp = malloc(sizeof(GenFilePath));
    fullPath = malloc(IE_FULL_PATH_BUFFER_SIZE);

    found = @call WriteSourceDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);
    if (found == (-1)) {
        FilePushDir();
    	WriteSourceEnterDefaultPath();
        gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
        FilePopDir();
    }

    fpp = fullPath;
    FileConstructFullPath (&fpp, IE_FULL_PATH_BUFFER_SIZE, gfp->GFP_disk, gfp->GFP_path, TRUE);
    @call WriteSourcePathText::MSG_VIS_TEXT_REPLACE_ALL_PTR(fullPath, 0);

    free(gfp);
    free(fullPath);
}

/*--------------------- MSG_DB_VIEWER_INITIALIZE_WRITE_SOURCE_DIALOG ---------------------
 *  Purpose:	Set up all data required to work with the WriteSourceDialog
 *  Context:
 *  Strategy:
 	- initialize list of icon moniker names
 	- display token ID and token chars
 	- find  standard size icon for the token and display it
 	- check if we are ready for export
 		- icon bitmap sizes must be smaller than 8 kb
 		  perhaps we must compress it
 		- we cannot have twice the same combination of display size,
 		  display class, icon style and aspect ratio.
 		- warn, if one of the images is a (possibly large) true color image
	- enable "Export" trigger if all checks has been passe
 *  Parameters:
 *  Return:	TRUE, if canceled by user or no icon set available
 *		FALSE if dialog box can opned (even if not ready for export)
 ---------------------------------------------------------------------------*/
@extern method IconDBViewerClass, MSG_DB_VIEWER_INITIALIZE_WRITE_SOURCE_DIALOG {
int count, iconsToWrite;
int ready, warn;

    /*
     * Check initial settings. Reset all related flags
     */
    @send WriteSourceMonikerList::MSG_GEN_DYNAMIC_LIST_INITIALIZE(0);
    if ( pself->DBVI_currentISet == NO_CURRENT_ISET ) return TRUE;
    if ( pself->DBVI_currentIcon == NO_CURRENT_ICON ) return TRUE;
    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return TRUE;

    global.flags &= ~(GF_WRITE_CODE_DOUBLE_NAMES | GF_WRITE_CODE_CURRENT_ICON_ONLY);

    /*
     * Initialize moniker list.
     *	iconsToWrite == WSIT_CURRENT_ICON: only currently editied icon
     *	else: all icons
     */
    iconsToWrite = @call WriteSourceIconChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    if ( iconsToWrite == WSIT_CURRENT_ICON) {
    	global.flags |= GF_WRITE_CODE_CURRENT_ICON_ONLY;
    	@send WriteSourceMonikerList::MSG_GEN_DYNAMIC_LIST_INITIALIZE(1);
    } else {
    	count = IdGetEntryCount(pself->DBVI_vmFile, pself->DBVI_currentISet);
    	@send WriteSourceMonikerList::MSG_GEN_DYNAMIC_LIST_INITIALIZE(count);
    }


    /*
     * Display path to store the file
     */
    ToolUpdateWriteSourcePath();

    /*
     * Check if ready for export. If not, display the reason.
     * At first, setup initial state for UI (not ready, all compress options allowed)
     */
    @send WriteSourceOKTrigger::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
    ToolSetTextWashColor(@WriteSourceInfoText, C_LIGHT_RED);

    @send WSCompressAlways::MSG_GEN_SET_ENABLED(VUM_NOW);
    @send WSCompressNever::MSG_GEN_SET_ENABLED(VUM_NOW);

    ready = ToolWriteSourceCheckReady(pself->DBVI_vmFile, pself->DBVI_currentISet , pself->DBVI_currentIcon);
    warn = ready & TOKEN_WARNING_BITS;
    ready &= TOKEN_STATUS_BITS;

    /*
     * depending on ready state, update UI or return
     */
    switch ( ready ) {

    case TOKEN_READY_IF_MINIMZE:
    	/*
    	 * We can only use 'minimize size' option
    	 */
	@send WSCompressAlways::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	@send WSCompressNever::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	@send WriteSourceCompressOptions::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(COMPRESS_ICON_AUTO, FALSE);
	goto weAreReady;

    case TOKEN_READY_IF_COMPRESS:
    	/*
    	 * We can use 'minimize size' or 'compress always' option
    	 */
    	if ( COMPRESS_ICON_NEVER == @call WriteSourceCompressOptions::MSG_GEN_ITEM_GROUP_GET_SELECTION() ) {
    	    @send WriteSourceCompressOptions::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(COMPRESS_ICON_AUTO, FALSE);
    	}
	@send WSCompressNever::MSG_GEN_SET_NOT_ENABLED(VUM_NOW);
	goto weAreReady;


    case TOKEN_NOT_READY_BECAUSE_SIZE:
    	/*
    	 * We have at least on icon that is larger than MAX_SAFE_MONIKER_SIZE
    	 * We cannot write this set of icons as source code.
    	 */
        WriteSourceSelectTooLargeItems(pself->DBVI_vmFile, pself->DBVI_currentISet);
    	@send WriteSourceInfoText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@WriteSourceTooLargeIcons, 0);
    	return FALSE;

EC(    case TOKEN_NOT_READY_BECAUSE_PROPERTIES: \
	ProgError("TOKEN_NOT_READY_BECAUSE_PROPERTIES in WriteSourceCodeCheck"); \
    	return FALSE; )
    }

weAreReady:
    /*
     * Display warnings, if we have any
     */
    @send WriteSourceInfoText::MSG_VIS_TEXT_DELETE_ALL();
    if (warn) {
    	WriteSourceSelectEmptyOrTCItems(pself->DBVI_vmFile, pself->DBVI_currentISet);
    	ToolSetTextWashColor(@WriteSourceInfoText, 244);	/* Warning color */

        if (warn & TOKEN_RGB_WARNING) {
    	    @send WriteSourceInfoText::MSG_VIS_TEXT_APPEND_OPTR(@WriteSourceRGBWarning, 0);
    	    }
        if (warn & TOKEN_EMPTY_WARNING) {
    	    @send WriteSourceInfoText::MSG_VIS_TEXT_APPEND_OPTR(@WriteSourceEmptyWarning, 0);
    	    }
        if (warn & TOKEN_PROPERTIES_WARNING) {
            WriteSourceSelectDoublePropertyItems(pself->DBVI_vmFile, pself->DBVI_currentISet);
    	    @send WriteSourceInfoText::MSG_VIS_TEXT_APPEND_OPTR(@WriteSourceDoublePropertiesWarning, 0);
    	    }

        if (warn & TOKEN_ICON_NAMES_WARNING) {
            WriteSourceCheckDuplicatedNames(pself->DBVI_vmFile, pself->DBVI_currentISet, TRUE);
    	    @send WriteSourceInfoText::MSG_VIS_TEXT_APPEND_OPTR(@WriteSourceDoubleNameWarning, 0);
    	    }


    } else {
    	ToolSetTextWashColor(@WriteSourceInfoText, COLOR_DARK_SILVER);
    }

    @send WriteSourceInfoText::MSG_VIS_TEXT_APPEND_OPTR(@WriteSourceReadyText, 0);
    @send WriteSourceOKTrigger::MSG_GEN_SET_ENABLED(VUM_NOW);
    return FALSE;
}


/*--------------------- MSG_ICON_DO_WRITE_SOURCE_DIALOG ---------------------
 *  Purpose:	Open WriteSourceDialog, handle 'select geode' and initiate
 *		real export to token database
 *  Context:	This must be done in the process thread or file selectors will not work
 *  Strategy:
 	- open WriteSourceDialog
 	- if cmd == IC_SELECT_PATH: request ne path and update UI
 	  restart WriteSourceDialog
	- if cmd == IC_OK: write icons as source code (MSG_DB_VIEWER_WRITE_SOURCE_CODE)
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconProcessClass, MSG_ICON_DO_WRITE_SOURCE_DIALOG {
int 	cmd, cmd2;
Boolean err;
GenFilePath *gfp = 0;
int found;

    AppMarkBusy();
    err = @call ConstructOptr(OptrToHandle(global.curFatbits), OptrToChunk(@DBViewerContent))::MSG_DB_VIEWER_INITIALIZE_WRITE_SOURCE_DIALOG();
    AppMarkNotBusy();
    if (err) return;

doDialog:

    cmd = UserDoDialog(@WriteSourceDialog);


    @send WriteSourceDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);

    /*
     * if cmd == IC_SELECT_PATH: select path to the moniker file
     */
    if (cmd == IC_SELECT_PATH) {

	/*
	 * Set path. Last used path ist stored in ATTR_GEN_PATH_DATA of
	 * the dialog object (see below)
	 */
        FilePushDir();
	if (!gfp) gfp = malloc(sizeof(GenFilePath));
	found = @call WriteSourceDialog::MSG_META_GET_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);

	if (found != (-1)) {
	    FileSetCurrentPath(gfp->GFP_disk, gfp->GFP_path);
	} else {
	    WriteSourceEnterDefaultPath();
	}

        /*
         * Request Path.
         */
        MemLock(OptrToHandle(@WriteSourcePathTitle));
	cmd2 = FileToolRequestChangeDir(@WriteSourcePathInfoText, LMemDeref(@WriteSourcePathTitle), NULL, TRUE);
        MemUnlock(OptrToHandle(@WriteSourcePathTitle));

    	if ( cmd2 == IC_OK) {
	    /*
	     * Store current path in ATTR_GEN_PATH_DATA of the dialog object
	     * Update UI
	     */
	    gfp->GFP_disk = FileGetCurrentPath (gfp->GFP_path, sizeof(PathName));
	    @call WriteSourceDialog::MSG_META_ADD_VAR_DATA(ATTR_GEN_PATH_DATA, sizeof(GenFilePath), gfp);
	    ToolUpdateWriteSourcePath();
    	}

	/* Restart dialog */
	FilePopDir();
        goto doDialog;
    }		// end of select geode


    /*
     * free path buffer
     */
    if(gfp) free(gfp);

    /*
     * if cmd == IC_OK: write token icons as source code
     */
    if (cmd == IC_OK) {
    	err = @call ConstructOptr(OptrToHandle(global.curFatbits), OptrToChunk(@DBViewerContent))::MSG_DB_VIEWER_WRITE_SOURCE_CODE();
    	if (err) goto doDialog;
    }

}

/*--------------------- IconFindValidIconName ---------------------
 *  Purpose:	Find an unique name for the icon.
 *  Context:	If an icon's name occurs twice in the code, compiling fails
 *  Strategy:
 	- get name. if there are no duplicated anme, we are done
 	- see if the current name occurs twice or more
 	  if yes, create an unique name
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IconFindValidIconName(VMFileHandle vmFile, int iSet, int icon, char *name) {
int count, n, anz;
char name2[ICON_NAME_BUFFER_SIZE];

    /*
     * Get actual name. If there are no duplicates, return.
     */
    IdGetEntryName(vmFile, iSet, icon, name);
    if ( (global.flags & GF_WRITE_CODE_DOUBLE_NAMES) == 0 ) return;

    /*
     *	See if our name occurs twice or more
     */
    count = IdGetEntryCount(vmFile, iSet);
    if ( count < 2 ) return;

    anz = 0;
    for ( n = 0; n < count; n++ ) {
        IdGetEntryName(vmFile, iSet, n, name2);
	if ( strcmp(name, name2 )==0 ) anz++;
    	}

    if ( anz < 2 ) return;

    /*
     *	Fix the name by adding the icon number. I know that there is a very special
     *	case in which the name is still not unique:
     *		moniker 0: unnamed	--> will be renamed to unnamed00
     *		moniker 1: unnamed
     *		moniker 2: unnamed00	<-- Who does such a thing?
     *  But the effort required to check this is disproportionately high.
     */
    name[MAX_ICON_NAME_LENGTH - 2] = 0;
    sprintf(name2,"%02u", icon);
    strcat(name, name2);

}

/*--------------------- MSG_ICON_APP_WRITE_SOURCE_QUERY_ICON ---------------------
 *  Purpose:	Replace icon moniker in WriteSourceMonikerList
 *  Context:
 *  Strategy:	construct string like "48x30, file icon, 16 color screen"
 *  Parameters:	GEN_DYNAMIC_LIST_QUERY_MSG (optr list, word item);
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method IconApplicationClass, MSG_ICON_APP_WRITE_SOURCE_QUERY_ICON {
char 	buf[MAX_ICON_NAME_LENGTH + 20];
char *name;
int	iSet, width, height, icon, currentIcon;
VMFileHandle vmFile;

    /*
     * Get current iSet, vmFile and current icon
     * if "current icon" is selected, ignore passed list item and use current icon
     */
    iSet = ToolGetCurrentISetData(&vmFile, &currentIcon);
    icon = item;

    if (global.flags & GF_WRITE_CODE_CURRENT_ICON_ONLY) icon = currentIcon;

    /*
     * Get icon size and icon name
     */
    IdGetEntryDimensions(vmFile, iSet, icon, &width, &height);
    sprintf(buf,"%ux%u, ", width, height);
    name = strchr(buf,0);
    IconFindValidIconName(vmFile, iSet, icon, name);

    /*
     * Replace icon moniker
     */
    @call list::MSG_GEN_DYNAMIC_LIST_REPLACE_ITEM_TEXT (item, buf);
}

