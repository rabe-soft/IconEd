/*--------------------- ToolChangeTextSize ---------------------
 *	Purpose:	Set a new value for ATTR_GEN_TEXT_DEFAULT_CHAR_ATTR
 *	Strategy:
 *	- set up VisTextDefaultCharAttr
 *	- setobjext not usable and send attr
 *	- set the object usable only if it was usable bevore.
 *	Parameters:	optr textObj
 			int size	- pass a VTDS_-value
 ---------------------------------------------------------------------------*/
void ToolChangeTextSize(optr textObj, int size) {
VisTextDefaultCharAttr  attr;
Boolean isUsable;

     attr = ((size << VTDCA_SIZE_OFFSET) | VTDF_UNIVERSITY);
     isUsable = @call textObj::MSG_GEN_GET_USABLE();

     @send textObj::MSG_GEN_SET_NOT_USABLE(VUM_DELAYED_VIA_UI_QUEUE);
     @send textObj::MSG_META_ADD_VAR_DATA(ATTR_GEN_TEXT_DEFAULT_CHAR_ATTR, 2, &attr);
     if (isUsable )
     	@send textObj::MSG_GEN_SET_USABLE(VUM_NOW);

}

/*--------------------- MSG_ICON_QUICK_HELP_SIZE_CHANGED ---------------------
 *	Purpose:	Select a new help theme
 *	Parameters:	(GEN_ITEM_GROUP_APPLY_MSG)
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_QUICK_HELP_SIZE_CHANGED {

     ToolChangeTextSize(@TermsTextField, selection);
     ToolChangeTextSize(@StandardIconTextField, selection);
     ToolChangeTextSize(@ColorInfoTextField, selection);
}

/*--------------------- MSG_ICON_QUICK_HELP_THEME_CHANGED ---------------------
 *	Purpose:	Select a new help theme
 *	Parameters:	(GEN_ITEM_GROUP_APPLY_MSG)
 ---------------------------------------------------------------------------*/
@method IconProcessClass, MSG_ICON_QUICK_HELP_THEME_CHANGED {
optr obj = 0;

     @send TermsTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
     @send StandardIconTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);
     @send ColorInfoTextField::MSG_GEN_SET_NOT_USABLE(VUM_NOW);

     switch (selection) {
     case HELP_THEME_TERMS: obj = @TermsTextField; break;
     case HELP_THEME_ICONS: obj = @StandardIconTextField; break;
     case HELP_THEME_COLOR: obj = @ColorInfoTextField; break;
     }

     if (obj) {
         @send obj::MSG_GEN_SET_USABLE(VUM_NOW);
     }

}

