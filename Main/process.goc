/* -------------------- Test8BitTo4Bit ---------------------------------------
 * 8 Bit bitmap, die nur 16 Farben enthält, in 4 Bit Bitmap konvertieren
 * nicht löscne, wir evtl noch für Sigma oder Gonzo gebraucht
 * --------------------------------------------------------------------------- */
VMBlockHandle Test8BitTo4Bit(VMFileHandle srcFile, VMBlockHandle bmp8, VMFileHandle destFile) {
int n, x, maskLen, w, h;
BitmapAccessRecord srcBar, destBar;
byte *srcPtr, *destPtr;
word b;
VMBlockHandle 	bmp4;
PaletteEntry *palette;

    palette = malloc(16*sizeof(PaletteEntry));
    BTGetBitmapPalette(srcFile, bmp8, palette, 16);

    BTGetMoreBitmapInfos(srcFile, bmp8, &w, &h, NULL);
    bmp4 = BTCreateOffscreenBitmap(destFile, BMF_4BIT | BMT_MASK | BMT_PALETTE, w, h, palette);
    free(palette);

    /*
     *
     */
    maskLen = (w+7)/8;

    srcPtr = BTBitmapLock(srcFile, bmp8, &srcBar, 0);
    destPtr = BTBitmapLock(destFile, bmp4, &destBar, 0);

    for ( n = 0; n < h; n++ ) {

        /* Mask kopieren */
        memcpy(destPtr, srcPtr, maskLen);
        srcPtr += maskLen;
        destPtr += maskLen;

	/* Immer 2 8-bit-Byte in ein 4-Bit-Byte - gerade Breite vorausgesetzt */
	for ( x = 0; x < w/2; x++ ) {
		b = srcPtr[2*x] << 4;
		b |= srcPtr[2*x +1] & 0x0F;
		destPtr[x] = b;
	}

	srcPtr =  BTBitmapNext(&srcBar, FALSE);
	destPtr = BTBitmapNext(&destBar, TRUE);

    }

    BTBitmapUnlock(&srcBar, FALSE);
    BTBitmapUnlock(&destBar, TRUE);
    return bmp4;
}

/* -------------------- Test8BitTo4Bit ---------------------------------------
 * Bitmap aus Clipboard holen, nach 4 Bit konvertieren, zurück ins Clipboard - KEINE FEHLERPRÜFUNGEN
 * --------------------------------------------------------------------------- */
void TestConvertBitmapFromClipboard(void) {
VMBlockHandle bmp8, bmp4;

    /* vom Clipboard holen */
    bmp8 = BTGetClipboardItem(0, CIF_BITMAP, global.tempFile);
    if (!bmp8) {
    	MessageBox("Keine Bitmap im Clipboard");
    	return;
    	}

    /* Konvertieren */
    bmp4 = Test8BitTo4Bit(global.tempFile, bmp8, global.tempFile);

    /* Ins Clipboard */
    BTCopyBitmapToClipboard(global.tempFile, bmp4, BT_CLIP_COPY_ADD_GSTRING);

    /* Bitmaps freigeben */
    HugeArrayDestroy(global.tempFile, bmp4);
    HugeArrayDestroy(global.tempFile, bmp8);

    MessageBox("Bitmap konvertiert");
}



