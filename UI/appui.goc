/* All Shift-to-triggers have the same properties.
 * Private note: My make-extern tool creates an @extern statement from
 * @object GenTriggerClass obj__name (@extern object obj__name). Please
 * never use an idenifier instead of obj__name that is used as an
 * objecte variable elsewhere, or the programm crashes with courious
 * error messages - R.B. */
@define ShiftImageTrigger(obj__name, visMon, direction) \
    @object GenTriggerClass obj__name = { GI_visMoniker = list { visMon }; \
    ATTR_GEN_TRIGGER_ACTION_DATA = direction; \
    GTI_destination = process; GTI_actionMsg = MSG_ICON_SHIFT_IMAGE_TO; \
    }

@ShiftImageTrigger(ShiftImageTrigger1, @DrawPos1Moniker, SHIFT_TO_TOP_LEFT)
@ShiftImageTrigger(ShiftImageTrigger2, @DrawPos2Moniker, SHIFT_TO_TOP)
@ShiftImageTrigger(ShiftImageTrigger3, @DrawPos3Moniker, SHIFT_TO_TOP_RIGHT)
@ShiftImageTrigger(ShiftImageTrigger4, @DrawPos4Moniker, SHIFT_TO_LEFT)
@ShiftImageTrigger(ShiftImageTrigger6, @DrawPos6Moniker, SHIFT_TO_RIGHT)
@ShiftImageTrigger(ShiftImageTrigger7, @DrawPos7Moniker, SHIFT_TO_BOTTOM_LEFT)
@ShiftImageTrigger(ShiftImageTrigger8, @DrawPos8Moniker, SHIFT_TO_BOTTOM)
@ShiftImageTrigger(ShiftImageTrigger9, @DrawPos9Moniker, SHIFT_TO_BOTTOM_RIGHT)


@object GenGlyphClass ShiftImageSpacer = {
    GI_visMoniker = " ";
}
@object GenInteractionClass ShiftImageRightGroup = {
    GI_comp = @ShiftImageInfoText, @ShiftImageAmountValue;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}

@object GenValueClass ShiftImageAmountValue = {
    GI_visMoniker = 'S', "Shift Pixels:";
    GVLI_minimum = MakeWWFixed(1);
    GVLI_maximum = MakeWWFixed(32);
    GVLI_value = MakeWWFixed(1);
    HINT_PLACE_MONIKER_TO_LEFT;
}

@object GenTextClass ShiftImageInfoText = {
    GTXI_text = "Click on the arrows to shift the whole image.";
    HINT_INITIAL_SIZE = { 20 | SST_AVG_CHAR_WIDTHS, 1 | SST_LINES_OF_TEXT, 1 };
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}

@end DialogResource4;


