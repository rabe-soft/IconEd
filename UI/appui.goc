/*---------------------------------------------------------------------------
 Resource definition WriteSourceStringResource
 ---------------------------------------------------------------------------*/
@start WriteSourceStringResource, data;

/* --------- Strings to write VisMonikers to file --------
 * 	     A fixed size makes the string not localizable
 *	     As line ending CRLF (0D+0A) is used, as the original
 *	     Icon editor by Steve does.
 *
 *	     All of these chunks MUST be in the same resource
 *
 * -------------------------------------------------------*/

/* --------- Part 1: GOC code strings and common strings -------- */

@chunk char MonikerHeaderGOC[64] = "@visMoniker %s = { /* %u bytes */\x0A\x0D";
@chunk char MonikerVMTypeGOC[96] = "\tsize = %s;\x0A\x0D\
\tstyle = %s;\x0A\x0D\tcolor = %s;\x0A\x0D\taspectRatio = %s;\x0A\x0D";
@chunk char MonikerCachedSizeGOC[32] = "\tcachedSize = %u, %u;\x0A\x0D";
@chunk char GStringHeaderGOC[32] = "\tgstring {\x0A\x0D\t\t%s (%u),\x0A\x0D";

@chunk char WSBitmapHeaderGOC[32] = "\t\tBitmap (%u, %u, %s, (%s) ),";
@chunk char WSCmplxBitmapHeaderGOC[64] = "\x0A\x0D\t\t0, 0, %u,  %u, 0, 0, %u, %u, 20, 0, 72, 0, 72, 0,";

@chunk char WSColorMono[16] = "BMF_MONO";
@chunk char WSColor4Bit[16] = "BMF_4BIT";
@chunk char WSColor8Bit[16] = "BMF_8BIT";
@chunk char WSColor24Bit[16] = "BMF_24BIT";
	//chunk char WSColorCMYK[16] = "BMF_4CMYK";
	//chunk char WSColorCMY[16] = "BMF_3CMY";

@chunk char WSTypeFlagPaletteGOC[16] = " | BMT_PALETTE";
@chunk char WSTypeFlagMaskGOC[16] = " | BMT_MASK";
@chunk char WSTypeFlagComplexGOC[16] = " | BMT_COMPLEX";
	//chunk char WSTypeFlagHugeGOC[16] = " | BMT_HUGE";

@chunk char WSCompactUncompacted[24] = "BMC_UNCOMPACTED";
@chunk char WSCompactPackbits[16] = "BMC_PACKBITS";

@chunk char WSPaletteCountComment[48] = "\t\t\t\t\t\t/* number of palette entries */";
@chunk char WSPaletteEndComment[32] = "\t/* end of palette */";


@chunk char GStringEndGOC[32] = "\x0A\x0D\t\tGSEndString()\x0A\x0D\t}\x0A\x0D}\x0A\x0D\x0A\x0D";


@chunk char WSStyleText[16] = "text";
@chunk char WSStyleAbbrevText[16] = "abbrevText";
@chunk char WSStyleIcon[16] = "icon";
@chunk char WSStyleTool[16] = "tool";

@chunk char WSDispSizeTiny[16] = "tiny";
@chunk char WSDispSizeStandard[16] = "standard";
@chunk char WSDispSizeLarge[16] = "large";
@chunk char WSDispSizeHuge[16] = "huge";

@chunk char WSDispClassGray1[16] = "gray1";
@chunk char WSDispClassColor4[16] = "color4";
@chunk char WSDispClassColor8[16] = "color8";
@chunk char WSDispClassColorRGB[16] = "colorRGB";

@chunk char WSAspectNormal[16] = "normal";
@chunk char WSAspectSquished[16] = "squished";
@chunk char WSAspectVerySqished[16] = "verySquished";

@chunk char WSInavlidValue[16] = "<INVALID>";	/* useful for debugging */

@chunk char WSDrawCmdDrawBitmap[24] = "GSDrawBitmapAtCP";
@chunk char WSDrawCmdFillBitmap[24] = "GSFillBitmapAtCP";


/* --------- Part 2: Assembler code strings -------- */

@chunk char MonikerHeaderASM[64] = "visMoniker %s = { /* %u bytes */\x0A\x0D";
@chunk char MonikerVMTypeASM[96] = "\tsize = %s;\x0A\x0D\
\tstyle = %s;\x0A\x0D\tcolor = %s;\x0A\x0D\taspectRatio = %s;\x0A\x0D";
@chunk char MonikerCachedSizeASM[32] = "\tcachedSize = %u, %u;\x0A\x0D";
@chunk char GStringHeaderASM[64] = "\tgstring {\x0A\x0D\t\tGSBeginString\x0A\x0D\t\t%s %u\x0A\x0D";

@chunk char WSBitmapHeaderASM[32] = "\t\tBitmap <%u, %u, %s, %s >";
@chunk char WSCmplxBitmapHeaderASM[64] = "CBitmap <<%u ,%u, %s,%s>, 0, %u, 0, %u, 20, 72, 72>";


@chunk char WSTypeFlagPaletteASM[24] = " or mask BMT_PALETTE";
@chunk char WSTypeFlagMaskASM[24] = " or mask BMT_MASK";
@chunk char WSTypeFlagComplexASM[24] = " or mask BMT_COMPLEX";
	//chunk char WSTypeFlagHugeASM[24] = " or mask BMT_HUGE";

@chunk char GStringEndASM[32] = "\x0A\x0D\t\tGSEndString\x0A\x0D\t}\x0A\x0D}\x0A\x0D\x0A\x0D";

/* --------- End of Strings to write VisMonikers to file -------- */


@end WriteSourceStringResource;

/*---------------------------------------------------------------------------
 Resource definition Controllers
 ---------------------------------------------------------------------------*/
@start Controllers;

/*---------------------------------------------------------------------------
	The DocumentControl manages the the document of our application
	This is the database file
 ---------------------------------------------------------------------------*/
@object GenInteractionClass IconDocumentControlGroup = {
    GI_comp = @IconDocumentControl;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

@object GenDocumentControlClass IconDocumentControl = {

    GDCI_noNameText = "No Database";
    GDCI_documentGroup = IconDocumentGroup;

    GDCI_enableDisableList = IconEnableDisableList;

    GDCI_templateDir ="Icon Templates";
    GDCI_documentToken = { "IDOC", 0 };

    GDCI_attrs = (@default | GDCA_MULTIPLE_OPEN_FILES);
    GDCI_features = (@default) & ~(GDCF_NAME_ON_PRIMARY);
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}

/* All object in this list must be defined as ~GS_ENABLED */
@chunk optr IconEnableDisableList[] = { @IconEditMenu, @ISetMenu, @IconMenu,
	@IconOptionsMenu, @IconGraphicsMenu, @IconExtrasMenu,
	@IconTopImpexGroup };

@object GenToolGroupClass IconFileTools = {	/* in ToolGroupList */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    GTGI_controller = @IconDocumentControl;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_TOOLBOX;
}

/*---------------------------------------------------------------------------
	The DisplayControl managed the windows in the DisplayGroup
 ---------------------------------------------------------------------------*/
@object GenDisplayControlClass IconDisplayControl = {
}


/*---------------------------------------------------------------------------
 *	Edit-"Controller".
 *	Instead of using an EditControl object, we use a set of individual
 * 	triggers, since we can have both icons (graphics) and icon sets in
 *	the clipboard.
 *	Additionally, besides an Undo trigger, we also need a Redo trigger
 *	as well as an special tool setup for the tool bar.
 ---------------------------------------------------------------------------*/

/*--- Undo/Redo group ---*/

@object GenInteractionClass UndoRedoGroup = {
    GI_comp = @IconUndoTrigger, @IconRedoTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconUndoTrigger = {
    GI_visMoniker = "Undo:";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'Z';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_FATBITS_UNDO;
}
@object GenTriggerClass IconRedoTrigger = {
    GI_visMoniker = "Redo:";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'R';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_FATBITS_REDO;
}

/*--- Copy/Paste icon graphics group ---*/

@object GenInteractionClass EditGraphicsGroup = {
    GI_comp = @IconCopyIconTigger, @IconPasteIconTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconCopyIconTigger = {
    GI_visMoniker = 'o', "Copy Graphic";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'C';
    @SetTriggerDestination_TO_BITMAP;
    GTI_actionMsg = MSG_META_CLIPBOARD_COPY;
}
@object GenTriggerClass IconPasteIconTrigger = {
    GI_visMoniker = 'a', "Paste Graphic";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'V';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_META_CLIPBOARD_PASTE;
}

/*--- Copy/Paste whole sets of icons ---*/

@object GenInteractionClass EditIconSetGroup = {
    GI_comp = @IconCopyISetTrigger, @IconPasteISetTrigger, @IconSelectAllISetTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenTriggerClass IconCopyISetTrigger = {
    GI_states = @default & ~GS_ENABLED;
    GI_visMoniker = 'n', "(Copy Icon Set)";
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'I';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_COPY_PASTE_ISET;
    ATTR_GEN_TRIGGER_ACTION_DATA = ISET_COPY_SET;
}
@object GenTriggerClass IconPasteISetTrigger = {
    GI_visMoniker = 12, "(Paste Icon Set)";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'G';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_COPY_PASTE_ISET;
    ATTR_GEN_TRIGGER_ACTION_DATA = ISET_COPY_SET;
}
@object GenTriggerClass IconSelectAllISetTrigger = {
    GI_visMoniker = 'l', "Select all";
    GI_states = @default & ~GS_ENABLED;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = control 'A';
    @SetTriggerDestination_TO_DB_VIEWER;
    GTI_actionMsg = MSG_DB_VIEWER_COPY_PASTE_ISET;
    ATTR_GEN_TRIGGER_ACTION_DATA = ISET_SELECT_ALL;
}

/*--- Toolbar tools deal with the icon graphics ---*/
/*
 * For this purpose we need an special setup.
 *	- a GenToolGroup object to be placed in one of the toolbars
 *	- a Controller to make the GenToolControl object work
 *	- our self-defined tools UI
 */

@object GenToolGroupClass IconEditTools = {	/* place this in tool bar and ToolGroupList */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    /*
     * Any GenToolGroupClass object must by connected to a
     * controler to make the GenToolControl work
     */
    GTGI_controller = @ToolOnlyEditControl;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_MINIMIZE_CHILD_SPACING;
}

    /*
     * Set up a controller for our tools.
     * We hide any default UI, only our special UI is shown
     * as children of the IconEditTools object.
     * There are only tools, no "normal" UI.
     */
@object ToolOnlyControlClass ToolOnlyEditControl = {
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    ATTR_GEN_CONTROL_PROHIBIT_UI = 0xFFFF;
    TOCI_controllerName = @ToolOnylEditControlName;
    TOCI_SetupToolMsg = MSG_TOC_SETUP_EDIT_CONTROL_TOOLS;
}
@chunk char ToolOnylEditControlName[] = "Clipboard / Undo";





/*---------------------------------------------------------------------------
 *	Import- and Export-Controller.
 *	For a detailed description see Objects Manual, 16: Impex-Library
 ---------------------------------------------------------------------------*/

@object ExportControlClass IconExportControl = {
    GI_visMoniker = "Export Graphic to File";
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE;
    ECI_dataClasses = IDC_GRAPHICS;

    ECI_message = MSG_DB_VIEWER_PREPARE_FOR_EXPORT;
    ECI_destination = (TO_DB_VIEWER);
    ATTR_GEN_OUTPUT_TRAVEL_START = @IconApp;
    ATTR_GEN_DESTINATION_CLASS = (ClassStruct*)&IconDBViewerClass;
}


@object ImportControlClass IconImportControl = {
    GI_visMoniker = "Import Graphic from File";
    GII_attrs = @default | GIA_NOT_USER_INITIATABLE;
    ICI_dataClasses = IDC_GRAPHICS;

    ICI_message = MSG_DB_VIEWER_PREPARE_FOR_IMPORT;
    ICI_destination = (TO_DB_VIEWER);
    ATTR_GEN_OUTPUT_TRAVEL_START = @IconApp;
    ATTR_GEN_DESTINATION_CLASS = (ClassStruct*)&IconDBViewerClass;

}


/*-----------------------------------------------------------------------------
		Bitmap Controller & Tools
 -----------------------------------------------------------------------------*/

@object ToolOnlyControlClass IconBitmapToolControl = {
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    ATTR_GEN_CONTROL_PROHIBIT_UI = 0xFFFF;
    TOCI_controllerName = @ToolOnylBitmapControlName;
    TOCI_SetupToolMsg = MSG_TOC_SETUP_BITMAP_CONTROL_TOOLS;
}
@chunk char ToolOnylBitmapControlName[] = "Bitmap Tools";

@object GenToolGroupClass IconBitmapEditTools = {	/* in ToolGroupList */
    GTGI_controller = @IconBitmapToolControl;
    HINT_TOOLBOX;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_MINIMIZE_CHILD_SPACING;
}

/*-----------------------------------------------------------------------------
		Area Controller & Tools
 -----------------------------------------------------------------------------*/

@object GenInteractionClass IconAreaAttrDialog = {
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_PROPERTIES;
    GI_visMoniker = 'A', "Area Attributes";
    GI_comp = @IconAreaColorSelector;
}

@object GrObjAreaColorSelectorClass IconAreaColorSelector = {
    	/* Note: CSF_INDEX and CSTF_INDEX are prohibit, because they cannot handle
    	 * custom palettes. AreaColorToolIndexGroup and AreaColorGroup are added
    	 * instead. The drawback is, that they no longer have an entry in the
    	 * customize toolbar dialog box.
    	 */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    ATTR_GEN_CONTROL_APP_TOOLBOX_UI = @AreaColorToolIndexGroup;
    ATTR_GEN_CONTROL_APP_UI = @AreaColorGroup;
    ATTR_GEN_CONTROL_PROHIBIT_UI = CSF_INDEX | CSF_FILLED_LIST | CSF_OTHER;
    ATTR_GEN_CONTROL_PROHIBIT_TOOLBOX_UI = CSTF_INDEX;
    @SetControllerDestination_TO_BITMAP;
}


@object GenToolGroupClass IconAreaColorTools = {	/* in tool bar */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    GTGI_controller = @IconAreaColorSelector;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_MINIMIZE_CHILD_SPACING;
}




/*-----------------------------------------------------------------------------
		Area Controller additional UI that can work with a palette
 -----------------------------------------------------------------------------*/
@object GenInteractionClass AreaColorGroup = {
    GI_comp = @AreaColorIndexGroup, @AreaCustomColorsTrigger;
    GI_states = @default & ~GS_USABLE;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}
