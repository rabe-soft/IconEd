    GI_visMoniker = 'R', "Redraw Icon";
    GTI_actionMsg = MSG_ICON_REDRAW_FATBITS;
    GTI_destination = process;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = @specificUI F5;
