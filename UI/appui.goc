@object GenTextClass IPDisplayClassInfoText = {
    GI_attrs = @default | GA_READ_ONLY;
    GI_visMoniker = " ";
    HINT_PLACE_MONIKER_TO_LEFT;
    GTXI_text = "The display class describes the color depth that a \
screen needs to display the icon correctly. If the bitmap has a palette, \
even a 16-color bitmap may require 256 colors or more.\r\
GEOS uses the icon's display class to choose the proper icon.\r\r\
It is allowed to select a display class other than the suggested one.\r";
    /*ATTR_GEN_TEXT_DEFAULT_CHAR_ATTR = ((VTDS_12 << VTDCA_SIZE_OFFSET) | VTDF_UNIVERSITY); */
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
    HINT_MINIMUM_SIZE = { SST_AVG_CHAR_WIDTHS | 10, SST_LINES_OF_TEXT | 2, 0};
}

