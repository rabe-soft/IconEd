/*-----------------------------------------------------------------------------
			Customize Tools Dialog & Control
-----------------------------------------------------------------------------*/

@object GenInteractionClass CustomizeToolsDialog = {
    GI_visMoniker = 'C', "Customize Tool Bars";
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    GI_comp = @IconToolControl;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}


@object GenToolControlClass IconToolControl = {
    GTCI_toolboxList = @IconToolboxList;
    GTCI_toolGroupList = @IconToolGroupList;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    ATTR_GEN_CONTROL_APP_UI = @ToolMoreInfoBox;
    	/* Note: Index colors for lines and areas are not managed by the
    	 * ToolControl object because they are proibited and some UI
    	 * that supports custom palettes has been added using
    	 * ATTR_GEN_CONTROL_APP_TOOLBOX_UI instead.
    	 */
}

@chunk optr IconToolboxList[] = {	/*ToolboxInfo = struct { optr, optr } */

@if @USE_TWO_TOP_TOOL_BARS
	@TopLeftToolbar,	@TopLeftToolbarName,
	@TopRightToolbar,	@TopRightToolbarName,
@else
	@TopToolbar,		@TopToolbarName,
@endif
	@LeftToolbar,		@LeftToolbarName,
	@RightToolbar,		@RightToolbarName,
	@BottomToolbar,		@BottomToolbarName,
	@FloatingToolbox,	@FloatingToolboxName
};

@if @USE_TWO_TOP_TOOL_BARS
@chunk char TopLeftToolbarName[] = "Above the Document, on the left";
@chunk char TopRightToolbarName[] = "Above the Document, on the right";
@elseif
@chunk char TopToolbarName[] = "Above the Document";
@endif

@chunk char LeftToolbarName[] = "Left of Document";
@chunk char RightToolbarName[] = "Right of Document";
@chunk char BottomToolbarName[] = "Below the Document";
@chunk char FloatingToolboxName[] = "Floating Toolbox";

@chunk optr IconToolGroupList[] = {	/*ToolGroupInfo = struct {optr } */
	@IconFileTools,
	@IconEditTools,
	@IconLineColorTools,
	@IconLineAttrTools,
	@IconAreaColorTools,
	@IconBitmapEditTools,

	@Spacer1ToolGroup,
	@Spacer2ToolGroup,
	@Spacer3ToolGroup,
	@Spacer4ToolGroup,
	@Spacer5ToolGroup,
	@Spacer6ToolGroup
};

    /*
     * To make the toolbars look a little nicer, we have 6 spacers.
     * Each spacer consists of a ToolGroup object and a glyph. The
     * glyph is directly a child, because there is no special
     * tool ui for the spacer controller. We also need a
     * controller object so that the tool management can work.
     */
@define ToolSpacerCommonStuff(glyph, controller) \
	GI_states = @default |  GS_USABLE | GS_ENABLED; \
    	GI_comp = glyph;	\
    	GTGI_controller = controller; \
	HINT_SAME_ORIENTATION_AS_PARENT; \
	HINT_MINIMIZE_CHILD_SPACING



@define ToolControllerCommonStuff(name) \
 	GI_states = @default |  GS_USABLE | GS_ENABLED;	\
 	TOCI_controllerName =  name; \
	ATTR_GEN_CONTROL_PROHIBIT_UI = 0xFFff;	/* hide ALL UI - if any */ \
	ATTR_GEN_CONTROL_PROHIBIT_TOOLBOX_UI = 0xffFF


/* ToolGroups to place in tool bar and ToolGroupList */
@object GenToolGroupClass Spacer1ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer1Glyph, @Spacer1Control);
    }
@object GenToolGroupClass Spacer2ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer2Glyph, @Spacer2Control);
    }
@object GenToolGroupClass Spacer3ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer3Glyph, @Spacer3Control);
    }
@object GenToolGroupClass Spacer4ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer4Glyph, @Spacer4Control);
    }
@object GenToolGroupClass Spacer5ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer5Glyph, @Spacer5Control);
    }
@object GenToolGroupClass Spacer6ToolGroup = {
    @ToolSpacerCommonStuff(@Spacer6Glyph, @Spacer6Control);
    }

@object GenGlyphClass Spacer1Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer2Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer3Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer4Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer5Glyph = { GI_visMoniker = " "; }
@object GenGlyphClass Spacer6Glyph = { GI_visMoniker = " "; }

@object ToolOnlyControlClass Spacer1Control = {
    @ToolControllerCommonStuff(@ToolSpacer1Name);
    }
@object ToolOnlyControlClass Spacer2Control = {
    @ToolControllerCommonStuff(@ToolSpacer2Name);
    }
@object ToolOnlyControlClass Spacer3Control = {
    @ToolControllerCommonStuff(@ToolSpacer3Name);
    }
@object ToolOnlyControlClass Spacer4Control = {
    @ToolControllerCommonStuff(@ToolSpacer4Name);
    }
@object ToolOnlyControlClass Spacer5Control = {
    @ToolControllerCommonStuff(@ToolSpacer5Name);
    }
@object ToolOnlyControlClass Spacer6Control = {
    @ToolControllerCommonStuff(@ToolSpacer6Name);
    }


/* Names for our own ToolOnlyControlClass controllers */
@chunk char ToolSpacer1Name[] = "Spacer 1";
@chunk char ToolSpacer2Name[] = "Spacer 2";
@chunk char ToolSpacer3Name[] = "Spacer 3";
@chunk char ToolSpacer4Name[] = "Spacer 4";
@chunk char ToolSpacer5Name[] = "Spacer 5";
@chunk char ToolSpacer6Name[] = "Spacer 6";


/*---------------------------------------------------------------------------
 	Extra UI for Toolbox Control
 ---------------------------------------------------------------------------*/
@object GenInteractionClass ToolMoreInfoBox = {
    GI_visMoniker = 'x', "Extra Information";
    GI_comp = @ToolMoreInfoText;
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    GI_states = @default & ~GS_USABLE;
}
@object GenTextClass ToolMoreInfoText = {
    GI_visMoniker = " ";
    GTXI_text = "\rIt is intended that some tool groups do not have tools in \
the dialog box for showing or hiding tools, and that some of the available tools are \
not displayed for other tool groups.\r";
    HINT_MINIMUM_SIZE = { SST_AVG_CHAR_WIDTHS | 35, SST_LINES_OF_TEXT | 1, 1 };
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}


@end Controllers2;


/*---------------------------------------------------------------------------
	DocumentUI
---------------------------------------------------------------------------*/

@start DocumentUI ;

@object GenDocumentGroupClass IconDocumentGroup = {
    GDGI_untitledName = "Untitled";
    GDGI_protocolMajor = DOCUMENT_PROTOCOL_MAJOR;
    GDGI_protocolMinor = DOCUMENT_PROTOCOL_MINOR;
    GDGI_documentControl = IconDocumentControl;
    GDGI_documentClass = (ClassStruct*) &IconDBDocumentClass;

    GDGI_genDisplay = IconDBDisplay;
    GDGI_genDisplayGroup = IconDisplayGroup;
    ATTR_GEN_PATH_DATA = {SP_DOCUMENT, ""};

/* GDGI_genDocument = not used */
/* GDGI_genView = not usesd */

}

@end DocumentUI;

/***********************************************************************
 *
 *  DisplayUI: This resource will be duplicated once for each document.
 *
 *
 *  The most important objects in the DisplayGroup are shown below.
 *  Grouping objects have been left out.
 *
 *  IconDBDisplay (GenDisplayClass) 		   # the top object #
 *  -------------
 *      |
 *      |
 *      +-- IconDBView (GenViewClass)
 *      |    GVI_content = @DBViewerContent
 *      |    |
 *      |    DBViewerContent (IconDBViewerClass)   # the database viewer #
 *      |    ---------------
 *      |    Children: VisISetClass objects
 *      |    	  one object for each icon set in the database
 *      |
 *      |
 *      +-- FatbitsView (FatbitsViewClass)
 *      |    GVI_content = @MyFatbits
 *      |    |
 *      |    MyFatbits (FatbitsClass)		   # the edit object #
 *      |    ---------
 *      |    The object deals with the actual editing of the icons.
 *      |
 *      |
 *      +-- FatBitsMouseText (GenTextClass)	   # information objects #
 *      +-- FatBitsInfoText  (GenTextClass)
 *      |    Displays information about the currently edited icon.
 *      |
 *      |
 *      +-- LivePreviewView (GenViewClass)
 *      |    GVI_content = @LivePreviewContent
 *      |    |
 *      |    LivePreviewContent (OtherContentClass) # icon live preview #
 *      |    ------------------
 *      |    OCI_type = OC_TYPE_BITMAP
 *      |
 *      |
 *      +-- IconListView (GenViewClass)
 *	    GVI_content = @IconListContent
 *	    |
 *	    IconListContent (IconViewerClass)	    # icon list object #
 *	    ---------------
 *	    Children: VisIconClass objects
 *	    	      one object for each icon in the set
 *
 *
 ***********************************************************************/

@start DisplayUI ;

@object GenDisplayClass IconDBDisplay = {
    GI_states = @default & ~GS_USABLE;
    GI_comp = @IconDBView, @IconRightGroup;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    ATTR_GEN_DISPLAY_NOT_MINIMIZABLE;

    /*
     * Important: never set HINT_DEFAULT_FOCUS and HINT_DEFAULT_TARGET
     * here. This causes the wrong document to be active when restarting
     * after shutdown.
     */
}


/* -------- The display is organized in groups ---------- */

@object GenInteractionClass IconRightGroup = {		/* holds Fatbits and IconList */
	GI_comp = @IconFatbitsGroup, @IconColorbar, @IconOptionsGroup;
	HINT_ORIENT_CHILDREN_VERTICALLY;
	HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
	HINT_EXPAND_WIDTH_TO_FIT_PARENT;
	HINT_FULL_JUSTIFY_CHILDREN_VERTICALLY;
}

@object GenViewClass IconColorbar = {
    HINT_MINIMUM_SIZE = { SST_PIXELS | 1, SST_PIXELS | 1, 1};
    HINT_MAXIMUM_SIZE = { (SST_PCT_OF_FIELD_WIDTH | PCT_100), SST_PIXELS | 1, 1};

    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    GVI_attrs = @default | GVA_NO_WIN_FRAME;
    GVI_color = { C_BLUE, CF_INDEX, 0, 0 };
    GVI_content = @IconColorContent;	/* must have a content to work with ... */
    }
@object VisContentClass IconColorContent = {
}

@object GenInteractionClass IconOptionsGroup = {
    GI_comp = @LivePreviewGroup, @IconListView;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}



/* -------- The IconDBView displays the icon sets ---------- */

@object GenViewClass IconDBView = {

    GVI_content = @DBViewerContent;
    GVI_horizAttrs = @default | GVDA_SCROLLABLE;
    GVI_vertAttrs  = @default | GVDA_SCROLLABLE;
    HINT_VIEW_REMOVE_SCROLLERS_WHEN_NOT_SCROLLABLE;

    HINT_DEFAULT_FOCUS;
    HINT_DEFAULT_TARGET;

    /*
     * The geometry (sizeing) is very limited. This prevents the
     * object from covering a large part of the display.
     */
    HINT_MINIMUM_SIZE = { SST_PIXELS | VIEWER_VIEW_FIXED_WIDTH,
			SST_PIXELS | VIEWER_VIEW_MIN_HEIGHT, 1};
    HINT_MAXIMUM_SIZE = { SST_PIXELS | VIEWER_VIEW_FIXED_WIDTH,
			SST_LINES_OF_TEXT | VIEWER_VIEW_MAX_HEIGHT, 1};


    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;

}

@object IconDBViewerClass DBViewerContent = {
    VCNI_attrs = @default | VCNA_SAME_WIDTH_AS_VIEW;
    VCI_geoAttrs = VCGA_ALLOW_CHILDREN_TO_WRAP; /* | VCGA_WRAP_AFTER_CHILD_COUNT /*| VCGA_ONLY_DRAWS_IN_MARGINS*/
}


/* -------- The FatbitsView is the ediable display ---------- */

@object GenInteractionClass IconFatbitsGroup = {
    GI_comp = @FatbitsView, @FatBitsInfoTextGroup;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object FatbitsViewClass FatbitsView = {
    GVI_content = @MyFatbits;
    GVI_attrs = @default | GVA_DRAG_SCROLLING;
    GVI_horizAttrs = GVDA_NO_LARGER_THAN_CONTENT | GVDA_SCROLLABLE;
    GVI_vertAttrs =  GVDA_NO_LARGER_THAN_CONTENT | GVDA_SCROLLABLE;
    HINT_VIEW_REMOVE_SCROLLERS_WHEN_NOT_SCROLLABLE;
    HINT_MINIMUM_SIZE = { SST_PIXELS |  FATBITS_MIN_WIDTH, SST_PIXELS | FATBITS_MIN_HEIGHT, 1 };
}


@object FatbitsClass MyFatbits = {
    FBI_imageObj = @LivePreviewContent;
}


@object GenInteractionClass FatBitsInfoTextGroup = {
    GI_comp = @FatBitsMouseText, @FatBitsInfoText;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
}

@object GenTextClass FatBitsMouseText = {
    GI_attrs = @default | GA_READ_ONLY;
    HINT_TEXT_FRAME;
    HINT_FIXED_SIZE = { SST_AVG_CHAR_WIDTHS | 9, SST_LINES_OF_TEXT | 1, 1 };
    ATTR_GEN_TEXT_DEFAULT_PARA_ATTR = (J_CENTER << VTDPA_JUSTIFICATION_OFFSET);
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}

@object GenTextClass FatBitsInfoText = {
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    GI_attrs = @default | GA_READ_ONLY;
    ATTR_GEN_TEXT_NEVER_MAKE_SCROLLABLE;
}

/* -------- The LivePreviewView displays the current in original size ---------- */

@object GenInteractionClass LivePreviewGroup = {
    GI_visMoniker = "Live Preview";
    HINT_PLACE_MONIKER_ABOVE;
    HINT_CENTER_MONIKER;
    GI_comp = @LivePreviewView;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_FIXED_SIZE = { SST_PIXELS | LIVE_PREVIEW_WIDTH,
			SST_PIXELS | LIVE_PREVIEW_HEIGHT, 1};
    HINT_CENTER_CHILDREN_HORIZONTALLY;
}



@object GenViewClass LivePreviewView = {
    GVI_horizAttrs = @default | GVDA_NO_LARGER_THAN_CONTENT | GVDA_SCROLLABLE;
    GVI_vertAttrs =  @default | GVDA_NO_LARGER_THAN_CONTENT | GVDA_SCROLLABLE;
    GVI_content = @LivePreviewContent;
    HINT_VIEW_REMOVE_SCROLLERS_WHEN_NOT_SCROLLABLE;
}

@object OtherContentClass LivePreviewContent = {
    OCI_type = OC_TYPE_BITMAP;
    OCI_margin = LIVE_PREVIEW_MARGIN;
}



/* -------- The IconListView displays the IconList ---------- */

@object GenViewClass IconListView = {
    GVI_content = @IconListContent;
    GVI_horizAttrs = @default | GVDA_SCROLLABLE;
    GVI_vertAttrs = @default | GVDA_SCROLLABLE;
    HINT_VIEW_REMOVE_SCROLLERS_WHEN_NOT_SCROLLABLE;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_MINIMUM_SIZE = { SST_PIXELS | ICON_LIST_WIDTH, SST_PIXELS | ICON_LIST_HEIGHT, 1};
}

@object IconViewerClass IconListContent = {
    VCNI_attrs = @default | VCNA_SAME_WIDTH_AS_VIEW;
    VCI_geoAttrs = VCGA_ALLOW_CHILDREN_TO_WRAP;
}

@end DisplayUI;

/*
 * UI template block for the tools
 * Note: The block mus be in the same code file as the monikers because the
 * monikers are used twice.
 */
@start IconBitmapControlToolUI, notDetachable;

@object GenItemGroupClass BitmapToolChooser = {
   GI_states = @default & ~GS_USABLE;
   GIGI_selection = BTF_INITIAL_TOOL;
   GI_comp = @BitmapSelectionToolItem, @BitmapPencilToolItem,
	@BitmapEraserToolItem, @BitmapLineToolItem,
	@BitmapFillRectToolItem, @BitmapRectangleToolItem,
	@BitmapFillEllipseToolItem, @BitmapEllipseToolItem,
	@BitmapFloodFillToolItem, @BitmapFillMaskToolItem,
	@BitmapEditMaskToolItem
@if @SHIFT_IMAGE_IS_A_BITMAP_TOOL
	,  @BitmapShiftToolItem
@endif
	;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_TOOLBOX;
    @SetItemGroupDestination_TO_BITMAP;
    GIGI_applyMsg = MSG_FATBITS_SET_BITMAP_TOOL;
}

