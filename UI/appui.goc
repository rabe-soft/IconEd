/*  Standard include files */
@include <stdapp.goh>
@include <objects/gViewCC.goh>
@include <bmptools.goh>

@include "iconed.goh"
@include "Main/iconConstants.h"

/*---------------------------------------------------------------------------
 Resource AppResource
 ---------------------------------------------------------------------------*/
@start AppResource;

@object IconApplicationClass IconApp = {
    GI_visMoniker = list { @AppVGAMoniker, @AppVGAMonoMoniker, @AppCGAMoniker,
			   @AppToolCMoniker, @AppToolMonoMoniker, @AppToolCGAMoniker,
			   @IconTextMoniker };

    GI_comp = @IconPrimary;

	gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_WINDOWS) =
		@IconPrimary;
	gcnList(MANUFACTURER_ID_GEOWORKS,MGCNLT_APP_STARTUP) =
		@IconDocumentControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,MGCNLT_ACTIVE_LIST) =
		@IconDocumentControl,
		@IconDisplayControl,
		@IconToolControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_STARTUP_LOAD_OPTIONS) =
		@IconToolControl;
	gcnList(MANUFACTURER_ID_GEOWORKS,GAGCNLT_SELF_LOAD_OPTIONS) =
		@IconDocumentControl,
		@IconDisplayControl,
		@IconToolControl,
		@IconBitmapToolControl,
		@IconImportControl,
		@IconExportControl,
		@IconAreaColorSelector,
		@IconLineColorSelector,
		@IconLineAttrControl,

		@ToolOnlyEditControl,
		@Spacer1Control,
		@Spacer2Control,
		@Spacer3Control,
		@Spacer4Control,
		@Spacer5Control,
		@Spacer6Control;

	gcnList(MANUFACTURER_ID_GEOWORKS, GAGCNLT_APP_TARGET_NOTIFY_GROBJ_LINE_ATTR_CHANGE) = @IconLineAttrControl;


	ATTR_GEN_INIT_FILE_CATEGORY = IE_INI_CATEGORY;
	/*ATTR_GEN_HELP_FILE = "iconed Help";*/
        }        /* end of IconApp */


@end AppResource;


/*---------------------------------------------------------------------------
 Resource definition MonikerResource
 ---------------------------------------------------------------------------*/
@start MonikerResource, data;

@include "Art/AppIcons.goh"
@include "Art/DocIcons.goh"

/* This list only contains the document monikers */
@visMoniker IconDocMonikerList = list { @DocVGAMoniker, @DocVGAMonoMoniker, @DocCGAMoniker,
					@DocVGAToolMoniker, @DocVGAToolMonoMoniker, @DocCGAToolMoniker};

/* A second list contains the application monikers - used to update older AppTokens*/
@visMoniker IconAppMonikerList = list { @AppVGAMoniker, @AppVGAMonoMoniker, @AppCGAMoniker,
					@AppToolCMoniker, @AppToolMonoMoniker, @AppToolCGAMoniker,
					@IconTextMoniker };
@visMoniker IconTextMoniker = "Icon Editor";

@end MonikerResource;

/*---------------------------------------------------------------------------
 Resource definition GraphicResource
 ---------------------------------------------------------------------------*/
@start GraphicResource, data;

@include "Art/drawposcorners.goh"	/* Monikers for DrawPostion while import / paste */
@include "Art/colortools.goh"		/* Toolbar moniker for LineColor and Areacolor */
@include "Art/warning.goh"		/* Warning sign */

@include "Art/bitmaptools.goh"		/* Moniker for bitmap tools (toolbar and dialog)
 					 * Note: the monikers and both objects, that uses the
 					 * monikers, must be in the same code file or the
 					 * Resource Editor messes up (02/2026 - R.B. µµ */
@end GraphicResource;


/*---------------------------------------------------------------------------
 Resource Interface
 ---------------------------------------------------------------------------*/

@start Interface;

/* ----------------- Primary  ------------------------------*/

@object GenPrimaryClass IconPrimary = {
	GI_comp = @IconFileMenu, @IconEditMenu, @ISetMenu, @IconMenu,
			@IconOptionsMenu, @IconGraphicsMenu,
			@IconWindowMenu, @IconExtrasMenu, @TopToolbar,
			@IconMainGroup, @BottomToolbar,
			@IconDialogs;

	HINT_PRIMARY_FULL_SCREEN;
	/* HINT_SIZE_WINDOW_AS_DESIRED; */
	HINT_ORIENT_CHILDREN_VERTICALLY;
/*	ATTR_GEN_HELP_CONTEXT = "TOC"; */
	}

@object GenInteractionClass IconMainGroup = {
    GI_comp = @LeftToolbar, @IconDisplayGroup, @RightToolbar
@if @DEBUG_FLAG
		, @IconDebugGroup
@endif
;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;

}

@object GenInteractionClass IconDialogs = {
	GI_comp = @AddISetDialog,	@RenameISetDialog,
	          @WriteSourceDialog,	@IconPreviewDialog,
	          @WriteToVMFileDialog,
@if @ENABLE_CONTEXT_MENU
@ISetContextMenu,
@endif
	          @IconQuickHelpDialog,
	          @RenameIconDialog, 	@AddIconDialog,
	          @ImportGraphicDialog, @GStringToBitmapDialog,
	          @IconCustomColorDialog, @ReplacedColorDialog,
	          @AllowOversizeWarningBox,
	          @IconTooLargeErrorBox, @IconTooLargeWarningBox,
	          @EditMaskControlBox, 	@ShiftImageControlBox,
	          @SelectionToolControlBox, @ImportTokenDialog,
@if @DEBUG_EXPORT_TOKENS
	@ExpTokenTestDialog,
@endif

	          @ExportTokenDialog,	@ChangeIconAttributesDialog;
}

@if @DEBUG_FLAG
@object GenInteractionClass IconDebugGroup = {
    GI_comp = @IconDebugText, @IconDebugTestTrigger, @TestValue;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    }

@object GenTextClass IconDebugText = {
	HINT_INITIAL_SIZE = { 30 | SST_AVG_CHAR_WIDTHS, 30 | SST_LINES_OF_TEXT, 20};
	HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
	GTXI_attrs = @default | GTA_INIT_SCROLLING;
}
@object GenTriggerClass IconDebugTestTrigger = {
	GI_visMoniker = "Test";
	GTI_actionMsg = MSG_ICON_TEST;
	GTI_destination = process;
}

@object GenValueClass TestValue = {
    GI_visMoniker = "Test-ID:";
    GVLI_destination = @IconApp;
    GVLI_applyMsg = MSG_ICON_APP_EXP_TOKEN_ID_CHANGED;
    ATTR_GEN_VALUE_STATUS_MSG = MSG_ICON_APP_EXP_TOKEN_ID_CHANGED;
}
@endif

@if @DEBUG_EXPORT_TOKENS
@object GenInteractionClass ExpTokenTestDialog = {
    GI_visMoniker = "Export Test Dialog";
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    /*GII_attrs = @default |  GIA_NOT_USER_INITIATABLE; */
    /*HINT_INTERACTION_MAKE_RESIZABLE;*/
    HINT_POSITION_WINDOW_AT_MOUSE;
    GI_comp = @ExpTokenTestView;
}
@object GenInteractionClass ExpTokenTestView = {
	HINT_FIXED_SIZE = {SST_PIXELS | 640, SST_PIXELS | 120, 1};
}
@endif



/*---------------------------------------------------------------------------
	Display-Group and Tool bars
 ---------------------------------------------------------------------------*/
@object GenDisplayGroupClass IconDisplayGroup = {

    /*
     * This startup size would fit an 48x30 icon with pixel size 8 and a
     * 800x600 screen.
     * To make this work you must also replace HINT_PRIMARY_FULL_SCREEN by
     * HINT_SIZE_WINDOW_AS_DESIRED in the primary object.
     * /
    HINT_INITIAL_SIZE = { SST_PIXELS | (VIEWER_VIEW_FIXED_WIDTH + 384 + 80),
	(240 + 20 + 2*ICON_LIST_HEIGHT) | SST_PIXELS,0  };
/**/
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;


    /*	Focus und Target vom Primary holen, so da· die Displays/Documente
	ebenfalls sofort den Focus und Target haben kînnen */
    HINT_DEFAULT_FOCUS;
    HINT_DEFAULT_TARGET;
}

/*
 * Additional toolbars
 */
@object GenInteractionClass LeftToolbar = {
    HINT_TOOLBOX;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}

@object GenInteractionClass RightToolbar = {
    HINT_TOOLBOX;
    HINT_EXPAND_HEIGHT_TO_FIT_PARENT;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_VERTICALLY;
}

@object GenInteractionClass TopToolbar = {
@if @USE_TWO_TOP_TOOL_BARS
    GI_comp = @TopLeftToolbar, @TopRightToolbar;
@elseif
    GI_comp = @IconFileTools, @IconEditTools,
    		@IconLineAttrTools, @IconLineColorTools,
    		@IconAreaColorTools, @IconBitmapEditTools;
@endif
    HINT_TOOLBOX;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_FULL_JUSTIFY_CHILDREN_HORIZONTALLY;
}

@if @USE_TWO_TOP_TOOL_BARS
	/*
	 * We have two top toolbars, one on the left and one on the right
	 */
@object GenInteractionClass TopLeftToolbar = {
    GI_comp = @IconFileTools, @Spacer1ToolGroup, @Spacer2ToolGroup, @IconEditTools;
    HINT_TOOLBOX;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_LEFT_JUSTIFY_CHILDREN;
}

@object GenInteractionClass TopRightToolbar = {
    GI_comp =  @Spacer3ToolGroup,@IconLineAttrTools,
    		@IconLineColorTools, @Spacer4ToolGroup,
    		@IconAreaColorTools, @Spacer5ToolGroup, @Spacer6ToolGroup,
              @IconBitmapEditTools;
    HINT_TOOLBOX;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
    HINT_RIGHT_JUSTIFY_CHILDREN;
}
@endif

@object GenInteractionClass BottomToolbar = {
    HINT_TOOLBOX;
    HINT_EXPAND_WIDTH_TO_FIT_PARENT;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}

@object GenInteractionClass FloatingToolbox = {
    GI_visMoniker = 'T', "Floating Toolbox";
    GII_visibility = GIV_DIALOG;
    GII_type = GIT_COMMAND;
    HINT_ALLOW_CHILDREN_TO_WRAP;
    HINT_INTERACTION_MAKE_RESIZABLE;
    HINT_ORIENT_CHILDREN_HORIZONTALLY;
}

@end Interface; /*-------------------------------------------------------*/


/*---------------------------------------------------------------------------
 Resourcendefinition MenuResource
 enthÑlt die MenÅs und wenig gebrauchte Dialogboxen
 ---------------------------------------------------------------------------*/
@start MenuResource;

@object GenInteractionClass IconFileMenu = {
    ATTR_GEN_INTERACTION_GROUP_TYPE = GIGT_FILE_MENU;
    GI_comp = @IconAboutBox,
		@IconDocumentControlGroup,
		@IconTopImpexGroup;
    GII_visibility = GIV_POPUP;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    }

@object GenInteractionClass IconTopImpexGroup = {
    /*
     * The IconTopImpexGroup is placed in the document control's
     * enableDisable list, so is gets enabled if a document is open.
     * But the objects in the ImpexSubGroup's are managed by EnableEditing()
     * and DisableEditing(). This avoids problems when we open a document
     * that has no icon sets.
     */
    GI_comp = @IconImportControl,
		@IconExportControl,
		@IconImpexSubGroup,
		@ISetImpexSubGroup;
    GI_states = @default & ~GS_ENABLED;
}

@object GenInteractionClass IconAboutBox = {
	GI_visMoniker = 0, "(Information)";
	GI_comp = @AboutGlyph1,@AboutGlyph2,@AboutGlyph3,@AboutGlyph4,
		@AboutGlyph5;
	HINT_CENTER_CHILDREN_HORIZONTALLY;
	GII_visibility = GIV_DIALOG;
	GII_type = GIT_NOTIFICATION;
	}
@object GenGlyphClass AboutGlyph1 = {
	GI_visMoniker = "Icon Editor";
	}
@object GenGlyphClass AboutGlyph2 = {
	GI_visMoniker = "";
	}
@object GenGlyphClass AboutGlyph3 = {
	GI_visMoniker = "(version = release)";
	}
@object GenGlyphClass AboutGlyph4 = {
	GI_visMoniker = "GOC version by ";
	}
@object GenGlyphClass AboutGlyph5 = {
	GI_visMoniker = " Rainer Bettsteller, Magdeburg ";
	}

