/*-----------------------------------------------------------------------------
		Line Controller & Tools
 -----------------------------------------------------------------------------*/

@object GenInteractionClass IconLineAttrDialog = {
	GII_visibility = GIV_DIALOG;
	GII_type = GIT_PROPERTIES;
	GI_visMoniker = 'L', "Line Attributes";
	GI_comp = @IconLineColorSelector,
		@IconLineAttrControl;
}

@object GrObjLineColorSelectorClass IconLineColorSelector = {
    	/* Note: CSF_INDEX and CSTF_INDEX are prohibit, because they cannot handle
    	 * custom palettes. LineColorToolIndexGroup and LineColorGroup are added
    	 * instead. The drawback is, that they no longer have an entry in the
    	 * customize toolbar dialog box.
    	 * Note 2: CSTF_PATTERN seems to be currently unsupported by the system
    	 */
    ATTR_GEN_CONTROL_PROHIBIT_UI = CSF_INDEX | CSF_FILLED_LIST  | CSF_OTHER;
    ATTR_GEN_CONTROL_PROHIBIT_TOOLBOX_UI = CSTF_INDEX | CSTF_PATTERN;
    ATTR_GEN_CONTROL_APP_TOOLBOX_UI = @LineColorToolIndexGroup;
    ATTR_GEN_CONTROL_APP_UI = @LineColorGroup;
    @SetControllerDestination_TO_BITMAP;
}

@object GrObjLineAttrControlClass IconLineAttrControl = {
    ATTR_GEN_CONTROL_PROHIBIT_UI = /* GOLACF_STYLE  |*/ GOLACF_ARROWHEAD_TYPE | GOLACF_ARROWHEAD_WHICH_END;
    ATTR_GEN_CONTROL_REQUIRE_TOOLBOX_UI = GOLACTF_STYLE;
    @SetControllerDestination_TO_BITMAP;
}


@object GenToolGroupClass IconLineColorTools = {	/* in tool bar and ToolGroupList */
    GI_states = @default |  GS_USABLE | GS_ENABLED;
    GTGI_controller = @IconLineColorSelector;
    HINT_SAME_ORIENTATION_AS_PARENT;
    HINT_MINIMIZE_CHILD_SPACING;
}

@object GenToolGroupClass IconLineAttrTools = {	/* in tool bar and ToolGroupList */
