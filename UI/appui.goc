    GI_visMoniker = 'G', "Graphics";
    GI_comp = @IconLineAttrDialog,
	@IconAreaAttrDialog,	@BitmapToolbox,
	@FloatingToolbox, 	@IconGraphicsMenuSubGroup,

	/* invisble controllers */
