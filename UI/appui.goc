/*-----------------------------------------------------------------------------
	ISetMenu - deals with the currently edited set of icns
-----------------------------------------------------------------------------*/

@object GenInteractionClass ISetMenu = {
    GII_visibility = GIV_POPUP;
    GI_visMoniker = 'S', "Icon Set";
    GI_states = @default & ~GS_ENABLED;
    GI_comp = @AddISetTrigger, @ISetMenuSubGroup;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    	/*
    	 * If there is no icon set in the icon database, all parts of the
    	 * ISetMenu must be disabled, except for the AddISet trigger.
    	 * Therefore, we use a subgroup that can be disabled in this case.
    	 */
}

@object GenInteractionClass ISetMenuSubGroup = {
    GI_comp = 	  @DuplicateISetTrigger,
	  @DeleteISetTrigger,
	  @ISetMenuInnerGroup,
	  @WriteSourceTrigger;
    HINT_SAME_CATEGORY_AS_PARENT;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}
@object GenInteractionClass ISetMenuInnerGroup = {
    GI_comp = @RenameISetTrigger;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
}


@object GenTriggerClass AddISetTrigger = {
    GI_visMoniker = 'A', "Add Set";
    GTI_actionMsg = MSG_DB_VIEWER_ADD_ISET;
    @SetTriggerDestination_TO_DB_VIEWER;
    HINT_TRIGGER_BRINGS_UP_WINDOW;
}

@object GenTriggerClass DuplicateISetTrigger = {
    GI_visMoniker = 'D', "Duplicate Set";
    GTI_actionMsg = MSG_DB_VIEWER_DUPLICATE_ISET;
    @SetTriggerDestination_TO_DB_VIEWER;
}

@object GenTriggerClass DeleteISetTrigger = {
    GI_visMoniker = 'e', "Delete Set";
    GTI_actionMsg = MSG_DB_VIEWER_DELETE_CURRENT_ISET;
    ATTR_GEN_TRIGGER_ACTION_DATA = TRUE;	/* confirm delete */
    @SetTriggerDestination_TO_DB_VIEWER;
}


@object GenTriggerClass RenameISetTrigger = {
    GI_visMoniker = 'R', "Rename Set";
    GTI_actionMsg = MSG_DB_VIEWER_RENAME_ISET;
    @SetTriggerDestination_TO_DB_VIEWER;
    HINT_TRIGGER_BRINGS_UP_WINDOW;
    GI_attrs = @default | GA_KBD_SEARCH_PATH;
    GI_kbdAccelerator = @specificUI F2;
}


@object GenTriggerClass WriteSourceTrigger = {
    GI_visMoniker = 'W', "Write Source Code";
    GTI_actionMsg = MSG_ICON_DO_WRITE_SOURCE_DIALOG;
    GTI_destination = process;
