    GI_visMoniker = 'C',"Cancel";
    GTI_actionMsg = MSG_DB_VIEWER_CHANGE_ICON_PROPERTIES;
    ATTR_GEN_TRIGGER_ACTION_DATA = FALSE;
    @SetTriggerDestination_TO_DB_VIEWER;
    }



@end DialogResource5;


/*---------------------------------------------------------------------------

 Resourcendefinition TokenImportDialogResource

 	Because DynamicList objects create its children (Moniker items in our case)
 	in the same resource as they are, the resource may grow large.
 	Therefore we pslce the dialog in tis owen resource.

 ---------------------------------------------------------------------------*/

@start TokenImportDialogResource;

/*---------------------------------------------------------------------------

 	Import from token database dialog

 ---------------------------------------------------------------------------*/

@object GenInteractionClass ImportTokenDialog = {
    GI_visMoniker = "Import Token";
    GII_visibility = GIV_DIALOG;
    GII_attrs = @default |  GIA_NOT_USER_INITIATABLE | GIA_MODAL
		| GIA_INITIATED_VIA_USER_DO_DIALOG;
    GI_comp =
@if @DEBUG_IMPORT_TOKENS
    	@ImpTokenTestView,
@endif
    	@ImpTokenTokenListGroup, @ImpTokenReplyBar;
    HINT_ORIENT_CHILDREN_VERTICALLY;
    HINT_POSITION_WINDOW_AT_RATIO_OF_PARENT = {  SWSS_RATIO | PCT_15, SWSS_RATIO | PCT_10 };
}

@if @DEBUG_IMPORT_TOKENS
@object GenInteractionClass ImpTokenTestView = {
	HINT_FIXED_SIZE = {SST_PIXELS | 640, SST_PIXELS | 120, 1};
}
@endif

    @object GenInteractionClass ImpTokenTokenListGroup = {
   	GI_visMoniker = 'T', " Select a Token to Import ";
	HINT_CENTER_MONIKER;
	HINT_PLACE_MONIKER_ABOVE;
    	GI_comp = @ImpTokenTokenList /* µµ ~TestGroup*/, @ImpTokenTokenInfoGroup,
    		@ImpTokenIconListGroup,
@if @DEBUG_FLAG
		@ImpTokenDebugText,
@endif
