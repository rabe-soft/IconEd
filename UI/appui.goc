    GI_visMoniker = 'M', "More Colors";
    HINT_TRIGGER_BRINGS_UP_WINDOW;
    GTI_destination = process;
    GTI_actionMsg = MSG_ICON_OPEN_CUSTOM_COLORS_DIALOG;
    ATTR_GEN_TRIGGER_ACTION_DATA = TRUE;
}

