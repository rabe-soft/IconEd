extern GlobalStruct global;


/*############################################################################
 * Low level routines for working with bitmaps
 *############################################################################*/

/*--------------------- CreateBitmapDataOnly ---------------------
 *  Purpose:	Create  masked bitmap and clear it out.
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
VMBlockHandle CreateBitmapDataOnly(VMFileHandle vmFile, BMFormat bmf, int width, int height, PaletteEntry *palette) {
VMBlockHandle bmp;

    bmp = ToolCreateBitmap(vmFile, bmf | BMT_MASK, width, height, palette, TRUE);
    return bmp;
}


/*--------------------- ToolCreateBitmap ---------------------
 *  Purpose:	This is the central routine to create a bitmap.
 *		Use ToolDestroyBitmap to destroy the bitmap.
 *  Context:
 *  Strategy:	For now, we use BTCreateOffscreenBitmap from bmptools library,
 *		but we may decide to use GrCreateBitmap later.
 *		Update ToolDestroyBitmap if we do so!
 *  Parameters:	vmFile,
 		bmfmt  bitmap format for the new bitmap
 		width, height: size of the bitmap
 		clear:	Clear bitmap data
 *  Return:	Handle od the bitmap
 ---------------------------------------------------------------------------*/
VMBlockHandle ToolCreateBitmap(VMFileHandle vmFile, BMFormat bmfmt, int width, int height, PaletteEntry *palette, Boolean clear) {
VMBlockHandle bmp;
BitmapAccessRecord	bar;
byte	*data;
int  line, numBytes, maskBytes;


    bmp = BTCreateOffscreenBitmap(vmFile, bmfmt, width, height, palette);

    if (clear) {

    	// The byte-size of a bitmap line depends on the bitmap format
        switch (bmfmt & BMT_FORMAT) {
	case BMF_MONO:
	    numBytes = (width+7)/8;
	    break;
    	case BMF_4BIT:
	    numBytes = (width+1)/2;
	    break;
        case BMF_8BIT:
	    numBytes = width;
	    break;
    	default: 	// 24 Bit
	    numBytes = 3*width;
	}

        if ( bmfmt & BMT_MASK) maskBytes = (width+7)/8;

	/*
	 * To be comaptible with the old IconEditor, we have
	 * to set the mask to zero and the data bits to “white”.
	 * A different color would also be cool, but could confuse the user.
	 */
	data = BTBitmapLock(vmFile, bmp, &bar, 0);	// lock first line
    	for (line = 0; line < height; line++ ) {
    	    if ( maskBytes ) {
    	    	memset(data, 0, maskBytes);
    	    	data += maskBytes;
    	    	}
    	    if ( (bmfmt & BMT_FORMAT) == BMF_MONO) {memset(data, 0x00, numBytes);}
	  	else { memset(data, 0xFF, numBytes); }
	    data = BTBitmapNext(&bar, TRUE);		// fast lock next line
	    if (!data) break;
	    }
	BTBitmapUnlock(&bar, TRUE);			// unlock all
    }

    return bmp;
}


/*--------------------- ToolDestroyBitmap ---------------------
 *  Purpose:	Destroys a bitmap created with ToolCreateBitmap
 *  Context:
 *  Strategy:	Because we have used BTCreateOffscreenBitmap to create
 *		the bitmap, we must use HugeArrayDestroy to destroy it.
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void ToolDestroyBitmap(VMFileHandle vmFile, VMBlockHandle bmp) {

// µµ evtls überflüssig, wenn alle Bitmaps mit HugeArrayDestroy vernichtbar sind
// Das geht nur nicht wenn man GrCraeteBitmap verwendet hat - oder evtl. eine CREATE_BITMAP_MSG von VisBitmap-obj

    HugeArrayDestroy(vmFile, bmp);
}

/*############################################################################
 * Create and destroy icons or icon sets
 *############################################################################*/

/*--------------------- CreateNewFileISet ---------------------
 *  Purpose:	Create a new icon set with some icons
 *  Context:	Initialize document file or Create an new file icon
 *  Strategy:
 	- iconFormats is a bit field. This means that each bit represents a
 	  specific icon (size, colors...), described by a IP_xx constant.
 	  If a specific bit is set, this icon must be created, otherwise not.
	- We count the set bits and create an empty icon set
	- Then we initialize each icon, again using the bits that are set
	- Example: IP_STANDARD_VGA_FILE has the value 0x20. If this bit is
	  set, we create a standard VGA icon (48x30).
 *  Parameters:	vmFile:	Database file
 *		iconFormats: 	icons to create (IconParameters bit flags)
 *  Return:	Index of the new icon set
 ---------------------------------------------------------------------------*/
int CreateNewFileISet(VMFileHandle vmFile, word iconFormats) {
int 	iSet, numIcons, n, icon;
word	mask;

	/*
	 * Check if there is at least one icon passed. If not, bail.
	 */
    if ( iconFormats == 0) {
    	MessageBoxOptr(@AtLeastOneIcon);
    	iSet = IdGetISetCount(vmFile);
    	return iSet - 1;	// note that NOC_CURRENT_ISET is defined as -1
    }

	/*
	 * Count the icons to create - that is: count the set bits
	 */
    mask = 1;
    numIcons = 0;
    for ( n = 0; n < 16; n++ ) {
	if ( iconFormats & mask ) numIcons++;
	mask <<= 1;
    }

	/*
	 * Create the new icon set with numIcons icons
	 */
    iSet = IdAddISet(vmFile, numIcons);
    IdSetEntryCount(vmFile, iSet , numIcons);

	/*
	 * Initialize the icons. Every bit which is set in iconFormats
	 * represents a icon to create.
	 * iconFormats & mask is always equal to one of the IP_xx constants
	 */
    mask = 1;
    icon = 0;
    for ( n = 0; n < 16; n++ ) {
	if ( iconFormats & mask ) {
	    InitializeIcon(vmFile, iSet, icon, iconFormats & mask/*,  colorScheme*/);
	    AssignInitialIconName(vmFile, iSet, icon, iconFormats & mask, TRUE);
	    icon++;
	}
	mask <<= 1;
    }


    return iSet;
}


/*--------------------- InitializeIcon ---------------------
 *  Purpose:	Setup an icon to default values
 *  Context:	Create new icon set
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet	which icon set
 *		icon	which icon for that icon set
 *		params	icon description value
 *		colorScheme	Color depth, if the icon is colored
 *				pass BMF_4BIT, BMF_8BIT or BMF_24BIT
 *  Return:
 ---------------------------------------------------------------------------*/
void InitializeIcon(VMFileHandle vmFile, int iSet, int icon, IconParameters params) {
VMBlockHandle 	bmp;
int	width, height;
BMFormat	bmfmt;


    /*
     * Set up icon parameters and bitmap
     * IdGetIconExtraBlock ensures that an initialized extra block (IE_extraBlock) exists
     */
    ToolFindBitmapAndScreenParameters(params, &width, &height, &bmfmt, NULL, NULL);
    bmfmt |= BMT_MASK;

    bmp = CreateBitmapDataOnly(vmFile, bmfmt, width, height, NULL);
    IdSetEntryBitmapNoCopy(vmFile, iSet, icon, bmp);
    IdSetEntryParameters(vmFile, iSet, icon, params);

    IdGetIconExtraBlock(vmFile, iSet, icon);
}

/*--------------------- AssignInitialIconName ---------------------
 *  Purpose:	Set the default Name for a new icon
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet	which icon set
 *		icon	which icon for that icon set
 *		params	icon description value
 *		useFileIconPrefix: Write the text in FileIconPrefixText in front of the icon name.
 *  Return:
 ---------------------------------------------------------------------------*/
void AssignInitialIconName(VMFileHandle vmFile, int iSet, int icon, IconParameters params, Boolean useFileIconPrefix) {
optr defaultNameOp;
char iconName[MAX_ICON_NAME_LENGTH + 10]; // be save

    /*
     * Get the Prefix for the icon name
     */
    if ( useFileIconPrefix ) {
    	@call FileIconPrefixText::MSG_VIS_TEXT_GET_ALL_PTR(iconName);
    } else {
    	iconName[0] = 0;
    }

    /*
     * Add the default name body to the iconName
     */
    defaultNameOp = GetEntryDefaultNameOptr(params);
    MemLock(OptrToHandle(defaultNameOp));
    strcat(iconName, LMemDeref(defaultNameOp));
    MemUnlock(OptrToHandle(defaultNameOp));

    /*
     * Finally set the initial name for the icon
     */
    IdSetEntryName(vmFile, iSet, icon, iconName);

}

/*--------------------- AssignInitialCustomIconName ---------------------
 *  Purpose:	Set the default Name for a custom icon
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet	which icon set
 *		icon	which icon for that icon set
 *		style	icon style: VMS_TOOL | VMS_ICON
 *		BMFormat bitmapformat
 *  Return:
 ---------------------------------------------------------------------------*/
void AssignInitialCustomIconName(VMFileHandle vmFile, int iSet, int icon, int style, int BMFormat) {
optr defaultNameOp = 0;

    if ( style ==  VMS_TOOL ) 	defaultNameOp = (BMFormat == BMF_MONO) ? @DefaultNameCustomToolMono  : @DefaultNameCustomTool;
        		else 	defaultNameOp = (BMFormat == BMF_MONO) ? @DefaultNameCustomIconMono : @DefaultNameCustomIcon;
    MemLock(OptrToHandle(defaultNameOp));
    IdSetEntryName(vmFile, iSet, icon, LMemDeref(defaultNameOp));
    MemUnlock(OptrToHandle(defaultNameOp));
}



/*--------------------- ToolFindBitmapAndScreenParameters ---------------------
 *  Purpose:	Transform IconParameters (IP_xxx) constant into the
 		corresponding width, height and bitmap colors values
 		as well as the corresponding display values
 *  Context:
 *  Strategy:
 *  Parameters:	params	an IP_xxx constant
 			describes - size of the icon
 				  - number of colors
 				  - display size
 				  - aspect ratio
 		*widthPtr,
 		*heightPtr,
 		*bmFormatPtr,
 		*displaySizePtr,
 		*aspectPtr:	pointers to return values
 				Note that BMT_MASK is not set in *bmFormatPtr
 				NULL pointers are allowed
 *  Return:	-
 ---------------------------------------------------------------------------*/
void ToolFindBitmapAndScreenParameters(IconParameters params,
			int *widthPtr, int *heightPtr, BMFormat *bmFormatPtr,
			int *displaySizePtr, int *aspectPtr) {
BMFormat bmfmt;
int width, height;
int aspect = DAR_NORMAL;
int displaySize = DS_STANDARD;

    switch (params) {
    case IP_STANDARD_SVGA_FILE_256:
    	width = 64;	height = 40;
    	bmfmt = BMF_8BIT;
    	displaySize = DS_LARGE;
    	break;
    case IP_STANDARD_SVGA_FILE:
    	width = 64;	height = 40;
    	bmfmt = BMF_4BIT;
    	displaySize = DS_LARGE;
    	break;
    case IP_STANDARD_SVGA_FILE_MONO:
    	width = 64;	height = 40;
    	bmfmt = BMF_MONO;
    	displaySize = DS_LARGE;
    	break;

    case IP_CGA_PREF_MODULE:
    	width = 64;	height = 18;
    	bmfmt = BMF_MONO;
    	displaySize = DS_STANDARD;
    	aspect = DAR_VERY_SQUISHED;
    	break;


    case IP_STANDARD_VGA_FILE_256:
    	width = 48;	height = 30;
    	bmfmt = BMF_8BIT;
    	break;
    case IP_STANDARD_VGA_FILE:
    	width = 48;	height = 30;
    	bmfmt = BMF_4BIT;
    	break;
    case IP_STANDARD_MCGA_FILE:
    	width = 48;	height = 30;
    	bmfmt = BMF_MONO;
    	break;
    case IP_STANDARD_CGA_FILE:
    	width = 48;	height = 14;
    	bmfmt = BMF_MONO;
    	aspect = DAR_VERY_SQUISHED;
    	break;

    case IP_TINY_COLOR_FILE_256:
    	width = 32;	height = 20;
    	bmfmt = BMF_8BIT;
    	displaySize = DS_TINY;
    	break;
    case IP_TINY_COLOR_FILE:
    	width = 32;	height = 20;
    	bmfmt = BMF_4BIT;
    	displaySize = DS_TINY;
    	break;
    case IP_TINY_MONO_FILE:
    	width = 32;	height = 20;
    	bmfmt = BMF_MONO;
    	displaySize = DS_TINY;
    	break;


    case IP_STANDARD_CGA_TOOL:
    	width = 15;	height = 10;
    	bmfmt = BMF_MONO;
    	aspect = DAR_VERY_SQUISHED;
    	break;

    case IP_TINY_COLOR_TOOL_256:
    	bmfmt = BMF_8BIT;
    	width = 15;	height = 15;
    	displaySize = DS_TINY;
    	break;
    case IP_TINY_COLOR_TOOL:
    	bmfmt = BMF_4BIT;
    	width = 15;	height = 15;
    	displaySize = DS_TINY;
    	break;
    case IP_TINY_MONO_TOOL:
    	width = 15;	height = 15;
    	bmfmt = BMF_MONO;
    	displaySize = DS_TINY;
    	break;

    case IP_PTR_IMAGE:
    	width = 16;	height = 16;
    	bmfmt = BMF_4BIT;
DebugInfo("\rIP_PTR_IMAGE: use 4 Bit - ok?");
    	break;

    default:
    	width = 30;	height = 30;
    	bmfmt = BMF_4BIT;
    EC ( ProgError("ToolFindBitmapAndScreenParameters: invalid params"); )
    }

    if (widthPtr) *widthPtr	= width;
    if (heightPtr) *heightPtr	= height;
    if (bmFormatPtr) *bmFormatPtr = bmfmt;
    if (aspectPtr) *aspectPtr	= aspect;
    if (displaySizePtr) *displaySizePtr = displaySize;

}

/*--------------------- InternalInitializeIconEntryType ---------------------
 *  Purpose:	Setup up the IE_type value for an icon with custom settings
 *  Context:	Tool for create a new icon for a set
 *  Strategy:
 *  Parameters:	vmFile:	database file
 *		iSet:	which icon set
 *		icon:	which icon for that icon set
 		stlye:	pass VMS_TOOL | VMS_ICON
 *		displayClass:	pass DC_TEXT, DC_GRAY_1, DC_COLOR_4, DC_COLOR_8, DC_CF_RGB
 		displaySize:	pass DS_TINY, DS_STANDARD, DS_LARGE ( or DS_HUGE )
 		aspect:		pass DAR_NORMAL or DAR_VERY_SQUISHED
 *  Return:
 ---------------------------------------------------------------------------*/
void InternalInitializeIconEntryType(VMFileHandle vmFile, int iSet, int icon, int style,
				int displayClass, int displaySize, int aspect) {
word	vmlet;		/* typedef WordFlags VisMonikerListEntryType; */
IconEntry *iconEntry;
optr	iEntryList;
word	size;

	/*
	 * Assign VisMonikerListEntryType
	 */
    vmlet = 0x40;	/* Set GSting Bit */
    vmlet |= displaySize   << VMLET_GS_SIZE_OFFSET;
    vmlet |= style  	  << VMLET_STYLE_OFFSET;
    vmlet |= aspect 	  << VMLET_GS_ASPECT_RATIO_OFFSET;
    vmlet |= displayClass  << VMLET_GS_COLOR_OFFSET;

 	/*
	 * Assign IE_type value
	 *
	 */
    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    iconEntry->IE_type = vmlet;
    IdUnlockEntryList(iEntryList, TRUE);

}

/*--------------------- InitializeCustomIcon ---------------------
 *  Purpose:	Setup up icon with custom settings
 *  Context:	Create a new icon for a set
 *  Strategy:
 *  Parameters:	vmFile:	database file
 *		iSet:	which icon set
 *		icon:	which icon for that icon set
 		stlye:	pass VMS_TOOL | VMS_ICON
 		width, height: 	dimensions of the icon bitmap
 *		bitmapColor:	Color depth of the bitmap
 *				pass BMF_MONO, BMF_4BIT, BMF_8BIT or BMF_24BIT
 		displaySize:	pass DS_TINY, DS_STANDARD, DS_LARGE ( or DS_HUGE )
 		aspect:		pass DAR_NORMAL or DAR_VERY_SQUISHED
 *  Return:
 ---------------------------------------------------------------------------*/
void InitializeCustomIcon(VMFileHandle vmFile, int iSet, int icon, int style,
				int width, int height, int bitmapColor,
				int displaySize, int aspect) {
VMBlockHandle	bmp;
DisplayClass	colorDC;

    /*
     * Map bitmapColor to DisplayClass value
     */
    switch (bitmapColor & BMT_FORMAT) {
    case BMF_24BIT:
    	colorDC = DC_CF_RGB;
    	break;
    case BMF_8BIT:
    	colorDC = DC_COLOR_8;
    	break;
    case BMF_4BIT:
    	colorDC = DC_COLOR_4;
    	break;
    case BMF_MONO:
    	colorDC = DC_GRAY_1;
    	break;
    default:
    	colorDC = DC_COLOR_4;
    }

    /*
     * set up IE_type value ( a VisMonikerListEntryType record)
     */
    InternalInitializeIconEntryType(vmFile, iSet, icon, style, colorDC, displaySize, aspect);

 	/*
	 * Set up bitmap
	 *
	 */
    bmp = CreateBitmapDataOnly(vmFile, bitmapColor | BMT_MASK, width, height, NULL);
    IdSetEntryBitmapNoCopy(vmFile, iSet, icon, bmp);

}


/*--------------------- FinishInitializingISet ---------------------
 *  Purpose:	Set Name and default PreviewObject and PreviewColors
 *
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void	FinishInitializingISet(VMFileHandle vmFile, int iSet, char *name) {


    IdSetISetName(vmFile, iSet, name);

// µµ - Im Origonal: Lesen der Werte von der UI statt default
//	--> Ändern falls das wirklich sinnvoll sein solte. Aktzuell glaube ich,
//		es ist eher verwirrend

    IdSetPreviewObject(vmFile, iSet, DEFAULT_PREVIEW_OBJECT);
    IdSetPreviewColors(vmFile, iSet, DEFAULT_ON_COLOR_1, DEFAULT_ON_COLOR_2, DEFAULT_OFF_COLOR_1, DEFAULT_OFF_COLOR_2);


}

/*--------------------- CreateNewToolIcon ---------------------
 *  Purpose:	Create a new tool icon set with some icons
 *  Context:	Create a new icon set
 *  Strategy:
 	- iconFormats is a bit field. This means that each bit represents a
 	  specific icon, described by a IP_xx constant.
 	  If a specific bit is set, this icon must be created, otherwise not.
	- We count the set bits and create an empty icon set
	- Then we initialize each icon, again using the bits that are set
	  For standard icon formats, we use InitializeIcon(), for custom
	  icon formats we use InitializeCustomIcon().
 *  Parameters:	vmFile:	Database file
 *  Return:	number(Index) of the new icon set
 ---------------------------------------------------------------------------*/
int CreateNewToolISet(VMFileHandle vmFile) {
int 	iSet, numIcons, n, icon;
word	mask, iconFormats;
int 	bmpColors, displaySize, aspect, width, height;

	/*
	 * Ask UI for information
	 */
    iconFormats = @call ToolIconFormatChooser1::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();
    iconFormats |= @call ToolIconFormatChooser2::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS();

	/*
	 * Check if there is at least one icon selected. If not, bail.
	 */
    if ( iconFormats == 0) {
    	MessageBoxOptr(@AtLeastOneIcon);
    	iSet = IdGetISetCount(vmFile);
    	return iSet - 1;	// note that NO_CURRENT_ISET is defined as -1
    }

	/*
	 * Count the icons to create - that is: count the set bits
	 */
    mask = 1;
    numIcons = 0;
    for ( n = 0; n < 16; n++ ) {
	if ( iconFormats & mask ) numIcons++;
	mask <<= 1;
    }

	/*
	 * Create the new icon set with numIcons icons
	 */
    iSet = IdAddISet(vmFile, numIcons);
    IdSetEntryCount(vmFile, iSet , numIcons);

	/*
	 * Initialize the icons. There are up to four "standard" icons and
	 * up to two custom icons. Every bit in iconFormats represents one of
	 * the IP_xx constants and therefore an icon to create.
	 */
    icon = 0;
    if ( iconFormats & IP_TINY_COLOR_TOOL_256 ) {
    	// InitializeCustomIcon(vmFile, iSet, icon, VMS_TOOL, 15, 15, BMF_8BIT, DS_TINY, DAR_NORMAL);
    	// µµ del it : AssignInitialCustomIconName(vmFile, iSet, icon, VMS_TOOL, BMF_8BIT);
    	InitializeIcon(vmFile, iSet, icon, IP_TINY_COLOR_TOOL_256);
    	AssignInitialIconName(vmFile, iSet, icon, IP_TINY_COLOR_TOOL_256, FALSE);
    	icon++;
    }
    if ( iconFormats & IP_TINY_COLOR_TOOL ) {
	InitializeIcon(vmFile, iSet, icon, IP_TINY_COLOR_TOOL);
    	AssignInitialIconName(vmFile, iSet, icon, IP_TINY_COLOR_TOOL, FALSE);
    	icon++;
    }
    if ( iconFormats & IP_TINY_MONO_TOOL ) {
    	InitializeIcon(vmFile, iSet, icon, IP_TINY_MONO_TOOL);
    	AssignInitialIconName(vmFile, iSet, icon, IP_TINY_MONO_TOOL, FALSE);
    	icon++;
    }
    if ( iconFormats & IP_STANDARD_CGA_TOOL ) {
    	InitializeIcon(vmFile, iSet, icon, IP_STANDARD_CGA_TOOL);
    	AssignInitialIconName(vmFile, iSet, icon, IP_STANDARD_CGA_TOOL, FALSE);
    	icon++;
    }

    /*
     * See if there is an custom tool selected.
     * If not, return
     */
    if ( 0 == (iconFormats & (IP_CUSTOM_COLOR_TOOL | IP_CUSTOM_MONO_TOOL)) ) return iSet;

    /*
     * There is an custom tool selected.
     * Get information from UI.
     */
    displaySize = @call ToolIconDisplaySizeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    aspect = @call ToolIconAspectChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    width = @call CustomToolWidthValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    height = @call CustomToolHeightValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();

    /*
     * Check icon memory size. If to large, return
     */
    bmpColors = @call CustomToolColorChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    if (CheckIconTooLargeAndDealWithIt(width, height, bmpColors | BMT_MASK) ) {
	return iSet;
    	}

    /*
     * Initialize icon(s)
     */
    if ( iconFormats & IP_CUSTOM_COLOR_TOOL ) {
    	InitializeCustomIcon(vmFile, iSet, icon, VMS_TOOL, width, height, bmpColors, displaySize, aspect);
    	AssignInitialCustomIconName(vmFile, iSet, icon, VMS_TOOL, bmpColors);
    	icon++;
    }

    if ( iconFormats & IP_CUSTOM_MONO_TOOL ) {
    	InitializeCustomIcon(vmFile, iSet, icon, VMS_TOOL, width, height, BMF_MONO, displaySize, aspect);
    	AssignInitialCustomIconName(vmFile, iSet, icon, VMS_TOOL, BMF_MONO);
    	icon++;
    }


    return iSet;
}

/*--------------------- CreateNewCustomISet ---------------------
 *  Purpose:	Create a new custom icon set with up to two icons
 *  Context:	Create a new icon set
 *  Strategy:
	- Get all relevant information from UI
	- Create a new, empty icon set.
	- Initialize the icon(s), using InitializeCustomIcon().
 *  Parameters:	vmFile:	Database file
 *  Return:	number(Index) of the new icon set
 ---------------------------------------------------------------------------*/
int CreateNewCustomISet(VMFileHandle vmFile) {
int 	iSet, numIcons, style;
int 	bmpColors, displaySize, aspect, width, height;
Boolean addMonoIcon;

    /*
     * Ask UI for information about the icon
     */
    width = @call CustomWidthValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    height = @call CustomHeightValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    bmpColors = @call CustomISetBitmapColorsChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    displaySize = @call CustomIconDisplaySizeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    aspect = @call CustomIconAspectChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    style = @call CustomIconStyleChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    addMonoIcon = @call CustomIconAddExtraMonoIcon::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() ? TRUE : FALSE;

    /*
     * Check icon memory size. If to large, return the current icon set (first icon set has number zero)
     */
    if (CheckIconTooLargeAndDealWithIt(width, height, bmpColors | BMT_MASK) ) {
    	iSet = IdGetISetCount(vmFile);
    	return iSet - 1;
    	}

    /*
     * Create the new icon set with one or two icons
     */
    numIcons = addMonoIcon ? 2 : 1;
    iSet = IdAddISet(vmFile, numIcons);
    IdSetEntryCount(vmFile, iSet , numIcons);


    /*
     * Initialize the icon(s) using InitializeCustomIcon();
     */

    InitializeCustomIcon(vmFile, iSet, 0, style, width, height, bmpColors, displaySize, aspect);
    AssignInitialCustomIconName(vmFile, iSet, 0, style, bmpColors);
    if ( addMonoIcon ) {
    	InitializeCustomIcon(vmFile, iSet, 1, style, width, height, BMF_MONO, displaySize, aspect);
    	AssignInitialCustomIconName(vmFile, iSet, 1, style, BMF_MONO);
    }

    return iSet;
}


/*--------------------- CreateNewMousePointer ---------------------
 *  Purpose:	Create a new mouse pointer image
 *  Context:
 *  Strategy:
	- Mouse pointers have a fixed size of 16x16 pixel
	- Set up an 16 color image because every pixel can be
		* transparent
		* black
		* white
		* inverse the background
	- Mark the icon set as PRT_IMAGE
 *  Parameters:	vmFile:	Database file
 *  Return:	number(Index) of the new icon set
 ---------------------------------------------------------------------------*/
int CreateNewMousePointer(VMFileHandle vmFile) {
int 	iSet;

	/*
	 * Create the new icon set with one icon
	 * Initialize the icon
	 */
    iSet = IdAddISet(vmFile, 1);
    IdSetEntryCount(vmFile, iSet , 1);
    InitializeIcon(vmFile, iSet, 0, IP_PTR_IMAGE);
    AssignInitialIconName(vmFile, iSet, 0, IP_PTR_IMAGE, FALSE);

	/*
	 * Mark the icon set as pointer image
	 */
    IdSetFlags(vmFile, iSet, IF_PTR_IMAGE);


    return iSet;
}

