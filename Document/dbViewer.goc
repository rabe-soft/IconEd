/*--------------------- MSG_DB_VIEWER_ADD_ICON ---------------------
 *  Purpose:	Add an new icon the the current icon set
 *  Context:
 *  Strategy:
 	- check if the number of icons is too large
 	- see if icon is dirty an dealt with it
 	- execute AddIconDialog
	- see if the requested size is too large
	- check the number of icon again, because we can add two icons
	- set up the database entry for the new icon(s)
	- switch editing to the first new icon
	- make the editied icon visble in the IconListView
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_ADD_ICON {
int 	iSet, numIcons, style;
int 	bitmapColors, displaySize, aspect, width, height;
Boolean addMonoIcon;
char	iconName[ICON_NAME_BUFFER_SIZE + 20];	// enough space for MonoMonikerPrefix, USually Mono or Monochrome SchwarzWeiss
int 	cmd, icon;
VMFileHandle vmFile;


    iSet = pself->DBVI_currentISet;
    vmFile = pself->DBVI_vmFile;

    /*
     * Get the number of current icons.
     * We can have max. MAX_ICONS icons. If the check is ok,
     * icon contains the index of the first new icon, since the counting starts at zero.
     */
    icon = IdGetEntryCount(vmFile, iSet);
    if (icon >= MAX_ICONS) {
    	ErrorBoxOptr(@TooManyIconsText);
    	return;
    }

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;


    /*
     *  Execute AddIconDialog
     */
    @call AddIconNameTextField::MSG_VIS_TEXT_REPLACE_ALL_OPTR(@DefaultNameCustomCommon, 0);
    cmd = UserDoDialog(@AddIconDialog);
    if ( cmd != IC_OK ) return;

    AppMarkBusy();

    /*
     * Ask UI for information about the icon
     */
    @call AddIconNameTextField::MSG_VIS_TEXT_GET_ALL_PTR(iconName);

    width = @call CustomIconWidthValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    height = @call CustomIconHeightValue::MSG_GEN_VALUE_GET_INTEGER_VALUE();
    bitmapColors = @call AddIconBitmapColorsChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();

    displaySize = @call AddIconDisplaySizeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    aspect = @call AddIconAspectChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    style = @call AddIconStyleChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();

    addMonoIcon = @call AddIconAddExtraMonoIcon::MSG_GEN_BOOLEAN_GROUP_GET_SELECTED_BOOLEANS() ? TRUE : FALSE;

    /*
     * Check Icon memory size. If to large, return
     */
    if (CheckIconTooLargeAndDealWithIt(width, height, bitmapColors | BMT_MASK) ) {
    	goto done;
    	}

    /*
     * Again, check icon count and ignore additonal mono icon, if there are too many icons
     */
    if ( addMonoIcon && ((icon+1) >= MAX_ICONS)) {
    	ErrorBoxOptr(@TooManyIconsText);
	addMonoIcon = FALSE;
    }

    /*
     * Create the new icon(s)
     */
    numIcons = addMonoIcon ? 2 : 1;

    IdCreateEntries(vmFile, iSet, numIcons);
    IdSetEntryCount(vmFile, iSet, icon + numIcons);

    /*
     * Initialize the icons using InitializeCustomIcon() and IdSetEntryName()
     */
    InitializeCustomIcon(vmFile, iSet, icon, style, width, height, bitmapColors, displaySize, aspect);
    IdSetEntryName(vmFile, iSet, icon, iconName);
    if ( addMonoIcon ) {
    	InitializeCustomIcon(vmFile, iSet, icon+1, style, width, height, BMF_MONO, displaySize, aspect);
    	/*
    	 * Add a "monochrome" specifier in front of the given name
    	 * Buffer (iconName) size is large enough, but the resulting lenght may be too large
    	 * So, truncate it for savety
    	 */
    	MemLock(OptrToHandle(@MonoMonikerPrefix));
    	strcpy(iconName, LMemDeref(@MonoMonikerPrefix) );
    	@call AddIconNameTextField::MSG_VIS_TEXT_GET_ALL_PTR(strchr(iconName,0));
    	MemUnlock(OptrToHandle(@MonoMonikerPrefix));

    	iconName[MAX_ICON_NAME_LENGTH] = 0;
        IdSetEntryName(vmFile, iSet, icon+1, iconName);
    }

    /*
     * Edit the newly created icon and mark document dirty
     */
    @call oself::MSG_DB_VIEWER_ICON_ADDED(icon);

done:
    AppMarkNotBusy();

}


/*--------------------- MSG_DB_VIEWER_ICON_ADDED ---------------------
 *  Purpose:	An new Icon has been added
 *  Context:
 *  Strategy:
 *	- rescan list to show the new icon
 *	- switch editing to passed icon
 *	- make document dirty
 *	- update edit menu to be save
 *	- scroll list to show the icon
 *
 *  Parameters:	iconToEdit:	edit and show this icon
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_ICON_ADDED {
optr	iconObj;
Rectangle bounds;

    /*
     * rescan list, edit icon and mark document dirty
     */
    @call @GetDocUIOptr(@IconListContent)::MSG_ICON_VIEWER_RESCAN_LIST();
    pself = ObjDerefVis(oself);
    pself->DBVI_currentIcon = iconToEdit;
    @call oself::MSG_DB_VIEWER_SWITCH_ICON(iconToEdit);

    @send IconDocumentGroup::MSG_GEN_DOCUMENT_GROUP_MARK_DIRTY_BY_FILE (pself->DBVI_vmFile);

    /*
     * Make the DBVI_currentIcon visible in the IconListView
     */
    iconObj = @call @GetDocUIOptr(@IconListContent)::MSG_VIS_FIND_CHILD_AT_POSITION(iconToEdit);
    @call iconObj::MSG_VIS_GET_BOUNDS(&bounds);
    @call @GetDocUIOptr(@IconListView)::MSG_GEN_VIEW_SET_ORIGIN(bounds.R_top - ICON_LIST_MARGIN, 0);

    /*
     * Update edit menu (for savety only)
     */
    @call oself::MSG_DB_VIEWER_UPDATE_EDIT_MENU();
}

/*--------------------- MSG_DB_VIEWER_DELETE_ICON ---------------------
 *  Purpose:	Deletes the current icon.
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_DELETE_ICON {
int count, cmd;
optr visISet;


    if ( pself->DBVI_currentISet == NO_CURRENT_ISET ) return;

   /*
     *  See if this is the last icon left to the icon set.
     */
    count = IdGetEntryCount(pself->DBVI_vmFile, pself->DBVI_currentISet);
    if ( count <= 1 ) {
    	/*
    	 *  Put up a dialog asking if they want to delete the icon set
    	 *  (which is what we do if they delete the last icon).
    	 */
	cmd = QuestionBoxOptr(@CantDeleteLastIconText);
	if ( cmd != IC_YES ) return;
	@call oself::MSG_DB_VIEWER_DELETE_CURRENT_ISET(FALSE);
	return;
	}

    /*
     *  Put up the dialog asking if they're sure,
     *  but only if confirm-on-delete is set
     */
    cmd = ConfirmOnDeleteBox(@PromptForDeleteIconText);
    if ( cmd != IC_YES ) return;
    IdDeleteEntry(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);
    SetIconDirtyState(pself, FALSE);


    /*
     *  Since the icon we just deleted wasn't the last one, we'll
     *  just switch-icon to the first in the list.
     */
    @call oself::MSG_DB_VIEWER_SWITCH_ICON(0);
    @call ConstructOptr(OptrToHandle(oself), OptrToChunk(@IconListContent))::MSG_ICON_VIEWER_RESCAN_LIST();

    /*
     *  If the deleted icon was the first one, the VisISet needs new bounds to draw
     *  the bitmap, because the there is a new bitmap.
     *  MSG_VIS_ISET_INITIALIZE does the job. Then redraw the database viewer.
     */
    pself = ObjDerefVis(oself);
    if (pself->DBVI_currentIcon == 0) {
    	visISet = @call oself::MSG_VIS_FIND_CHILD_AT_POSITION(pself->DBVI_currentISet);
    	@send visISet::MSG_VIS_ISET_INITIALIZE(pself->DBVI_currentISet);
    	@send oself::MSG_VIS_INVALIDATE();
    }


}

/*--------------------- MSG_DB_VIEWER_DUPLICATE_ICON ---------------------
 *  Purpose:	Make a 1:1 copy of the currently editied icon
 *  Context:
 *  Strategy:
 	- Copy the IconEntry data
 	- Copy the bitmap
 	- Update name, e.g. AppVGAMoniker -> AppVGAMoniker1
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_DUPLICATE_ICON {
int iSet, numIcons;
word size;
IconEntry *curEntryPtr, *newEntryPtr;
optr iEntryList;
VMFileHandle vmFile;
char iconName[ICON_NAME_BUFFER_SIZE + 5]; // savety for working with sprintf

    if ( CheckIconDirtyAndDealWithIt(oself, TRUE) ) return;

    /*
     * Add a new, empty icon
     */
    iSet = pself->DBVI_currentISet;
    if (iSet == NO_CURRENT_ISET ) return;	// for savety only
    vmFile = pself->DBVI_vmFile;

    numIcons = IdGetEntryCount(vmFile, iSet);
    IdCreateEntries(vmFile, iSet, 1);
    IdSetEntryCount(vmFile, iSet, numIcons + 1);

    /*
     * Lock iEntryList and copy icon-related information
     * Because icon counting starts with zero, numIcons is the index of the new icon
     * Unlock entryList afterwards
     */
    iEntryList = IdLockEntryList(vmFile, iSet);
    EC ( if ( ChunkArrayGetCount(iEntryList) != (numIcons+1))  { ProgError("duplicate_icon: numIconsError"); return; } )

    curEntryPtr = ChunkArrayElementToPtr(iEntryList, pself->DBVI_currentIcon, &size);
    newEntryPtr = ChunkArrayElementToPtr(iEntryList, numIcons, &size);

    *newEntryPtr = *curEntryPtr;
    newEntryPtr->IE_bitmap = BTCopyBitmap(vmFile, vmFile, curEntryPtr->IE_bitmap);

    IdUnlockEntryList(iEntryList, FALSE);


    /*
     * Change the name to avoid duplicted visMoniker identifiers when writing the icon set to file
     * If there is no current name, generate one.
     * Remember that numIcons is the index of the new icon
     */
    IdGetEntryName(vmFile, iSet, numIcons, iconName);
    if ( strlen(iconName) == 0 ) strcpy(iconName, "Moniker");	// no need to localize this
    iconName[MAX_ICON_NAME_LENGTH-2] = 0;				// get space for the number
    sprintf( strchr(iconName,0), "%u", numIcons);
    IdSetEntryName(vmFile, iSet, numIcons, iconName);


    /*
     * Rescan icon list. Keep editing the current icon.
     * MSG_ICON_VIEWER_RESCAN_LIST creates new objetcs so it may invalidate pself
     * on older systems. In BBX4 and later, pself is dereferenced automatically
     * if the caller is a method, but not if the caller is a routine.
     * MSG_ICON_VIEWER_RESCAN_LIST also forces the IconListContent to redraw.
     */

    @call ConstructOptr(OptrToHandle(oself), OptrToChunk(@IconListContent))::MSG_ICON_VIEWER_RESCAN_LIST();
    //pself = ObjDerefVis(oself);
}


/*--------------------- MSG_DB_VIEWER_RENAME_ICON ---------------------
 *  Purpose:	Rename the currently editied icon
 *  Context:
	- get the current name from icon
	- update and execute rename dialog
	- store undo information
	- get the name from the Rename dialog box
	- set the name of the icon in the database
	- update FatbitsInfoText
	- mark document file as dirty
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_RENAME_ICON {
char  name[ISET_NAME_BUFFER_SIZE];
int cmd;

    if (pself->DBVI_currentISet == NO_CURRENT_ISET) return;

    /*
     * Execte Rename-Dialog
     */
    IdGetEntryName(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon, name);
    @call RenameIconTextField::MSG_VIS_TEXT_REPLACE_ALL_PTR(name, 0);
    cmd = UserDoDialog(@RenameIconDialog);
    if ( cmd != IC_OK) return;

    /*
     * Store undo information
     */
    @call ConstructOptr(OptrToHandle(oself), OptrToChunk(@MyFatbits))::MSG_FATBITS_UNDO_SAVE_ICON_STATE(UNDO_RENAME_ICON);

    /*
     * Rename the icon and update FatbitsInfoText
     */
    @call RenameIconTextField::MSG_VIS_TEXT_GET_ALL_PTR(name);
    IdSetEntryName(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon, name);
    IconUpdateIconInformation(oself, pself->DBVI_currentIcon);


    /*
     * Finally mark the database dirty. Use @send because IconDocumentGroup runs in process thread.
     */
    @send IconDocumentGroup::MSG_GEN_DOCUMENT_GROUP_MARK_DIRTY_BY_FILE (pself->DBVI_vmFile);

}

/*--------------------- MSG_DB_VIEWER_START_ICON_PROPERTIES_DIALOG ---------------------
 *  Purpose:	Initialize and open dialog for modifying icon properties
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_START_ICON_PROPERTIES_DIALOG {
VMBlockHandle iconBmp;
int 	width, height, bmFormat;
word	val, vmlet;	/* VisMonikerListEntryType */
char	buf[25];
optr	textOp;
DisplayClass	displayClass;
dword	sizeUncompressed, sizeCompressed;


    /*
     * Send current icon properties to UI
     */
    vmlet = IdGetEntryType(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);

    val = (vmlet & VMLET_STYLE) >> VMLET_STYLE_OFFSET;
    @send IconAttributesStyleChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(val, FALSE);

    val = (vmlet & VMLET_GS_SIZE) >> VMLET_GS_SIZE_OFFSET;
    @send IconAttributesDisplaySizeChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(val, FALSE);

    val = (vmlet & VMLET_GS_ASPECT_RATIO) >> VMLET_GS_ASPECT_RATIO_OFFSET;
    @send IconAttributesAspectChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(val, FALSE);

    val = (vmlet & VMLET_GS_COLOR) >> VMLET_GS_COLOR_OFFSET;
    @send IconAttributesDisplayClassChooser::MSG_GEN_ITEM_GROUP_SET_SINGLE_SELECTION(val, FALSE);

    /*
     * Get bitmap information and send it to the UI
     */
    iconBmp = IdGetEntryBitmap(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon);
    bmFormat = BTGetMoreBitmapInfos(pself->DBVI_vmFile, iconBmp, &width, &height, 0);

    sprintf(buf, "%ux%u,  ", width, height);
    @call IABitmapInfoText::MSG_VIS_TEXT_REPLACE_ALL_PTR(buf, 0);

    switch (bmFormat & BMT_FORMAT) {
	case BMF_MONO:	textOp = @IconInfoMonoText;	break;
    	case BMF_4BIT:	textOp = @IconInfo16ColorsText;	break;
        case BMF_8BIT:	textOp = @IconInfo256ColorsText; break;
    	default: 	textOp = @IconInfoTCText;	break;
	}
    @call IABitmapInfoText::MSG_VIS_TEXT_APPEND_OPTR(textOp, 0);
    if ( bmFormat & BMT_PALETTE ) {
    	@call IABitmapInfoText::MSG_VIS_TEXT_APPEND_PTR(", ", 0);
    	@call IABitmapInfoText::MSG_VIS_TEXT_APPEND_OPTR(@TokenInfoPalette, 0);
    }

    /*
     * Get suggested display class and send it to the UI
     */
    displayClass = FindSuggestedDisplayClass(pself->DBVI_vmFile, iconBmp);
    switch ( displayClass ) {
    case DC_CF_RGB: 	textOp = @TokenInfoRGBScreen;	break;
    case DC_COLOR_8: 	textOp = @TokenInfo256Screen;	break;
    case DC_GRAY_1:	textOp = @TokenInfoMonoScreen;	break;
    default: 		textOp = @TokenInfo16Screen;
    }
    @call IASuggestesDisplayClassText::MSG_VIS_TEXT_REPLACE_ALL_OPTR(textOp, 0);

    /*
     * Display uncompressed and compressed size
     */
    ExpTokenFindBitmapSizes(pself->DBVI_vmFile, iconBmp, &sizeUncompressed, &sizeCompressed);
    MemLock(OptrToHandle(@TokenInfoSizeBytes));

    sprintf(buf, LMemDeref(@TokenInfoSizeBytes), sizeUncompressed);
    @call IAUncompressedSizeText::MSG_VIS_TEXT_REPLACE_ALL_PTR(buf, 0);
    if (sizeUncompressed > MAX_SAFE_MONIKER_SIZE)
    	@call IAUncompressedSizeText::MSG_VIS_TEXT_APPEND_OPTR(@TokenInfoTooLarge, 0);

    sprintf(buf, LMemDeref(@TokenInfoSizeBytes), sizeCompressed);
    @call IACompressedSizeText::MSG_VIS_TEXT_REPLACE_ALL_PTR(buf, 0);
    if (sizeCompressed > MAX_SAFE_MONIKER_SIZE)
    	@call IACompressedSizeText::MSG_VIS_TEXT_APPEND_OPTR(@TokenInfoTooLarge, 0);

    MemUnlock(OptrToHandle(@TokenInfoSizeBytes));

    /*
     * Ready
     */
    @send ChangeIconAttributesDialog::MSG_GEN_INTERACTION_INITIATE();
}

/*--------------------- MSG_DB_VIEWER_CHANGE_ICON_PROPERTIES ---------------------
 *  Purpose:	Icon property dialog has been finished
 *  Context:
 *  Strategy:	- if doChange is FALSE, do nothing
 *		- read properties from UI and write it to the icon
 *		- update program UI
 *  Parameters:	Boolean doChange
 *  Return:
 ---------------------------------------------------------------------------*/
@method IconDBViewerClass, MSG_DB_VIEWER_CHANGE_ICON_PROPERTIES {
word val;
word vmlet;	/* VisMonikerListEntryType */

    @send ChangeIconAttributesDialog::MSG_GEN_GUP_INTERACTION_COMMAND(IC_DISMISS);
    if ( !doChange ) return;

    /*
     * read icon style, display size, aspect ratio and disply class
     * from dialog UI objects and update icon entry
     */
    vmlet = 0x40;	/* Set GSting Bit */
    val = @call IconAttributesStyleChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    vmlet |= val << VMLET_STYLE_OFFSET;

    val = @call IconAttributesDisplaySizeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    vmlet |= val << VMLET_GS_SIZE_OFFSET;

    val = @call IconAttributesAspectChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    vmlet |= val << VMLET_GS_ASPECT_RATIO_OFFSET;

    val = @call IconAttributesDisplayClassChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    vmlet |= val << VMLET_GS_COLOR_OFFSET;

    IdSetEntryType(pself->DBVI_vmFile, pself->DBVI_currentISet, pself->DBVI_currentIcon, vmlet);

    /*
     * Display new properties
     */
    @call oself::MSG_DB_VIEWER_UPDATE_ICON_INFORMATION(pself->DBVI_currentIcon);
}

