/*--------------------- IdGetEntry ---------------------
 *  Purpose: 	Returns the entire IconEntry structure for an icon
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdGetEntry(VMFileHandle vmFile, int iSet, int icon, IconEntry *retEntry) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdGetEntry: wrong icon number"); MessageNumberBox(icon)} )

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    *retEntry = *iconEntry;
    IdUnlockEntryList(iEntryList, FALSE);

}

/*--------------------- IdSetEntry ---------------------
 *  Purpose: 	Set the entire IconEntry structure for an icon.
 *		The icon must already exist (use IdCreateEntries).
 *		iEntry.IE_bitmap may be zero or may point to a valid bitmap.
 *		This bitmap must already be stored in the database file.
 *		If iEntry.IE_bitmap is zero, re-use the existing bitmap.
 *  Context:
 *  Strategy:
 *	- get a pointer to passed icon
 *	- check if passed iEntry.IE_bitmap is zero or not
 *	  if it is zero ther is no new bitmap. Re-use the existing one
 *	  if not, iEntry.IE_bitmap is the ne bitmap to use. then free the existing bitmap
 *	- replace exiisting icon entry structure.
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdSetEntry(VMFileHandle vmFile, int iSet, int icon, IconEntry iEntry) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdGetEntry: wrong icon number"); MessageNumberBox(icon)} )

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);

    /*
     * if iEntry.IE_bitmap is not zero free the old bitmap
     * if iEntry.IE_bitmap is zero still use the existing bitmap
     * then copy data over
     */
    if ( iEntry.IE_bitmap ) {
    	HugeArrayDestroy(vmFile, iconEntry->IE_bitmap);
    } else {
    	iEntry.IE_bitmap = iconEntry->IE_bitmap;
    }

    *iconEntry = iEntry;
    IdUnlockEntryList(iEntryList, TRUE);

}

/*--------------------- IdClearAndSetEntryBitmap ---------------------
 *  Purpose: 	Replaces the icon's bitmap from an icon entry
 *		The bitmap must already be stored in the database file.
 *  Context:
 *  Strategy:
 	- get & save the old bitmap's block handle
	- set the new bitmap into the database
	- free the old bitmap

	This prevents the format list from ever containing
	handles to freed blocks (this actually caused deaths,
	believe it or not).
*  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdClearAndSetEntryBitmap(VMFileHandle vmFile, int iSet, int icon, VMBlockHandle newBmp) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;
VMBlockHandle oldBmp;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdClearAndSetEntryBitmap: wrong icon number"); MessageNumberBox(icon); return; } )

    /*
     * Replace the bitmap handle. Mark entry dirty!
     */
    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    oldBmp = iconEntry->IE_bitmap;
    iconEntry->IE_bitmap = newBmp;
    IdUnlockEntryList(iEntryList, TRUE);


    /*
     * free old bitmap
     */
    HugeArrayDestroy(vmFile, oldBmp);
}

/*--------------------- IdDeleteEntry ---------------------
 *  Purpose:	Deletes the passed iconEntry & updates the count
 *  Context:
 *  Strategy:
	- get the icon bitmap and free it
	- compact the iconEntry list to get rid of the hole
	- decrements the icon count for the icon set
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdDeleteEntry(VMFileHandle vmFile, int iSet, int icon) {
EC (int count;)
optr	iEntryList;
IconEntry *iconEntry;
word	size;
VMBlockHandle bmp;

    /*
     * Destroy Bitmap
     */
    bmp = IdGetEntryBitmap(vmFile, iSet, icon);
    if (!bmp) return;

    EC ( if (CheckVMBlockValid(vmFile, bmp) ) { ProgError("IdDeleteEntry: invalid Bitmap"); return; } )
    HugeArrayDestroy(vmFile, bmp);

    /*
     * Compact iEntryList
     */
    iEntryList = IdLockEntryList(vmFile, iSet);
    if (!iEntryList) return;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdDeleteEntry: wrong icon number"); MessageNumberBox(icon); return; } )

    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    ChunkArrayDelete(iEntryList, iconEntry);
    IdUnlockEntryList(iEntryList, TRUE);

    /*
     * Dec icon count
     */
    IdDecEntryCount(vmFile, iSet);
}

/*--------------------- IdIncEntryCount ---------------------
 *  Purpose:	Increments ISH_entryCount for the icon set.
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdIncEntryCount(VMFileHandle vmFile, int iSet) {
ISetHeader	*iHeader;

    iHeader = IdLockIconHeader(vmFile, iSet);
    iHeader->ISH_entryCount += 1;
    IdUnlockIconHeader(iHeader, TRUE);
}
/*--------------------- IdDecEntryCount ---------------------
 *  Purpose:	Decrements ISH_entryCount for the icon set.
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdDecEntryCount(VMFileHandle vmFile, int iSet) {
ISetHeader	*iHeader;

    iHeader = IdLockIconHeader(vmFile, iSet);
    iHeader->ISH_entryCount -= 1;
    IdUnlockIconHeader(iHeader, TRUE);
}

/*--------------------- IdFreeEntries ---------------------
 *  Purpose:	Frees all VM blocks (bitmaps) associated with an icon set.
 *  Context:
 *  Strategy:
 	- for each icon entry:  if the icon bitmap is nonzero, free it.
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdFreeEntries(VMFileHandle vmFile, int iSet) {
IconEntry *iconEntry;
optr	iEntryList;
word	n, count, size;

    iEntryList = IdLockEntryList(vmFile, iSet);
    if (!iEntryList) return;

    count = ChunkArrayGetCount(iEntryList);
    if (!count) goto unlock;

    for ( n = 0; n < count; n++) {
    	iconEntry = ChunkArrayElementToPtr(iEntryList, n, &size);
    	if ( iconEntry->IE_bitmap ) {
    	    /*
    	     * free the bitmap
    	     */
    	    HugeArrayDestroy(vmFile, iconEntry->IE_bitmap);
    	    iconEntry->IE_bitmap = 0;
    	}
    }

unlock:
    IdUnlockEntryList(iEntryList, FALSE);

}

/*--------------------- IdDeleteISet ---------------------
 *  Purpose:	Deletes an icon set from the database.  Doesn't delete the
		icons (call IdFreeEntries first).
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void IdDeleteISet(VMFileHandle vmFile, int iSet) {
ISetHeader *iHeader;
VMBlockHandle	array;

    /*
     *  Delete the iconEntry list vm block.
     */
    iHeader = IdLockIconHeader(vmFile, iSet);
    VMFree(vmFile, iHeader->ISH_iEntryListBlock);
    IdUnlockIconHeader(iHeader, FALSE);

    /*
     *  Delete the icon set in the icon list
     */
    array = IdGetHugeArray(vmFile);
    HugeArrayDelete(vmFile, array, 1, iSet);

}


/*---------------------------------------------------------------------------
 *  11/2025  - 	store extra data for an icon
 * ---------------------------------------------------------------------------*/

/*--------------------- ToolInitializeDrawAttrs ---------------------
 *  Purpose:	Set up initial line attrs and area attrs
 *  Parameters:
 *  Return:	structures filled in
 ---------------------------------------------------------------------------*/
void ToolInitializeDrawAttrs(IconLineAttrs *lineAttrs, IconAreaAttrs *areaAttrs) {

    if ( lineAttrs) {
    	memset(lineAttrs, 0, sizeof(IconLineAttrs));		// ensure unused fields to be zero
	lineAttrs->lineWidth.WWF_int = 1;
	lineAttrs->lineWidth.WWF_frac = 0;
	lineAttrs->lineStyle = LS_SOLID;
	lineAttrs->lineDrawMask = SDM_100;
	lineAttrs->lineMixMode = MM_COPY;
	lineAttrs->lineColor.rt = 0;	/* default black */
	lineAttrs->lineColor.gn = 0;
	lineAttrs->lineColor.bl = 0;
    }

    if ( areaAttrs) {
    	memset(areaAttrs, 0, sizeof(IconAreaAttrs));		// ensure unused fields to be zero
	areaAttrs->areaDrawMask = SDM_100;
	areaAttrs->areaPattern.HP_type = PT_SOLID ;
	areaAttrs->areaPattern.HP_data = 0;
	areaAttrs->areaMixMode = MM_COPY;
	areaAttrs->areaColor.rt = 0;	/* default black */
	areaAttrs->areaColor.gn = 0;
	areaAttrs->areaColor.bl = 0;
    }
}



/*--------------------- ToolCreateIconExtraBlock ---------------------
 *  Purpose:	Creata a VM block to store additonal data for the con
 *  Context:
 *  Strategy:
 	- Alloc the vm block
 	- clear the block and set (initial) version number
 *  Parameters:	vmFile:  database file
 *		bitmap:	 icon bitmap
 *  Return:
 ---------------------------------------------------------------------------*/
VMBlockHandle ToolCreateIconExtraBlock(VMFileHandle vmFile, VMBlockHandle bitmap) {
VMBlockHandle 	extraBlock;
MoreIconData	*dataPtr;
MemHandle	mh;
word	format;
PaletteEntry	color;

    extraBlock = VMAlloc(vmFile, sizeof(MoreIconData), 0);
    dataPtr = VMLock(vmFile, extraBlock, &mh);

    memset(dataPtr, 0, sizeof(MoreIconData));
    dataPtr->MID_version = MID_CURRENT_VERSION;
    ToolInitializeDrawAttrs(&(dataPtr->MID_lineAttrs), &(dataPtr->MID_areaAttrs));

    if ( bitmap ) {
    	/*
    	 * If the icons bitmap has a palette, the color black may not be part of the
    	 * palette. That is why we always use the color of the first palette index.
    	 */
    	format = BTGetMoreBitmapInfos(vmFile, bitmap, NULL, NULL, NULL);
    	if ( format & BMT_PALETTE ) {
    	    BTGetBitmapPalette(vmFile, bitmap, &color, 1);
    	    dataPtr->MID_lineAttrs.lineColor = color;
    	    dataPtr->MID_areaAttrs.areaColor = color;
    	}
    }

    VMDirty(mh);
    VMUnlock(mh);

    return extraBlock;
}

/*--------------------- IdGetIconExtraBlock ---------------------
 *  Purpose:	Get the IE_extraBlock for an icon.
 *		Ensure that the block exists.
 *  Context:
 *  Strategy:
 	- Lock icon list entry
 	- Read extra block. Create an empty block if it not extists.
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
VMBlockHandle IdGetIconExtraBlock( VMFileHandle vmFile, int iSet, int icon) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;
VMBlockHandle	extraBlock;

    // Check icon number (remember: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { DebugInfo2("\rIdGetExtraBlock icon=%u, count = %u", icon, count);
    		ProgError("IdGetIconExtraBlock: wrong icon number"); MessageNumberBox(icon); return 0; } )

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);

    /*
     * Ensure that there is an extra block. Older versions of
     * the icon editor will not create an extra block.
     * Then unlock IconEntry list.
     */
    extraBlock = iconEntry->IE_extraBlock;
    if ( !extraBlock ) {
        extraBlock = ToolCreateIconExtraBlock(vmFile, iconEntry->IE_bitmap);
        iconEntry->IE_extraBlock = extraBlock;
        IdUnlockEntryList(iEntryList, TRUE);
    } else {
    	IdUnlockEntryList(iEntryList, FALSE);
    }

    return extraBlock;
}


/*--------------------- IdSetLineAttrs ---------------------
 *  Purpose:	Store line drawing attributs for an icon
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdSetLineAttrs(VMFileHandle vmFile, int iSet, int icon, IconLineAttrs *lineAttrs) {
VMBlockHandle	extraBlock;
MoreIconData	*dataPtr;
MemHandle	mh;

    /*
     * Get the extra block. The routine ensures the existence of this block.
     */
    extraBlock = IdGetIconExtraBlock(vmFile, iSet, icon);

    /*
     * store line attributes
     */
    dataPtr = VMLock(vmFile, extraBlock, &mh);
    dataPtr->MID_lineAttrs = *lineAttrs;
    VMDirty(mh);
    VMUnlock(mh);

}

/*--------------------- IdSetAreaAttrs ---------------------
 *  Purpose:	Store area drawing attributs for an icon
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdSetAreaAttrs(VMFileHandle vmFile, int iSet, int icon, IconAreaAttrs *areaAttrs) {
VMBlockHandle	extraBlock;
MoreIconData	*dataPtr;
MemHandle	mh;

    /*
     * Get the extra block. The routine ensures the existence of this block.
     */
    extraBlock = IdGetIconExtraBlock(vmFile, iSet, icon);

    /*
     * store area attributes
     */
    dataPtr = VMLock(vmFile, extraBlock, &mh);
    dataPtr->MID_areaAttrs = *areaAttrs;
    VMDirty(mh);
    VMUnlock(mh);

}


/*--------------------- IdGetLineOrAreaAttrs ---------------------
 *  Purpose:	Read line and/or area drawing attributs for an icon
 *  Context:
 *  Strategy:
 *  Parameters: vmFile:	database file
 *		iSet:	icon set number
 *		icon:	icon number
 *		lineAttrs:	pointer to IconLineAttrs
 *				pass zero if you are not interested in
 *		areaAttrs:	pointer to IconAreaAttrs
 *				pass zero if you are not interested in
 *  Return:	lineAttrs/areaAttrs is filled in
 ---------------------------------------------------------------------------*/
void IdGetLineOrAreaAttrs(VMFileHandle vmFile, int iSet, int icon, IconLineAttrs *lineAttrs, IconAreaAttrs *areaAttrs) {
VMBlockHandle	extraBlock;
MoreIconData	*dataPtr;
MemHandle	mh;

    /*
     * Get the extra block. The routine ensures the existence of this block.
     */
    extraBlock = IdGetIconExtraBlock(vmFile, iSet, icon);

    /*
     * Copy requested attributes
     */
    dataPtr = VMLock(vmFile, extraBlock, &mh);
    if (lineAttrs) *lineAttrs = dataPtr->MID_lineAttrs;
    if (areaAttrs) *areaAttrs = dataPtr->MID_areaAttrs;
    VMUnlock(mh);

}

/*--------------------- ToolCreateISetExtraBlock ---------------------
 *  Purpose:	Create and initialize extra data block for an icon set
 *  Context:
 *  Strategy:
 	- create and lock block
 	- initialize data (version, token)
 *  Parameters:
 *  Return:	VMBlockHandle of the new block
 ---------------------------------------------------------------------------*/
VMBlockHandle ToolCreateISetExtraBlock(VMFileHandle vmFile) {
VMBlockHandle 	extraBlock;
ISetExtraData	*dataPtr;
MemHandle	mh;
char 	tchars[5];

    extraBlock = VMAlloc(vmFile, sizeof(ISetExtraData), 0);
    dataPtr = VMLock(vmFile, extraBlock, &mh);

    memset(dataPtr, 0, sizeof(ISetExtraData));
    dataPtr->ISED_version = ISED_CURRENT_VERSION;

    strcpy(tchars, "Tokn");
    memcpy(dataPtr->ISED_token.GT_chars, tchars, 4);
    dataPtr->ISED_token.GT_manufID = 0;

    VMDirty(mh);
    VMUnlock(mh);

    return extraBlock;
}

/*--------------------- IdGetISetExtraBlock ---------------------
 *  Purpose:	Get the ISH_extraBlock for an icon set.
 *		Ensure that the block exists.
 *  Context:
 *  Strategy:
 	- Lock icon set header
 	- Read extra block. Create an empty block if it not extists.
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
VMBlockHandle IdGetISetExtraBlock( VMFileHandle vmFile, int iSet) {
ISetHeader *iHeader;
VMBlockHandle	extraBlock;

    /*
     * Lock header
     */
    iHeader = IdLockIconHeader(vmFile, iSet);
    EC( if (!iHeader) { ProgError("IdGetISetExtraBlock: invaild iSet"); } )

    /*
     * Ensure that there is an extra block. Older versions of
     * the icon editor will not create an extra block.
     * Then unlock header and return.
     */
    extraBlock = iHeader->ISH_extraBlock;
    if ( !extraBlock ) {
        extraBlock = ToolCreateISetExtraBlock(vmFile);
        iHeader->ISH_extraBlock = extraBlock;
        IdUnlockIconHeader(iHeader, TRUE);
    } else {
    	IdUnlockIconHeader(iHeader, FALSE);
    }

    return extraBlock;
}


/*--------------------- IdSetToken ---------------------
 *  Purpose:	Store initial token for an icon set
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdSetToken(VMFileHandle vmFile, int iSet, GeodeToken token) {
VMBlockHandle	extraBlock;
ISetExtraData	*dataPtr;
MemHandle	mh;

    /*
     * Get the extra block. The routine ensures the existence of this block.
     */
    extraBlock = IdGetISetExtraBlock(vmFile, iSet);

    /*
     * store token
     */
    dataPtr = VMLock(vmFile, extraBlock, &mh);
    memcpy(&(dataPtr->ISED_token), &token, sizeof(GeodeToken));
    VMDirty(mh);
    VMUnlock(mh);

}

/*--------------------- IdSetToken ---------------------
 *  Purpose:	Store initial token for an icon set
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
GeodeToken IdGetToken(VMFileHandle vmFile, int iSet) {
VMBlockHandle	extraBlock;
ISetExtraData	*dataPtr;
MemHandle	mh;
GeodeToken 	token;

    /*
     * Get the extra block. The routine ensures the existence of this block.
     */
    extraBlock = IdGetISetExtraBlock(vmFile, iSet);

    /*
     * read token
     */
    dataPtr = VMLock(vmFile, extraBlock, &mh);
    memcpy(&token, &(dataPtr->ISED_token), sizeof(GeodeToken));
    VMUnlock(mh);

    return token;
}


