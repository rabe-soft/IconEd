/******************************************************************************
 *
 * PROJECT:	Icon Editor	(GOC Version)
 * FILE:	database.goc
 *
 * AUTHOR:	Steve Yegge, Nov 2, 1992
 *
 *	REVISION HISTORY:
 *	Name	Date		Description
 *	----	----		-----------
 *	stevey	11/2/92		Initial revision
 *	RainerB 7/18/2025	Ported to GOC
 *
 *
 * DESCRIPTION:
 *
 *	This file has the routines for accessing the database.
 *	Id... stands for IconDatabase
 *
ROUTINES:
	Interne Notizen	µµ
	- IdGetEntry, IdSetEntry, IdSetEntryNoCopy umbennat in
		IdGetEntryBitmap, IdSetEntryBitmap, IdSetEntryBitmapNoCopy
=============================================================================
Name				Description
=============================================================================
** common routines **
IdGetHugeArray()		-- returns the handle of the HugeArray
				   containing the ISetHeader for the icon sets

** deal with icon sets (ISetHeader structure) **
IdLockIconHeader()			-- returns a pointer to the icon set
IdUnlockIconHeader()			-- unlocks the icon set
IdDirtyISet()			-- indicates the icon set has been modified
IdGetISetName()			-- returns the name field for an icon set
IdSetISetName()			-- sets the name field for an icon set

IdAddISet()			-- adds an icon set to the database
IdCreateEntries()		-- creates blank icons in an icon set
IdGetISetCount()		-- returns the number of icon sets in the database

IdGetEntryCount()		-- returns number of valid icons for an icon set
IdSetEntryCount()		-- sets the number of valid icons for an icon set

IdGetEntryBitmap()		-- returns a icon bitmap from an icon set
IdGetEntryDimensions		-- returns width & height of a icon

IdSetPreviewObject		-- sets the preview object field for an icon set
IdSetPreviewColors		-- sets the preview colors for an icon set


** deal with icons (IconEntry structure) **
IdLockEntryList()		-- locks the vm block with iconEntry ChunkArray
				   (referred by ISH_iEntryListxxx)
IdUnlockEntryList()		-- unlocks the ISH_entryList
IdGetEntryName()		-- returns the name field for an icon
IdSetEntryName()		-- sets the name field for an icon

IdSetEntryBitmapNoCopy()	-- sets a bitmap in the iconEntry list (bitmap
				   must already	be copied to the database,
				   and icon must be created).

IdDeleteEntry()		-- deletes a iconEntry and compacts list
IdIncEntryCount()		-- increments the icon count for an icon set
IdDecEntryCount()		-- decrements the icon count for an icon set


IdSetEntryParameters		-- sets the VisMonikerListEntryType value for the icon
				   Parameters: IconParameters z.B. IP_STANDARD_VGA_FILE
IdGetEntryType		-- returns a VisMonikerListEntryType value

----------------------------------------------------------------------------
IdDeleteISet			-- deletes an icon set from the database

IdClearAndSetEntry		-- sets new bitmap & frees old one (safely)
IdFreeEntries		-- deletes all icons for an icon set

IdGetISetHeader			-- returns entire header for an icon set
IdSetISetHeader			-- sets most of the header for the icon set


IdSetEntryBitmap		-- sets a icon's bitmap (caller must free the old one)

IdGetEntry			-- Returns the entire IconEntry structure
				   for an icon
IdSetEntry			-- Set the entire IconEntry structure for
				   an icon set icon. The icon must already
				   exist (use IdCreateEntries).



IdGetEntryColorScheme		-- returns BMFormat for the icon

IdGetFlags			-- gets ISH_flags record
IdSetFlags			-- sets ISH_flags record


IdGetPreviewObject		-- returns the preview object for an icon set
IdGetPreviewColors		-- returns the preview colors for an icon set

IdDiscardIcon			-- discards the mem handles for the icon set

=============================================================================

*******************************************************************************/



/*  Standard include files */
@include <stdapp.goh>
@include <ansi/stdlib.h>
@include <ansi/stdio.h>
@include <ansi/string.h>

@include "iconed.goh"
@include "UI/appui.goh"

@include "token.h"

extern GlobalStruct global;


/* ###############################################################################
 * 	Local defs
/* ###############################################################################*/

#define  AssignVisMonikerListEntry(vmlet, size, style, aspect, color) \
	vmlet = 0x40;	/* GSting Bit set */ \
	vmlet |= size   << VMLET_GS_SIZE_OFFSET; \
	vmlet |= style  << VMLET_STYLE_OFFSET; \
	vmlet |= aspect << VMLET_GS_ASPECT_RATIO_OFFSET; \
	vmlet |= color  << VMLET_GS_COLOR_OFFSET;

/* ###############################################################################
 * 	Common routines
/* ###############################################################################*/

/*--------------------- IdGetHugeArray ---------------------
 *  Purpose:	Get the Handle of the HugeArray with the list of icon sets
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	The handle or zero if error
 ---------------------------------------------------------------------------*/
VMBlockHandle IdGetHugeArray(VMFileHandle vmFile) {
MemHandle	mh;
IconMapBlockStruct 	*mapPtr;
VMBlockHandle	mBlock, mainArray;


    mBlock = VMGetMapBlock(vmFile);
    EC(  if (!mBlock) { ProgError("\r** mBlock=0 **"); return 0; } )

    mapPtr = VMLock(vmFile, mBlock ,&mh);
    mainArray = mapPtr->IMBS_mainArray;
    EC(  if (!mainArray) { ProgError(" ** IMBS_mainArray NULL **");  VMUnlock(mh); return 0; } )

    VMUnlock(mh);
    return mainArray;

}


/* ###############################################################################
 * 	Deal with the icon sets (ISetHeader strcuture)
/* ###############################################################################*/

/*--------------------- IdLockIconHeader ---------------------
 *  Purpose:	Lock the requested icon header
 *  Context:
 *  Strategy:	Check number of icon sets first
 *  Parameters:
 *  Return:	Pointer to locked icon header
 *		NULL if iSet is invalid
 ---------------------------------------------------------------------------*/
ISetHeader *IdLockIconHeader(VMFileHandle vmFile, int iSet) {
VMBlockHandle mainArray;
int	count;
word 	size;
ISetHeader *header;

    if ( iSet < 0) return NULL;
    mainArray = IdGetHugeArray(vmFile);
    EC (if (!mainArray ) return NULL; )

    count = HugeArrayGetCount(vmFile, mainArray);
    if ( iSet >= count ) return NULL;	// index in HugeArrays are zero-based

    HugeArrayLock(vmFile, mainArray, iSet, (void**)&header, &size);
    return header;
}

/*--------------------- IdUnlockIconHeader ---------------------
 *  Purpose:	Unlock an icon header that was previously locked by IdLockIconHeader
 *  Context:
 *  Strategy:	May be faster if replaced by an macro.
 *		But macros have no type checking.
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdUnlockIconHeader(ISetHeader *iHeader, Boolean makeDirty) {
    if (makeDirty) HugeArrayDirty(iHeader);
    HugeArrayUnlock(iHeader);
}

/*--------------------- IdDirtyISet ---------------------
 *  Purpose:	Dirties the entry for the icon set.
 *  Context:
 *  Strategy:	May be faster if replaced by an macro.
 *		But macros have no type checking.
 *  Parameters:
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdDirtyISet(ISetHeader *iHeader) {
    HugeArrayDirty(iHeader);
}



/*--------------------- IdGetISetName ---------------------
 *  Purpose:	Returns the name of the icon set
 *  Context:
 *  Strategy:	Because ISH_name is declard as ISH_name[MAX_ISET_NAME_LENGTH]
 *		there may be no zero terminator if the name is 32 chars long.
 *
 *  Parameters:	vmFile, iSet: icon set
 *		name: return buffer, at least ISET_NAME_BUFFER_SIZE bytes
 *  Return:	FALSE
 *		TRUE if error
 ---------------------------------------------------------------------------*/
Boolean IdGetISetName(VMFileHandle vmFile, int iSet, char *name) {
ISetHeader *iHeader;

    name[0] = 0;
    iHeader = IdLockIconHeader(vmFile, iSet);
    if (!iHeader) return TRUE;

    memset(name, 0, ISET_NAME_BUFFER_SIZE);
    memcpy(name, iHeader->ISH_name, MAX_ISET_NAME_LENGTH);

    IdUnlockIconHeader(iHeader, FALSE);
    return FALSE;
}

/*--------------------- IdSetISetName ---------------------
 *  Purpose:	Set the name of the icon set
 *  Context:
 *  Strategy:	Because ISH_name is declard as ISH_name[MAX_ISET_NAME_LENGTH]
 *		there may be no zero terminator if the name is 32 chars long.
 *
 *  Parameters:	vmFile, iSet: icon set
 *		name: new name, max MAX_ISET_NAME_LENGTH charcters
 *  Return:	FALSE
 *		TRUE if error
 ---------------------------------------------------------------------------*/
Boolean IdSetISetName(VMFileHandle vmFile, int iSet, char *name) {
ISetHeader *iHeader;
int 	len;

    len = strlen(name);
    EC( if (len > MAX_ISET_NAME_LENGTH) { DebugInfo1("\rIdSetISetName: name too long (%u chars)", len); return TRUE; } )

    iHeader = IdLockIconHeader(vmFile, iSet);
    if (!iHeader) return TRUE;

    memset(iHeader->ISH_name, 0, MAX_ISET_NAME_LENGTH);
    memcpy(iHeader->ISH_name, name, len);

    IdUnlockIconHeader(iHeader, TRUE);
    return FALSE;
}

/*--------------------- IdGetFlags ---------------------
 *  Purpose:	Returns the ISH_flags record from the icon set header.
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet: icon set
 *  Return:	ISH_flags record
 *		TRUE if error
 ---------------------------------------------------------------------------*/
word IdGetFlags(VMFileHandle vmFile, int iSet) {
ISetHeader *iHeader;
word	flags;

    iHeader = IdLockIconHeader(vmFile, iSet);
    EC ( if (!iHeader) { ProgError("IdGetFlags invalid icon set"); return 0; } )

    flags = iHeader->ISH_flags;

    IdUnlockIconHeader(iHeader, FALSE);
    return flags;
}

/*--------------------- IdSetFlags ---------------------
 *  Purpose:	Sets the ISH_flags record in the icon set header.
 *  Context:
 *  Strategy:	Because ISH_name is declard as ISH_name[MAX_ISET_NAME_LENGTH]
 *		there may be no zero terminator if the name is 32 chars long.
 *
 *  Parameters:	vmFile, iSet: icon set
 *		flags: new flags (overwrite old flags)
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdSetFlags(VMFileHandle vmFile, int iSet, word flags) {
ISetHeader *iHeader;

    iHeader = IdLockIconHeader(vmFile, iSet);
    EC ( if (!iHeader) { ProgError("IdSetFlags invalid icon set"); return; } )

    iHeader->ISH_flags = flags;
    IdUnlockIconHeader(iHeader, TRUE);

}

/*--------------------- IdGetISetHeader ---------------------
 *  Purpose:	Returns the entire header for an icon set.

 *  Context:
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet: icon set
 		header: pointer to ISetHeader buffer
 *  Return:	header is filles in
 ---------------------------------------------------------------------------*/
void IdGetISetHeader(VMFileHandle vmFile, int iSet, ISetHeader *header) {
ISetHeader *iHeader;

    iHeader = IdLockIconHeader(vmFile, iSet);
    EC ( if (!iHeader) { ProgError("IdGetISetHeader invalid icon set"); return; } )
    *header = *iHeader;
    IdUnlockIconHeader(iHeader, FALSE);

}

/*--------------------- IdSetISetHeader ---------------------
 *  Purpose:	Sets the header from a buffer, EXCEPT for the iconEntry
		list, which is unchanged.
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile,
 *		iSet: icon set
 		header: pointer to ISetHeader buffer
 *  Return:	-
 ---------------------------------------------------------------------------*/
void IdSetISetHeader(VMFileHandle vmFile, int iSet, ISetHeader *header) {
ISetHeader *iHeader;
ChunkHandle 	iEntryListArray;
VMBlockHandle 	iEntryListBlock;

    iHeader = IdLockIconHeader(vmFile, iSet);
    EC ( if (!iHeader) { ProgError("IdSetISetHeader invalid icon set"); return; } )

    /*
     * Save the iconEntry list and restore it afterwards
     */
    iEntryListArray = iHeader->ISH_iEntryListArray;
    iEntryListBlock = iHeader->ISH_iEntryListBlock;
    *iHeader = *header;
    iHeader->ISH_iEntryListArray = iEntryListArray;
    iHeader->ISH_iEntryListBlock = iEntryListBlock;

    IdUnlockIconHeader(iHeader, TRUE);

}

/* ###############################################################################
 * 	Deal with the icon (IconEntry strcuture)
/* ###############################################################################*/

/*--------------------- IdLockEntryList ---------------------
 *  Purpose:	Locks the ChunkArray (stored in a vm block) with the icons
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		iSet	icon set number
 *  Return:	optr of the locked ChunkArray
 *		zero if any error;
 ---------------------------------------------------------------------------*/
optr	IdLockEntryList(VMFileHandle vmFile, int iSet) {
ISetHeader 	*iHeader;
VMBlockHandle	arrayBlock;
ChunkHandle 	arrayChunk;
MemHandle	mh;
optr		list;

	/*
	 * Find out the VMBlock for the icon list
	 */
    iHeader =IdLockIconHeader(vmFile, iSet);
    EC( if (!iHeader) { ProgError("\rIdLockEntryList invalid icon set");  } )
    if (!iHeader) return 0;

    arrayBlock = iHeader->ISH_iEntryListBlock;
    arrayChunk = iHeader->ISH_iEntryListArray;
    IdUnlockIconHeader(iHeader, FALSE);

    	/*
    	 * lock the block and construct optr
    	 */
    VMLock(vmFile, arrayBlock, &mh);
    list = ConstructOptr(mh, arrayChunk);

    return list;

}

/*--------------------- IdUnlockEntryList ---------------------
 *  Purpose:	Unlock the list, loced by IdLockEntryList
 *  Context:
 *  Strategy:
 *  Parameters:	optr of the list (ChunkArray)
 *  Return:
 ---------------------------------------------------------------------------*/
void IdUnlockEntryList(optr list, Boolean makeDirty) {
     if (makeDirty) VMDirty(OptrToHandle(list));
     VMUnlock( OptrToHandle(list) );
}

/*--------------------- ToolFixNameIfInvalid ---------------------
 *  Purpose:	Ensure that an entry name is never empty and has no spaces
 *  Context:	Empty names may occur if the database file was created
 *		by an older version of the IconEditor.
 *		Spaces should neve occur, but we want to be sure
 *  Parameters:	name: name to check and fix
 ---------------------------------------------------------------------------*/
void ToolFixNameIfInvalid(char *name) {
int n;

    /*
     * never have an empty name
     */
    if ( strlen(name) == 0) {
	MemLock(OptrToHandle(@IconUntitledName));
	strcpy(name, LMemDeref(@IconUntitledName));
	MemUnlock(OptrToHandle(@IconUntitledName));
    }

    /*
     * check and replace spaces
     */
    for ( n = 0; n < strlen(name); n++ ) {
    	if ( name[n] == ' ' ) name[n] = '_';
    }
}

/*--------------------- IdGetEntryName ---------------------
 *  Purpose:	Returns the name of a icon
 *  Context:
 *  Strategy:	Because IE_name is declard as ISH_name[MAX_ICON_NAME_LENGTH]
 *		there may be no zero terminator if the name is 32 chars long.
 *
 *  Parameters:	vmFile
 *		iSet: 	icon set number
 *		icon:	icon number
 *		name: 	return buffer, at least ICON_NAME_BUFFER_SIZE bytes
 *  Return:	FALSE
 *		TRUE if error
 ---------------------------------------------------------------------------*/
Boolean IdGetEntryName(VMFileHandle vmFile, int iSet, int icon, char *name) {
IconEntry *iconEntry;
optr	iEntryList;
word	count, size;

    name[0] = 0;
    iEntryList = IdLockEntryList(vmFile, iSet);
    if (!iEntryList) return TRUE;

    count = ChunkArrayGetCount(iEntryList);
    EC( if ( icon >= count ) { DebugInfo1("\rIdGetEntryName wrong icon %u", icon); } )
    if ( icon >= count ) {
    	IdUnlockEntryList(iEntryList, FALSE);
    	return FALSE;
    }

    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    memset(name, 0, ICON_NAME_BUFFER_SIZE);
    memcpy(name, iconEntry->IE_name, MAX_ICON_NAME_LENGTH);
    ToolFixNameIfInvalid(name);

    IdUnlockEntryList(iEntryList, FALSE);
    return FALSE;
}

/*--------------------- IdSetEntryName ---------------------
 *  Purpose:	Set the name of the icon
 *  Context:
 *  Strategy:	- Because IE_name is declard as ISH_name[MAX_ICON_NAME_LENGTH]
 *		  there may be no zero terminator if the name is 32 chars long.
 *		- Also ensure that the nam is not empty and has no spaces
 *  Parameters:	vmFile
 *		iSet: 	icon set number
 *		icon:	icon number
 *		name: 	new name, max MAX_ICON_NAME_LENGTH charcters
 *  Return:	FALSE
 *		TRUE if error
 ---------------------------------------------------------------------------*/
Boolean IdSetEntryName(VMFileHandle vmFile, int iSet, int icon, char *name) {
IconEntry *iconEntry;
optr	iEntryList;
int 	len;
word count, size;

    len = strlen(name);
    EC( if (len > MAX_ICON_NAME_LENGTH) { DebugInfo1("I\rdSetEntryName: name too long (%u chars)", len); return TRUE; } )

    iEntryList = IdLockEntryList(vmFile, iSet);
    if (!iEntryList) return TRUE;

    count = ChunkArrayGetCount(iEntryList);
    EC( if ( icon >= count ) { DebugInfo1("\rIdSetEntryName wrong icon %u", icon); } )
    if ( icon >= count ) {
    	IdUnlockEntryList(iEntryList, FALSE);
    	return FALSE;
    }

    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    memset(iconEntry->IE_name, 0, MAX_ICON_NAME_LENGTH);
    memcpy(iconEntry->IE_name, name, len);
    ToolFixNameIfInvalid(iconEntry->IE_name);

    IdUnlockEntryList(iEntryList, TRUE);
    return FALSE;
}

/*--------------------- IdAddISet ---------------------
 *  Purpose:	Adds a new icon set to the database
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		count	number of new icons
 *  Return:	index of new icon set (just created)
 ---------------------------------------------------------------------------*/
int IdAddISet(VMFileHandle vmFile, int count) {
VMBlockHandle	iconArray;
ISetHeader *iHeader;
word	idx, size;
MemHandle   mh;
ChunkHandle arrayChunk;
VMBlockHandle	blk;

	/*
	 * Add new icon set to HugeArray
	 * Index is zero based, so 'idx' will be the new Index
	 */
    iconArray = IdGetHugeArray(vmFile);
    idx = HugeArrayGetCount(vmFile, iconArray);
    HugeArrayAppend(vmFile, iconArray, 1, NULL);

    	/*
    	 * Create a chunk array for the IconEntry list.
    	 * Attach the block to our database
    	 */
    mh= MemAllocLMem(LMEM_TYPE_GENERAL,0);
    MemLock(mh);
    arrayChunk = ChunkArrayCreate(mh, sizeof(IconEntry), 0, OCF_DIRTY);
    MemUnlock(mh);
    blk = VMAttach(vmFile, 0, mh);


    	/*
    	 * Save the chunk array in ISH_iEntryListxxx.
    	 * Clear out ISetHeader structure for savety first
    	 */
    HugeArrayLock(vmFile, iconArray, idx, (void**)&iHeader, &size);
    memset(iHeader, 0, sizeof(ISetHeader));
    iHeader->ISH_iEntryListBlock = blk;
    iHeader->ISH_iEntryListArray = arrayChunk;
    HugeArrayDirty(iHeader);
    HugeArrayUnlock(iHeader);

    	/*
    	 * Create some blank icons.
    	 */
    IdCreateEntries(vmFile, idx, count);

    return idx;

}

/*--------------------- IdCreateEntries ---------------------
 *  Purpose:	Creates blank icons for an icon set
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		iSet	icon set (number)
 *		count	number of new icons
 *  Return:
 ---------------------------------------------------------------------------*/
void IdCreateEntries(VMFileHandle vmFile, int iSet, int count) {
optr  iEntryList;
int n;
IconEntry *iconEntry;

    if (!count) return;

    iEntryList = IdLockEntryList(vmFile, iSet);
    for ( n = 0; n < count; n++) {
    	iconEntry = ChunkArrayAppend(iEntryList, sizeof(IconEntry));
    	memset(iconEntry, 0, sizeof(IconEntry));
    	}
    IdUnlockEntryList(iEntryList, TRUE);
}

/*--------------------- IdGetISetCount ---------------------
 *  Purpose:	Returns the number of icon sets in the database.
 *  Context:
 *  Strategy:
 	  We always assume the database has fewer than 64k icon sets in it,
	  so we always return the low word from HugeArrayGetCount.
 *  Parameters:	vmFile	database file
 *  Return:
 ---------------------------------------------------------------------------*/
word IdGetISetCount(VMFileHandle vmFile) {
VMBlockHandle	iconArray;
word count;

    iconArray = IdGetHugeArray(vmFile);
    count = HugeArrayGetCount(vmFile, iconArray);
    return count;

}

/*--------------------- IdSetEntryBitmapNoCopy ---------------------
 *  Purpose:	sets a bitmap in the iconEntry list (bitmap
 *		must already be copied to the database,
 *		and icon must be created).
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		iSet	icon set (number)
 *		icon	icon number
 *  Return:
 ---------------------------------------------------------------------------*/
void IdSetEntryBitmapNoCopy(VMFileHandle vmFile, int iSet, int icon, VMBlockHandle bmp) {
optr  iEntryList;
IconEntry *iconEntry;
word size;

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    iconEntry->IE_bitmap = bmp;
    IdUnlockEntryList(iEntryList, TRUE);
}

/*--------------------- IdSetEntryCount ---------------------
 *  Purpose:	Update the number of valid icons for an icon set
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		iSet	icon set (number)
 *		count	number of icons
 *  Return:
 ---------------------------------------------------------------------------*/
void IdSetEntryCount(VMFileHandle vmFile, int iSet, int count) {
ISetHeader	*iHeader;

    iHeader = IdLockIconHeader(vmFile, iSet);
    iHeader->ISH_entryCount = count;
    IdUnlockIconHeader(iHeader, TRUE);
}


/*--------------------- IdGetEntryCount ---------------------
 *  Purpose:	returns number of valid icons for an icon set
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile	database file
 *		iSet	icon set (number)
 *  Return:
 ---------------------------------------------------------------------------*/
int IdGetEntryCount(VMFileHandle vmFile, int iSet) {
int count;
ISetHeader	*iHeader;

    if (iSet < 0 ) return 0;	/* usually NO_CURRENT_ISET passend */
    iHeader = IdLockIconHeader(vmFile, iSet);
    count = iHeader->ISH_entryCount;
    IdUnlockIconHeader(iHeader, FALSE);

    return count;
}

/*--------------------- IdSetEntryParameters ---------------------
 *  Purpose:	Build the VisMonikerListEntryType value for the icon.
 *  Context:
 *  Strategy:

 *  Parameters:	vmFile	database file
 *		iSet	icon set (number)
 *		icon	icon number
 *		params	icon parameters ... an IP_xx constant
 *		colorScheme	Color depth, if the icon is colored
 *				pass BMF_4BIT, BMF_8BIT or BMF_24BIT
 *  Return:
 ---------------------------------------------------------------------------*/
void IdSetEntryParameters(VMFileHandle vmFile, int iSet, int icon, IconParameters params) {
word	vmlet;		/* typedef WordFlags VisMonikerListEntryType; */
IconEntry *iconEntry;
optr	iEntryList;
word	size;

    switch (params) {

    case IP_STANDARD_SVGA_FILE_256:
	AssignVisMonikerListEntry(vmlet, DS_LARGE,    VMS_ICON, DAR_NORMAL,   DC_COLOR_8); 	// SVGA file
    	break;
    case IP_STANDARD_SVGA_FILE:
	AssignVisMonikerListEntry(vmlet, DS_LARGE,    VMS_ICON, DAR_NORMAL,   DC_COLOR_4); 	// SVGA file
    	break;
    case IP_STANDARD_SVGA_FILE_MONO:
	AssignVisMonikerListEntry(vmlet, DS_LARGE,    VMS_ICON, DAR_NORMAL,   DC_GRAY_1); 	// SVGA file
    	break;
    case IP_CGA_PREF_MODULE:
	AssignVisMonikerListEntry(vmlet, DS_LARGE,    VMS_ICON, DAR_VERY_SQUISHED,   DC_GRAY_1); 	// SVGA file
    	break;


    case IP_STANDARD_VGA_FILE_256:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_NORMAL,   DC_COLOR_8); 	// VGA file
    	break;
    case IP_STANDARD_VGA_FILE:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_NORMAL,   DC_COLOR_4); 	// VGA file
    	break;
    case IP_STANDARD_MCGA_FILE:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_NORMAL,   DC_GRAY_1); 	// MCGA file
    	break;
    case IP_STANDARD_CGA_FILE:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_VERY_SQUISHED, DC_GRAY_1);	// CGA file
    	break;


    case IP_TINY_COLOR_FILE_256:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_ICON, DAR_NORMAL,   DC_COLOR_8);	// TC file
    	break;
    case IP_TINY_COLOR_FILE:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_ICON, DAR_NORMAL,   DC_COLOR_4);	// TC file
    	break;
    case IP_TINY_MONO_FILE:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_ICON, DAR_NORMAL,   DC_GRAY_1); 	// TM file
    	break;


    case IP_TINY_COLOR_TOOL_256:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_TOOL, DAR_NORMAL,   DC_COLOR_8); 	// TC tool
    	break;
    case IP_TINY_COLOR_TOOL:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_TOOL, DAR_NORMAL,   DC_COLOR_4); 	// TC tool
    	break;
    case IP_TINY_MONO_TOOL:
	AssignVisMonikerListEntry(vmlet, DS_TINY,     VMS_TOOL, DAR_NORMAL,   DC_GRAY_1); 	// TM tool
    	break;
    case IP_STANDARD_CGA_TOOL:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_TOOL, DAR_VERY_SQUISHED, DC_GRAY_1); 	// CGA tool
    	break;


    case IP_PTR_IMAGE:
	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_NORMAL,   DC_COLOR_4); 	// Pointer image
// 	AssignVisMonikerListEntry(vmlet, DS_TINY, VMS_ICON, DAR_NORMAL,   colorDC); 	// Pointer image
 DebugInfo("\rIP_PTR_IMAGE: IdSetEntryParameters - VisMonikerListEntryType ok?"); //µµ

    	break;

    default: // unknown value
    	ProgError("IdSetEntryParameters: param noch nicht implementiert");
    	AssignVisMonikerListEntry(vmlet, DS_STANDARD, VMS_ICON, DAR_NORMAL,   DC_COLOR_4); 	// Savety value
    EC ( ProgError("IdSetEntryParameters: invalid params"); )
    }


 	/*
	 * Assign VisMonikerListEntryType value
	 *
	 */
    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    iconEntry->IE_type = vmlet;
    IdUnlockEntryList(iEntryList, TRUE);

}

/*--------------------- GetEntryDefaultNameOptr ---------------------
 *  Purpose:
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
optr GetEntryDefaultNameOptr(IconParameters params) {
optr defaultNameOp = 0;

    switch (params) {
    case IP_STANDARD_SVGA_FILE_256:
	defaultNameOp = @DefaultNameSVGAFile256;
    	break;
    case IP_STANDARD_SVGA_FILE:
	defaultNameOp = @DefaultNameSVGAFile;
    	break;
    case IP_STANDARD_SVGA_FILE_MONO:
	defaultNameOp = @DefaultNameSVGAFileMono;
    	break;
    case IP_CGA_PREF_MODULE:
	defaultNameOp = @DefaultNameCGAPrefModule;
    	break;

    case IP_STANDARD_VGA_FILE_256:
	defaultNameOp = @DefaultNameVGAFile256;
    	break;
    case IP_STANDARD_VGA_FILE:
	defaultNameOp = @DefaultNameVGAFile;
    	break;
    case IP_STANDARD_MCGA_FILE:
	defaultNameOp = @DefaultNameMCGAFile;
    	break;
    case IP_STANDARD_CGA_FILE:
	defaultNameOp = @DefaultNameCGAFile;
    	break;


    case IP_TINY_COLOR_FILE_256:
	defaultNameOp = @DefaultNameTinyCFile256;
    	break;
    case IP_TINY_COLOR_FILE:
	defaultNameOp = @DefaultNameTinyCFile;
    	break;
    case IP_TINY_MONO_FILE:
	defaultNameOp = @DefaultNameTinyMFile;
    	break;

    case IP_TINY_COLOR_TOOL_256:
	defaultNameOp = @DefaultNameTinyCTool256;
    	break;
    case IP_TINY_COLOR_TOOL:
	defaultNameOp = @DefaultNameTinyCTool;
    	break;
    case IP_TINY_MONO_TOOL:
	defaultNameOp = @DefaultNameTinyMTool;
    	break;

    case IP_STANDARD_CGA_TOOL:
	defaultNameOp = @DefaultNameCGATool;
    	break;

    case IP_PTR_IMAGE:
	defaultNameOp = @DefaultNameMousePointer;
    	break;

    default: // hm ..new FP value added?
	defaultNameOp = @DefaultNameCustomCommon;
    EC ( ProgError("GetEntryDefaultNameOptr: invalid params"); )
    }

    return defaultNameOp;
}


/*--------------------- IdGetEntryType ---------------------
 *  Purpose: 	Returns the VisMonikerListEntryType value (IE_type field) for an icon
 *  Context:
 *  Strategy:
 *  Parameters:
 *  Return:	VisMonikerListEntryType	(typedef WordFlags VisMonikerListEntryType)
 ---------------------------------------------------------------------------*/
word IdGetEntryType(VMFileHandle vmFile, int iSet, int icon) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;
word 	retVal;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdGetEntryType: wrong icon number"); MessageNumberBox(icon); return 0; } )

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    retVal = iconEntry->IE_type;
    IdUnlockEntryList(iEntryList, FALSE);

    return retVal;
}

/*--------------------- IdSetEntryType ---------------------
 *  Purpose: 	Set the (already build) VisMonikerListEntryType value
 *		(IE_type field) for an icon.
 *  Context:
 *  Strategy:
 *  Parameters:	vmFile, iSet, icon: icon to modify
 *		vmlet: VisMonikerListEntryType (wordflags)
 *  Return: 	-
 ---------------------------------------------------------------------------*/
void IdSetEntryType(VMFileHandle vmFile, int iSet, int icon, word vmlet) {
EC (int count;)
IconEntry *iconEntry;
optr	iEntryList;
word 	size;

    // Check icon number (note: first icon number is zero!)
    EC ( count = IdGetEntryCount(vmFile, iSet); )
    EC ( if (icon >= count) { ProgError("IdGetEntryType: wrong icon number"); MessageNumberBox(icon); return; } )

    iEntryList = IdLockEntryList(vmFile, iSet);
    iconEntry = ChunkArrayElementToPtr(iEntryList, icon, &size);
    iconEntry->IE_type = vmlet;
    IdUnlockEntryList(iEntryList, TRUE);

}



