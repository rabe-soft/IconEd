    EditUpdateGSLineAttributes(pself->FBI_maskGState, BMF_MONO, &(pself->FBI_lineAttrs));
    GrSetLineColor(pself->FBI_maskGState, CF_INDEX, C_BLACK , 0, 0);

    /*
     * draw rectangle and combine mask and image
     */
    x0 = pself->FBI_drag.x0;
    y0 = pself->FBI_drag.y0;
    x1 = pself->FBI_drag.x1;
    y1 = pself->FBI_drag.y1;

    GrDrawRect(pself->FBI_bitmapGState, x0, y0, x1, y1);
    GrDrawRect(pself->FBI_maskGState, x0, y0, x1, y1);
    ToolTransferMask(pself->FBI_maskBmp,  pself->FBI_bitmap,  pself->FBI_xSize,  pself->FBI_ySize);


    /*
     * Redraw fatbits and live preview.
     */
    @call oself:: MSG_FATBITS_REDRAW_AFTER_DRAG_TOOL_FINISHED(pself->FBI_lineAttrs.lineWidth.WWF_int);

}


/*######################################################################
  #
  #	FillEllipse Tool
  #
  ######################################################################*/


/*--------------------- EditDrawEllipse ---------------------
 *  Purpose:	Draw or clear an ellipse outline
 *  Context:	ellipse tool and fill ellipse tool
 *  Strategy:
 *	- use FBI_drag.bmp to draw to
 *	- see if the ellipse is large enough to be empty inside
 *	  remember this information in variable i
 *	- if we about to erase a rectangle:
 *		+ set a somewhat larger ellipse as clipping path
 *		+ if  variable i is true, set a somewhat smaller
 *		  ellipse as inner part of the clipping path
 *		+ return
 *	- if we are about to draw a rectangle
 *		+ Add appropirate ellipses to the current path
 *		+ draw FBI_drag.bmp to screen
 *		  this actually removes the old shape and shows the new one
 *		+ draw grid to screen
 *  Parameters:
 *  Return:
 ---------------------------------------------------------------------------*/
void EditDrawEllipse(optr fatbitsObj) {
FatbitsInstance *pself;
int x0, y0, x1, y1, grid, i;


    pself = ObjDerefVis(fatbitsObj);

    EC( if ( pself->FBI_drag.x0 == (-1) ) { ProgError("FBI_drag not initialized in DrawEllipse"); } )

    /*
     * Draw ellipse in MM_INVERT mode to shadow bitmap:
     * Sort coordinates and draw ellipse
     */
    x0 = pself->FBI_drag.x0;
    y0 = pself->FBI_drag.y0;
    x1 = pself->FBI_drag.x1;
    y1 = pself->FBI_drag.y1;

    if (x1 < x0) { int tmp = x1; x1 = x0; x0 = tmp; }
    if (y1 < y0) { int tmp = y1; y1 = y0; y0 = tmp; }
    GrDrawEllipse(pself->FBI_drag.gstate, x0, y0, x1, y1);

    /*
     * check the size to see, if the ellipse can be drawn empty inside, or not
     * remember the empty state in varibale i
     * then scale coordinates
     */
    if ( ((x1-x0) < 4) || ((y1-y0) < 4) ) {
    	i = FALSE;
    } else {
    	i = TRUE;
    }

    grid = pself->FBI_pixelSize;
    x0 = grid*x0;
    y0 = grid*y0;
    x1 = grid*x1;
    y1 = grid*y1;

    if (pself->FBI_drag.nextClear == TRUE) {

	/*
	 * Set the ellipse as clipping path. Inner ellipse is only used
	 * if the ellipse is large enough.
	 * Ensure that the pself->FBI_screenGState is not changed at all.
	 */
    	GrSaveState(pself->FBI_screenGState);

	GrBeginPath(pself->FBI_screenGState, PCT_REPLACE);	/* new path */
	GrFillEllipse(pself->FBI_screenGState, x0-1*grid, y0-1*grid, x1+2*grid, y1+2*grid);
	if (i) GrFillEllipse(pself->FBI_screenGState, x1-grid, y1-grid, x0+2*grid, y0+2*grid);
	GrEndPath(pself->FBI_screenGState);
	GrSetClipPath(pself->FBI_screenGState, PCT_INTERSECTION, ODD_EVEN);

	pself->FBI_drag.nextClear = FALSE;
        return;
    }

    /*
     * Add the ellipse as 2nd shape to the current clipping path
     */
    GrBeginPath(pself->FBI_screenGState, PCT_UNION);	/* add path */
    GrFillEllipse(pself->FBI_screenGState, x0-1*grid, y0-1*grid, x1+2*grid, y1+2*grid);
    if (i) GrFillEllipse(pself->FBI_screenGState, x1-grid, y1-grid, x0+2*grid, y0+2*grid);
    GrEndPath(pself->FBI_screenGState);
    GrSetClipPath(pself->FBI_screenGState, PCT_UNION, ODD_EVEN);


    /*
     * Redrww fatbits and live preview. Finish drawing cycle.
     */
    @call fatbitsObj::MSG_FATBITS_REDRAW_AFTER_DRAG();

    GrRestoreState(pself->FBI_screenGState);
    pself->FBI_drag.nextClear = TRUE;
}


