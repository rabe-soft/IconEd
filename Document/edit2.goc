 *	- draw colored rectangle as well as mask and combine them
 *	- Redraw fatbits and live preview
 *  Parameters:	xPos, yPos:	Mouse position
 *  Return:
 ---------------------------------------------------------------------------*/
@extern method FatbitsClass, MSG_FATBITS_RECTANGLE_END_SELECT{
int x0, y0, x1, y1;


