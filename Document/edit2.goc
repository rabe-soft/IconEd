/*######################################################################
  #
  #	Edit Mask Tool
  #
  ######################################################################*/

/*--------------------- EditMaskDrawPixel ---------------------
 *  Purpose:	Draw a single pixel in edit-mask-mode
 *  Context:
 *  Strategy:
 *	- Get color (black or white) from EditMaskModeChooser
 *	- Set pixel (black is opaque, white is transparent)
 *	  Do not touch the color layer.
 *	- Set a one-pixel cliprect to avoid flickering
 *	- redraw the image
 *	- update live preview object
 *  Parameters: oself:	The fatbits object
 *		x, y:	Pixel coordinates
 *		redrawPreview:  redraw the live preview object (don't calling
 *				the view object to avoid flickering)
 *  Return:
 ---------------------------------------------------------------------------*/
void EditMaskDrawPixel(optr fatbitsObj, int x, int y) {
FatbitsInstance *pself;
int grid, color;

    pself = ObjDerefVis(fatbitsObj);

    /*
     */
    color = @call EditMaskModeChooser::MSG_GEN_ITEM_GROUP_GET_SELECTION();
    GrSetAreaColor(pself->FBI_maskGState, CF_INDEX, color, 0, 0);
    GrDrawPoint(pself->FBI_maskGState, x,y);

    /*
     * Redraw fatbits and live preview.
     * 	- Copy mask back to the image
     *	- Set a one-pixel cliprect to avoid flickering
     *	- redraw the image
     *  - force the LivePreviewView to redraw itself. This ensures that
     *	  the background is drawn when a pixel has become transparent.
     */
    ToolTransferMask(pself->FBI_maskBmp,  pself->FBI_bitmap,  pself->FBI_xSize,  pself->FBI_ySize);

    grid = pself->FBI_pixelSize;

    GrSaveState(pself->FBI_screenGState);
    GrSetClipRect(pself->FBI_screenGState, PCT_REPLACE, grid*x, grid*y, grid*(x+1), grid*(y+1));
    @call fatbitsObj::MSG_VIS_DRAW(0, pself->FBI_screenGState);
    GrRestoreState(pself->FBI_screenGState);

    @call ConstructOptr(OptrToHandle(fatbitsObj), OptrToChunk (@LivePreviewView))::MSG_GEN_VIEW_REDRAW_CONTENT();

}

/*--------------------- MSG_FATBITS_EDIT_MASK_START_SELECT ---------------------
 *  Purpose:	Start select handler for edit-mask tool
