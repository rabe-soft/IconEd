/*---------------------------------------------------------------------------
 	Undo types and flags
 ---------------------------------------------------------------------------*/
#define	UNDO_DONT_STORE_IMAGE	0x100
	/* This flag is set if the operation does not affect the image
	 * The image then does not need to be saved or redrawn.
	 */


typedef enum {

/* Simple transformations, renamimg etc. */
    UNDO_NONE		= 0,
    UNDO_JUST_FOR_REDO	= 1,	/* see MSG_FATBITS_UNDO */
    UNDO_ROTATE		= 2,
    UNDO_FLIP		= 3,
    UNDO_RENAME_ICON	= 4 + UNDO_DONT_STORE_IMAGE,
    UNDO_DRAW_BITMAP	= 5,	/* draw importet bitmap into existing icon */


/* Bitmap operations */
    UNDO_PENCIL		= 0x10,	/* Free hand painting */
    UNDO_ERASER		= 0x11,
    UNDO_DRAW_LINE	= 0x12,
    UNDO_FILL_RECTANGLE	= 0x13,
    UNDO_DRAW_RECTANGLE	= 0x14,	/* not filled */
    UNDO_FILL_ELLIPSE	= 0x15,
    UNDO_DRAW_ELLIPSE	= 0x16,
    UNDO_FILL_AREA	= 0x17,
    UNDO_SHIFT_IMAGE	= 0x18,	/* move whole image */
    UNDO_MOVE_SELECTION	= 0x19,	/* move selected area */
    UNDO_FILL_MASK	= 0x1A,
    UNDO_EDIT_MASK	= 0x1B


} UndoType;


