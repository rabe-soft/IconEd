	#define		ETF_TRIG_REDO	8
	#define		ETF_DEFAULT_FEATURES (ETF_TRIG_COPY | ETF_TRIG_PASTE | ETF_TRIG_UNDO | ETF_TRIG_REDO)
/*
 * Bitmap tool toolbox features  - also used as the identifiers for the tool items and for
 * fatbits instance variable FBI_currentTool -> ALL available edit tools must be listed here
 */
	#define		BTF_SELECTION	1
